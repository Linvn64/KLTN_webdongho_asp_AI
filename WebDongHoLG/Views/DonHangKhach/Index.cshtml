@model IEnumerable<WebDongHoLG.Models.DonHang>
@{
    ViewData["Title"] = "Lịch sử đơn hàng";
    var currentStatus = (ViewBag.CurrentStatus as string ?? "").Trim();
    var daDanhGiaList = ViewBag.DanhSachDaDanhGia as List<string> ?? new List<string>();
}

@section Styles {
    <style>
        /* Đồng bộ tông màu Luxury cho trang Đơn Hàng */
        body {
            background-color: var(--lg-bg, #fcf9f2);
        }

        /* Tabs phân loại đơn hàng */
        .shopee-tabs {
            display: flex;
            background: var(--bs-white, #fff);
            border: 1px solid var(--lg-border, #ddd0b8);
            border-radius: 6px;
            overflow-x: auto;
            box-shadow: 0 4px 16px rgba(80,45,8,0.05);
        }

        .shopee-tab-item {
            flex: 1;
            text-align: center;
            padding: 16px 10px;
            color: var(--bs-secondary, #8a7055);
            text-decoration: none;
            font-size: 15px;
            font-weight: 500;
            border-bottom: 3px solid transparent;
            white-space: nowrap;
            transition: all 0.3s ease;
        }

            .shopee-tab-item.active {
                color: var(--lg-primary, #6a4010);
                border-bottom-color: var(--lg-primary, #6a4010);
                font-weight: 700;
            }

            .shopee-tab-item:hover {
                color: var(--luxury-gold, #c8823a);
                background-color: #fdf5e8;
            }

        /* Khối hiển thị đơn hàng */
        .order-card {
            background: var(--bs-white, #fff);
            border-radius: 6px;
            border: 1px solid var(--lg-border, #ddd0b8);
            box-shadow: 0 4px 16px rgba(80,45,8,0.05);
        }

        .product-img {
            width: 80px;
            height: 80px;
            object-fit: cover;
            border: 1px solid var(--lg-border, #ddd0b8);
            border-radius: 4px;
            background-color: var(--lg-bg, #fcf9f2);
        }
    </style>
}

<div class="container py-5 mt-4">
    @* --- Tab trạng thái --- *@
    <div class="shopee-tabs mb-4">
        <a href="/DonHangKhach/Index" class="shopee-tab-item @(string.IsNullOrEmpty(currentStatus) ? "active" : "")">Tất cả</a>
        <a href="/DonHangKhach/Index?status=Chờ thanh toán" class="shopee-tab-item @(currentStatus == "Chờ thanh toán" ? "active" : "")">Chờ thanh toán</a>
        <a href="/DonHangKhach/Index?status=Chờ xác nhận" class="shopee-tab-item @(currentStatus == "Chờ xác nhận" ? "active" : "")">Chờ xác nhận</a>
        <a href="/DonHangKhach/Index?status=Chờ xử lý" class="shopee-tab-item @(currentStatus == "Chờ xử lý" ? "active" : "")">Chờ xử lý</a>
        <a href="/DonHangKhach/Index?status=Đang giao hàng" class="shopee-tab-item @(currentStatus == "Đang giao hàng" ? "active" : "")">Đang giao hàng</a>
        <a href="/DonHangKhach/Index?status=Hoàn thành" class="shopee-tab-item @(currentStatus == "Hoàn thành" ? "active" : "")">Hoàn thành</a>
        <a href="/DonHangKhach/Index?status=Đã hủy" class="shopee-tab-item @(currentStatus == "Đã hủy" ? "active" : "")">Đã hủy</a>
    </div>

    @* --- Thanh tìm kiếm --- *@
    <form method="get" action="/DonHangKhach/Index" class="bg-white p-2 mb-4 rounded d-flex align-items-center" style="border: 1px solid var(--lg-border, #ddd0b8); box-shadow: 0 4px 16px rgba(80,45,8,0.05);">
        <input type="hidden" name="status" value="@currentStatus" />
        <i class="fas fa-search ms-3 me-2" style="color: var(--bs-secondary, #8a7055);"></i>
        <input type="text" name="searchString" value="@ViewBag.SearchString" class="border-0 bg-transparent flex-grow-1" style="outline: none; color: var(--luxury-dark);" placeholder="Tìm kiếm theo ID đơn hàng hoặc Tên Sản phẩm">
        <button type="submit" class="btn btn-add px-4 py-2" style="width: auto;">Tìm kiếm</button>
    </form>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5 bg-white rounded" style="border: 1px solid var(--lg-border); box-shadow: 0 4px 16px rgba(80,45,8,0.05);">
            <i class="fas fa-box-open fa-3x mb-3" style="color: var(--lg-border);"></i>
            <h5 style="color: var(--bs-secondary);">Không tìm thấy đơn hàng nào</h5>
        </div>
    }
    else
    {
        foreach (var don in Model)
        {
            var trangThai = (don.TrangThai ?? "").Trim();

            <div class="order-card p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3" style="border-color: var(--lg-border) !important;">
                    <div>
                        <span class="badge me-2 text-white px-2 py-1" style="background-color: var(--luxury-gold, #c8823a);">LG Mall</span>
                        <span class="fw-bold" style="color: var(--luxury-dark);">Mã đơn: #@don.MaDonHang</span>
                    </div>
                    <div class="fw-bold text-uppercase d-flex align-items-center" style="color: var(--lg-primary, #6a4010);">
                        <i class="fas fa-truck me-2"></i>
                        @trangThai
                    </div>
                </div>

                @foreach (var ct in don.ChiTietDonHangs)
                {
                    <div class="d-flex align-items-center mb-3">
                        <img src="@(ct.MaBienTheNavigation?.ImageUrl ?? "/home/img/no-image.jpg")" class="product-img me-3">
                        <div class="flex-grow-1">
                            <h6 class="mb-1 fw-bold" style="color: var(--luxury-dark);">@ct.MaBienTheNavigation?.MaSpNavigation?.TenSanPham</h6>
                            <div style="font-size: 13px; color: var(--bs-secondary);">
                                Phân loại: @ct.MaBienTheNavigation?.MauSac, @ct.MaBienTheNavigation?.DuongKinhMat mm
                            </div>
                            <div class="mt-1" style="color: var(--bs-secondary);">x@(ct.SoLuong)</div>
                        </div>
                        <div class="text-end fw-bold" style="color: var(--luxury-dark);">
                            @((ct.DonGiaTaiThoiDiem ?? 0).ToString("#,##0"))₫
                        </div>
                    </div>
                }

                <div class="border-top pt-3 text-end" style="border-color: var(--lg-border) !important;">
                    <div class="mb-3">
                        <span class="me-2" style="color: var(--bs-secondary);">Thành tiền:</span>
                        <span class="fw-bold" style="font-size: 22px; color: var(--lg-primary, #6a4010);">@((don.TongTien ?? 0).ToString("#,##0"))₫</span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 align-items-center">
                        @if (trangThai == "Chờ thanh toán")
                        {
                            var thoiGianHetHan = don.NgayDat.Value.AddMinutes(15);
                            var soGiayConLai = (thoiGianHetHan - DateTime.Now).TotalSeconds;
                            if (soGiayConLai > 0)
                            {
                                <div class="small me-3" style="color: var(--luxury-gold);">
                                    <i class="far fa-clock"></i> Thanh toán trong:
                                    <b class="countdown" style="color: #7a3030;" data-seconds="@soGiayConLai">--:--</b>
                                </div>
                            }
                            <a href="/Checkout/PaymentPending?maDonHang=@don.MaDonHang" class="btn-add d-inline-block text-decoration-none px-4" style="width: auto;">Thanh toán lại</a>
                            <button type="button" onclick="confirmHuy(@don.MaDonHang)" class="btn-detail px-4" style="width: auto;">Hủy đơn</button>
                        }
                        else if (trangThai == "Chờ xác nhận" || trangThai == "Chờ xử lý" || trangThai == "Đã thanh toán")
                        {
                            if (trangThai == "Đã thanh toán" || trangThai == "Chờ xác nhận")
                            {
                                <span class="small me-3 fw-bold" style="color: #5a8a6a;"><i class="fas fa-check-circle"></i> Đã thanh toán</span>
                            }
                            <button type="button" onclick="confirmHuy(@don.MaDonHang)" class="btn-detail px-4" style="color: #7a3030; border-color: #d8ccc0; width: auto;">Hủy đơn hàng</button>
                            <a href="/DonHangKhach/Details/@don.MaDonHang" class="btn-detail d-inline-block text-decoration-none px-4" style="width: auto;">Xem chi tiết</a>
                        }
                        else if (trangThai == "Đang giao hàng" || trangThai == "Đã giao hàng")
                        {
                            var ngayDuocPhepNhan = don.NgayDat.Value.AddDays(3);

                            if (trangThai == "Đã giao hàng" || DateTime.Now >= ngayDuocPhepNhan)
                            {
                                <button type="button" onclick="confirmDaNhan(@don.MaDonHang)" class="btn-add px-4" style="width: auto;">
                                    <i class="fas fa-box-open me-1"></i> Đã nhận được hàng
                                </button>
                            }
                            else
                            {
                                <div class="text-start me-auto ps-2">
                                    <span class="badge fw-bold px-2 py-1" style="background-color: #fdf5e8; color: var(--luxury-gold); border: 1px solid var(--luxury-gold);">
                                        <i class="fas fa-truck-moving me-1"></i> Đang vận chuyển...
                                    </span>
                                    <div class="small mt-1" style="font-size: 11px; color: var(--bs-secondary);">Mở nhận hàng ngày: @ngayDuocPhepNhan.ToString("dd/MM")</div>
                                </div>
                            }
                            <a href="/DonHangKhach/Details/@don.MaDonHang" class="btn-detail d-inline-block text-decoration-none px-4" style="width: auto;">Xem chi tiết</a>
                        }
                        else if (trangThai == "Hoàn thành")
                        {
                            <div class="w-100">
                                @foreach (var ct in don.ChiTietDonHangs)
                                {
                                    var maSpNay = ct.MaBienTheNavigation?.MaSp ?? 0;
                                    var maBienTheNay = ct.MaBienThe;
                                    var maDonHangNay = don.MaDonHang;
                                    var key = $"{maSpNay}_{maBienTheNay}_{maDonHangNay}";
                                    bool daDanhGia = daDanhGiaList.Contains(key);

                                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom" style="border-color: var(--lg-border) !important;">
                                        <div class="d-flex align-items-center">
                                            <img src="@(ct.MaBienTheNavigation?.ImageUrl ?? "/home/img/no-image.jpg")"
                                                 style="width:35px; height:35px; object-fit:cover; border-radius:4px; border: 1px solid var(--lg-border);" class="me-3">
                                            <span style="font-size:14px; color: var(--luxury-dark);">
                                                @ct.MaBienTheNavigation?.MaSpNavigation?.TenSanPham
                                                <small style="color: var(--bs-secondary);">(@ct.MaBienTheNavigation?.MauSac - @ct.MaBienTheNavigation?.DuongKinhMat mm)</small>
                                            </span>
                                        </div>

                                        @if (daDanhGia)
                                        {
                                            <span class="badge fw-bold px-2 py-1" style="background-color: #e8f5ee; color: #5a8a6a; border: 1px solid #5a8a6a;">
                                                <i class="fas fa-check-circle me-1"></i> Đã đánh giá
                                            </span>
                                        }
                                        else
                                        {
                                            <a href="/DanhGia/Create?maSp=@maSpNay&maDonHang=@maDonHangNay&maBienThe=@maBienTheNay"
                                               class="btn-add btn-sm d-inline-block text-decoration-none px-3" style="width: auto;">
                                                ⭐ Đánh giá
                                            </a>
                                        }
                                    </div>
                                }
                                <div class="d-flex justify-content-end gap-2 mt-3">
                                    <a href="/SanPhams/Detail/@don.ChiTietDonHangs.FirstOrDefault()?.MaBienTheNavigation?.MaSp" class="btn-add d-inline-block text-decoration-none px-4" style="width: auto;">Mua lại</a>
                                    <a href="/DonHangKhach/Details/@don.MaDonHang" class="btn-detail d-inline-block text-decoration-none px-4" style="width: auto;">Xem chi tiết</a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function confirmHuy(id) {
            Swal.fire({
                title: 'Xác nhận hủy đơn?',
                text: "Hãy cho chúng mình biết lý do để cải thiện dịch vụ nhé",
                icon: 'warning',
                input: 'select',
                inputOptions: {
                    'Thay đổi địa chỉ': 'Thay đổi địa chỉ nhận hàng',
                    'Đổi sản phẩm khác': 'Muốn chọn mẫu đồng hồ khác',
                    'Tìm thấy giá rẻ hơn': 'Tìm thấy nơi khác rẻ hơn',
                    'Không còn nhu cầu': 'Không còn nhu cầu mua nữa'
                },
                showCancelButton: true,
                confirmButtonColor: '#6a4010', // Đổi màu xác nhận sang Nâu đồng
                cancelButtonColor: '#8a7055',  // Đổi màu nút hủy sang Nâu xám
                confirmButtonText: 'Hủy đơn ngay',
                cancelButtonText: 'Quay lại'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = `/DonHangKhach/HuyDon?id=${id}&lyDo=${result.value}`;
                }
            })
        }

        function confirmDaNhan(id) {
            Swal.fire({
                title: 'Xác nhận đã nhận hàng',
                text: "Bạn đã kiểm tra và hài lòng với sản phẩm?",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#5a8a6a', // Màu xanh rêu sang trọng
                cancelButtonColor: '#8a7055',
                confirmButtonText: 'Đã nhận hàng',
                cancelButtonText: 'Chưa nhận'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '/DonHangKhach/DaNhanHang?id=' + id;
                }
            })
        }

        function startCountdowns() {
            const timers = document.querySelectorAll('.countdown');
            timers.forEach(timer => {
                let seconds = parseInt(timer.getAttribute('data-seconds'));
                const interval = setInterval(() => {
                    if (seconds <= 0) {
                        timer.innerHTML = "Hết hạn";
                        clearInterval(interval);
                        return;
                    }
                    seconds--;
                    let m = Math.floor(seconds / 60);
                    let s = Math.floor(seconds % 60);
                    timer.innerHTML = (m < 10 ? "0" + m : m) + ":" + (s < 10 ? "0" + s : s);
                }, 1000);
            });
        }
        document.addEventListener("DOMContentLoaded", startCountdowns);
    </script>
}