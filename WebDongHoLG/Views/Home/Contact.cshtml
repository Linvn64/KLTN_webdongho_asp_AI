@model WebDongHoLG.ViewModels.ContactMessage
@{
    ViewData["Title"] = "Liên hệ - LG Watch";
}

<div class="container-fluid contact py-5">
    <div class="container py-5">
        <div class="p-5 bg-light rounded shadow-sm">
            <div class="row g-4">

                <div class="row g-5">
                    <!-- Cột bên trái: Nội dung giới thiệu chi tiết -->
                    <div class="col-lg-7">
                        <h2 class="text-primary mb-4 fw-bold">Về LG Watch</h2>
                        <div class="about-content text-muted">
                            <p class="mb-4">
                                Chào mừng bạn đến với <strong>LG Watch</strong> – nơi niềm đam mê thời gian được tôn vinh. Chúng tôi không chỉ bán những chiếc đồng hồ, mà chúng tôi mang đến cho bạn một món phụ kiện khẳng định phong cách, đẳng cấp và giá trị cá nhân.
                            </p>
                            <p class="mb-4">
                                Khởi đầu từ tình yêu với những cỗ máy thời gian tinh xảo, LG Watch đã không ngừng phát triển để trở thành địa chỉ tin cậy cho những ai tìm kiếm sự chính xác, bền bỉ và sang trọng. Mỗi sản phẩm tại shop đều được tuyển chọn kỹ lưỡng từ những thương hiệu uy tín trên thế giới.
                            </p>
                            <p class="mb-4">
                                Chúng tôi tin rằng, một chiếc đồng hồ tốt không chỉ để xem giờ, mà còn là người bạn đồng hành ghi dấu những khoảnh khắc quan trọng nhất trong cuộc đời bạn. Đó là lý do LG Watch luôn cam kết mang đến những sản phẩm <strong>Chính Hãng 100%</strong> cùng chế độ hậu mãi tận tâm nhất.
                            </p>

                            <div class="row mt-5">
                                <div class="col-md-6">
                                    <div class="d-flex align-items-center mb-3">
                                        <i class="fas fa-check-circle text-primary me-2"></i>
                                        <span>Sản phẩm chính hãng</span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="d-flex align-items-center mb-3">
                                        <i class="fas fa-check-circle text-primary me-2"></i>
                                        <span>Bảo hành dài hạn</span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="d-flex align-items-center mb-3">
                                        <i class="fas fa-check-circle text-primary me-2"></i>
                                        <span>Giá cả cạnh tranh</span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="d-flex align-items-center mb-3">
                                        <i class="fas fa-check-circle text-primary me-2"></i>
                                        <span>Hỗ trợ 24/7</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Cột bên phải: Các giá trị/cam kết của shop (Giữ style box của bạn) -->
                    <div class="col-lg-5">
                        <div class="d-flex p-4 rounded mb-4 bg-white shadow-sm border-start border-primary border-4">
                            <i class="fas fa-award fa-2x text-primary me-4"></i>
                            <div>
                                <h4>Uy Tín Hàng Đầu</h4>
                                <p class="mb-0 text-muted">Cam kết mọi sản phẩm đều có giấy tờ chứng minh nguồn gốc rõ ràng.</p>
                            </div>
                        </div>
                        <div class="d-flex p-4 rounded mb-4 bg-white shadow-sm border-start border-primary border-4">
                            <i class="fas fa-shield-alt fa-2x text-primary me-4"></i>
                            <div>
                                <h4>Bảo Hành Tận Tâm</h4>
                                <p class="mb-0 text-muted">Chính sách bảo hành lỗi 1 đổi 1 và hỗ trợ kỹ thuật trọn đời.</p>
                            </div>
                        </div>
                        <div class="d-flex p-4 rounded bg-white shadow-sm border-start border-primary border-4">
                            <i class="fas fa-truck fa-2x text-primary me-4"></i>
                            <div>
                                <h4>Giao Hàng Siêu Tốc</h4>
                                <p class="mb-0 text-muted">Kiểm tra hàng trước khi thanh toán, giao hàng nhanh toàn quốc.</p>
                            </div>
                        </div>

                        <!-- Thêm một nút kêu gọi hành động (CTA) để khách quay lại mua hàng -->
                        <a asp-area="Default" asp-controller="SanPhams" asp-action="Index" class="btn btn-primary w-100 py-3 mt-4 fw-bold shadow-sm">
                            Xem các mẫu đồng hồ mới nhất <i class="fas fa-arrow-right ms-2"></i>
                        </a>
                    </div>
               
                <div class="col-12">
                    <div class="text-center mx-auto" style="max-width: 700px;">
                        <h1 class="text-primary">Địa chỉ shop</h1>
                    </div>
                </div>

                <div class="col-lg-12">
                    <div class="h-100 rounded shadow-sm border" style="overflow: hidden;">
                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3723.9244039130004!2d105.81645417534444!3d21.035710580615286!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3135ab0d127a01e7%3A0xab06f03126759888!2zTG90dGUgQ2VudGVyIEjDoCBO4buZaQ!5e0!3m2!1svi!2svn!4v1711900000000!5m2!1svi!2svn3"
                                width="100%"
                                height="450"
                                style="border:0;"
                                allowfullscreen=""
                                loading="lazy"
                                referrerpolicy="no-referrer-when-downgrade">
                        </iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>