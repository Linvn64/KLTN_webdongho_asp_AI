@model IEnumerable<WebDongHoLG.ViewModels.SanPhamNhomVM>

<link href="~/css/MatHangSanPham.css" rel="stylesheet" />

@foreach (var item in Model)
{
    <div class="col-md-6 col-lg-6 col-xl-4 d-flex align-items-stretch mb-4">
        <div class="sp-card w-100">

            <div class="sp-img-wrap">
                <div class="fruite-img-inner">
                    <a asp-action="Detail" asp-controller="SanPhams"
                       asp-route-id="@item.MaSpDaiDien">
                        <img src="@(string.IsNullOrEmpty(item.Hinh) ? "/home/img/no-image.jpg" : item.Hinh)"
                             alt="@item.TenSp">
                    </a>
                </div>

                @if (item.LaBanChay)
                {
                    <span class="badge-mac badge-ban-chay">
                        <i class="fa fa-fire me-1"></i>Bán chạy
                    </span>
                }
                @if (item.LaMoi)
                {
                    <span class="badge-mac badge-moi @(item.LaBanChay ? "second" : "")">
                        <i class="fa fa-star me-1"></i>Mới
                    </span>
                }
                @if (!item.ConHang)
                {
                    <span class="badge-het-hang">Hết hàng</span>
                }
            </div>

            <div class="sp-body">
                @if (!string.IsNullOrEmpty(item.TenThuongHieu))
                {
                    <div class="sp-brand">@item.TenThuongHieu</div>
                }

                <a asp-action="Detail" asp-controller="SanPhams"
                   asp-route-id="@item.MaSpDaiDien"
                   class="text-decoration-none">
                    <div class="sp-name">@item.TenSp</div>
                </a>

                <div class="sp-tags">
                    @foreach (var sp in item.DanhSachTheoDoiTuong)
                    {
                        var tagClass = sp.DoiTuong == "Nam" ? "tag-nam"
                        : sp.DoiTuong == "Nữ" ? "tag-nu"
                        : "tag-unisex";
                        <a asp-action="Detail" asp-controller="SanPhams"
                           asp-route-id="@sp.MaSp"
                           class="sp-tag @tagClass text-decoration-none">
                            @sp.DoiTuong
                        </a>
                    }
                </div>

                <div class="mt-auto">
                    @if (item.GiaBanThapNhat.HasValue)
                    {
                        <div class="sp-price">
                            Từ @item.GiaBanThapNhat.Value.ToString("#,##0") ₫
                        </div>
                    }
                    else
                    {
                        <div class="sp-price" style="color:#a0a090;">Liên hệ</div>
                    }

                    <div class="sp-btns">
                        <a asp-action="Detail" asp-controller="SanPhams"
                           asp-route-id="@item.MaSpDaiDien"
                           class="btn-detail text-decoration-none">
                            <i class="fa fa-eye me-1"></i>Xem chi tiết
                        </a>
                        @if (item.ConHang)
                        {
                            <button type="button"
                                    onclick="moModalChonBienThe(@item.MaSpDaiDien)"
                                    class="btn-add">
                                <i class="fa fa-shopping-bag me-1"></i>Thêm giỏ
                            </button>
                        }
                        else
                        {
                            <button class="btn-disabled" disabled>
                                <i class="fa fa-times me-1"></i>Hết hàng
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}