@model IEnumerable<WebDongHoLG.ViewModels.SanPhamNhomVM>

<style>
    .fruite-img {
        height: 250px;
        overflow: hidden;
    }

        .fruite-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s;
        }

    .fruite-item:hover .fruite-img img {
        transform: scale(1.05);
    }

    .fruite-item h5 {
        height: 2.8rem;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }
</style>

@foreach (var item in Model)
{
    <div class="col-md-6 col-lg-6 col-xl-4 d-flex align-items-stretch mb-4">
        <div class="rounded position-relative fruite-item w-100 d-flex flex-column shadow-sm">

            <div class="fruite-img">
                <a asp-action="Detail" asp-controller="SanPhams"
                   asp-route-id="@item.MaSpDaiDien">
                    <img src="@(string.IsNullOrEmpty(item.Hinh) ? "/home/img/no-image.jpg" : item.Hinh)"
                         alt="@item.TenSp">
                </a>
            </div>

            @if (!item.ConHang)
            {
                <span class="text-white bg-danger px-2 py-1 rounded position-absolute"
                      style="top:10px; right:10px; font-size:11px;">
                    Hết hàng
                </span>
            }

            <div class="p-3 border border-secondary border-top-0 rounded-bottom d-flex flex-column flex-grow-1">

                @if (!string.IsNullOrEmpty(item.TenThuongHieu))
                {
                    <small class="text-muted fw-bold mb-1">@item.TenThuongHieu</small>
                }

                <a asp-action="Detail" asp-controller="SanPhams"
                   asp-route-id="@item.MaSpDaiDien"
                   class="text-dark text-decoration-none">
                    <h5 class="fw-bold mb-2">@item.TenSp</h5>
                </a>

                <div class="d-flex flex-wrap gap-1 mb-2">
                    @foreach (var sp in item.DanhSachTheoDoiTuong)
                    {
                        var mauBadge = sp.DoiTuong == "Nam" ? "#0d6efd"
                        : sp.DoiTuong == "Nữ" ? "#d63384"
                        : "#6c757d";
                        <a asp-action="Detail" asp-controller="SanPhams"
                           asp-route-id="@sp.MaSp"
                           class="badge text-decoration-none"
                           style="background-color:@mauBadge; font-size:11px;">
                            @sp.DoiTuong
                        </a>
                    }
                </div>

                <div class="mt-auto">
                    @if (item.GiaBanThapNhat.HasValue)
                    {
                        <p class="text-danger fw-bold fs-5 mb-2">
                            Từ @item.GiaBanThapNhat.Value.ToString("#,##0") ₫
                        </p>
                    }
                    else
                    {
                        <p class="text-muted mb-2">Liên hệ</p>
                    }

                    <div class="d-flex flex-column gap-2 mt-2">
                        <a asp-action="Detail" asp-controller="SanPhams"
                           asp-route-id="@item.MaSpDaiDien"
                           class="btn border border-secondary rounded-pill px-3 py-2 text-primary text-center">
                            <i class="fa fa-eye me-1"></i>Xem chi tiết
                        </a>
                        @if (item.ConHang)
                        {
                            <a asp-controller="GioHangs" asp-action="AddToCart"
                               asp-route-id="@item.MaSpDaiDien" asp-route-quantity="1"
                               class="btn btn-primary rounded-pill px-3 py-2 text-center">
                                <i class="fa fa-shopping-bag me-1"></i>Thêm giỏ
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-outline-secondary rounded-pill px-3 py-2" disabled>
                                <i class="fa fa-times me-1"></i>Hết hàng
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}