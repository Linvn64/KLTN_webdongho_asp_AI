@model WebDongHoLG.ViewModels.ChiTietSanPhamVM
@{
    ViewData["Title"] = Model.TenSp;
    var bienTheHienTai = Model.BienThes.FirstOrDefault();
    var dsMau = Model.BienThes.Select(bt => bt.MauSac).Distinct().ToList();
    var dsSize = Model.BienThes.Select(bt => bt.DuongKinhMat).Where(s => s.HasValue).Select(s => s.Value).Distinct().OrderBy(s => s).ToList();
    var dsDayDeo = Model.BienThes.Select(bt => bt.ChatLieuDay).Where(s => !string.IsNullOrEmpty(s)).Distinct().ToList();
    var maSp = Model.MaSp;
}

@section Styles {
    <link rel="stylesheet" href="~/css/sanphamdetail.css" asp-append-version="true" />
}

<div class="container-fluid py-5 mt-5">
    <div class="container py-5">
        <div class="row g-4 mb-5">
            <div class="col-lg-5">
                <div class="main-img-container rounded mb-2" onclick="phongToAnh()">
                    <img id="imgChinh" src="@(bienTheHienTai?.ImageUrl ?? "/home/img/no-image.jpg")" style="object-fit: contain;">
                    <div class="position-absolute bottom-0 end-0 p-2">
                        <span class="badge bg-dark bg-opacity-50" style="font-size:10px;"><i class="fa fa-expand me-1"></i>Phóng to</span>
                    </div>
                </div>

                <div class="position-relative">
                    <button class="nav-btn prev" onclick="scrollThumbs(-1)"><i class="fa fa-chevron-left"></i></button>
                    <div class="thumb-track-container">
                        <div id="thumbInner">
                            @{
                                var tatCaAnh = new List<(string Src, int MaBT, string Mau, int? Size, string Day)>();
                                foreach (var bt in Model.BienThes)
                                {
                                    if (!string.IsNullOrEmpty(bt.ImageUrl)) tatCaAnh.Add((bt.ImageUrl, bt.MaBienThe, bt.MauSac, bt.DuongKinhMat, bt.ChatLieuDay));
                                    foreach (var a in bt.HinhAnhs.Where(h => h != bt.ImageUrl)) tatCaAnh.Add((a, bt.MaBienThe, bt.MauSac, bt.DuongKinhMat, bt.ChatLieuDay));
                                }
                            }
                            @for (int i = 0; i < tatCaAnh.Count; i++)
                            {
                                var img = tatCaAnh[i];
                                <div class="thumb-item @(img.MaBT == bienTheHienTai?.MaBienThe && i == 0 ? "active" : "")"
                                     data-index="@i" data-src="@img.Src" data-mabienthe="@img.MaBT"
                                     data-mau="@img.Mau" data-size="@(img.Size?.ToString() ?? "null")" data-day="@img.Day"
                                     onclick="chonThumb(@i)">
                                    <img src="@img.Src" style="object-fit: contain;">
                                </div>
                            }
                        </div>
                    </div>
                    <button class="nav-btn next" onclick="scrollThumbs(1)"><i class="fa fa-chevron-right"></i></button>
                </div>
            </div>

            <div class="col-lg-7">
                <small class="text-muted" style="color: var(--lg-primary) !important; font-weight: 600; text-transform: uppercase;">@Model.TenThuongHieu</small>
                <h4 class="fw-bold mb-2 mt-1" style="color: var(--luxury-dark);">
                    @Model.TenSp
                    <span class="badge ms-2" style="font-size:11px; background-color:@(Model.DoiTuong == "Nam" ? "#1a4a7a" : (Model.DoiTuong == "Nữ" ? "#7a1a4a" : "#5a4a30"))">@Model.DoiTuong</span>
                </h4>

                <div class="d-flex align-items-center mb-3 gap-2">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <i class="fa fa-star @(i <= Math.Round(Model.SoSaoTrungBinh) ? "text-warning" : "text-muted")"></i>
                    }
                    <small class="text-muted">(@Model.SoDanhGia đánh giá)</small>
                </div>

                <div class="rounded p-3 mb-3" style="background-color: #fdf5e8; border: 1px solid var(--lg-border);">
                    <h3 class="fw-bold mb-0" id="giaHienTai" style="color: #8a4a10;">@(bienTheHienTai?.GiaBan?.ToString("#,##0") ?? "Liên hệ") ₫</h3>
                </div>

                <div class="mb-3">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="fw-bold" style="color: var(--luxury-dark);">Màu sắc:</span>
                        <span class="fw-bold" id="mauDangChon" style="color: var(--lg-primary);">@bienTheHienTai?.MauSac</span>
                    </div>
                    <div class="d-flex flex-wrap gap-2" id="box-mau">
                        @foreach (var mau in dsMau)
                        {
                            <button type="button" class="btn btn-sm border px-3 btn-chon-bt chon-mau @(mau == bienTheHienTai?.MauSac ? "btn-primary" : "btn-outline-secondary")"
                                    data-mau="@mau" onclick="xuLyChonBienThe('mau', '@mau', this)">
                                @mau
                            </button>
                        }
                    </div>
                </div>

                <div class="mb-3">
                    <span class="fw-bold d-block mb-2" style="color: var(--luxury-dark);">Kích thước: <span id="sizeDangChon" style="color: var(--lg-primary);">@bienTheHienTai?.DuongKinhMat mm</span></span>
                    <div class="d-flex flex-wrap gap-2" id="box-size">
                        @foreach (var size in dsSize)
                        {
                            <button type="button" class="btn btn-sm border px-3 btn-chon-bt chon-size @(size == bienTheHienTai?.DuongKinhMat ? "btn-primary" : "btn-outline-secondary")"
                                    data-size="@size" onclick="xuLyChonBienThe('size', '@size', this)">
                                @size mm
                            </button>
                        }
                    </div>
                </div>

                <div class="mb-3">
                    <span class="fw-bold d-block mb-2" style="color: var(--luxury-dark);">Chất liệu dây: <span id="dayDangChon" style="color: var(--lg-primary);">@bienTheHienTai?.ChatLieuDay</span></span>
                    <div class="d-flex flex-wrap gap-2" id="box-day">
                        @foreach (var day in dsDayDeo)
                        {
                            <button type="button" class="btn btn-sm border px-3 btn-chon-bt chon-day @(day == bienTheHienTai?.ChatLieuDay ? "btn-primary" : "btn-outline-secondary")"
                                    data-day="@day" onclick="xuLyChonBienThe('day', '@day', this)">
                                @day
                            </button>
                        }
                    </div>
                </div>

                <div class="mb-3" id="tonKhoHienTai">
                    @if ((bienTheHienTai?.SoLuongTon ?? 0) > 0)
                    {
                        <span class="text-success"><i class="fa fa-check-circle me-1"></i>Còn <strong>@bienTheHienTai.SoLuongTon</strong> sản phẩm</span>
                    }
                    else
                    {
                        <span class="text-danger"><i class="fa fa-times-circle me-1"></i>Hết hàng</span>
                    }
                </div>

                @{
                    var isHetHang = (bienTheHienTai?.SoLuongTon ?? 0) <= 0;
                }
                <div class="mb-4 d-flex align-items-stretch gap-2">

                    <div class="d-flex align-items-center flex-shrink-0" style="width: 120px; height: 48px; border: 1px solid var(--lg-border); border-radius: 4px; background: #fcf9f2; overflow: hidden;">
                        <button type="button" class="btn-minus" style="width: 35px; height: 100%; background: transparent; border: none; color: var(--lg-primary); display: flex; align-items: center; justify-content: center; cursor: pointer;" @(isHetHang ? "disabled" : "")>
                            <i class="fa fa-minus"></i>
                        </button>

                        <input type="text" id="txtSoLuong" value="1" class="text-center fw-bold px-0" style="width: 50px; height: 100%; border: none; border-left: 1px solid var(--lg-border); border-right: 1px solid var(--lg-border); background: #fff; outline: none; color: var(--luxury-dark);" @(isHetHang ? "disabled" : "")>

                        <button type="button" class="btn-plus" style="width: 35px; height: 100%; background: transparent; border: none; color: var(--lg-primary); display: flex; align-items: center; justify-content: center; cursor: pointer;" @(isHetHang ? "disabled" : "")>
                            <i class="fa fa-plus"></i>
                        </button>
                    </div>

                    <button type="button" onclick="themVaoGio()" class="btn-detail fw-bold px-2 rounded d-flex align-items-center justify-content-center flex-grow-1" style="height: 48px; white-space: nowrap;" @(isHetHang ? "disabled" : "")>
                        <i class="fa fa-shopping-bag me-2"></i>Thêm giỏ
                    </button>

                    <button type="button" onclick="muaNgay()" class="btn-add fw-bold px-2 rounded d-flex align-items-center justify-content-center flex-grow-1" style="height: 48px; white-space: nowrap;" @(isHetHang ? "disabled" : "")>
                        Mua ngay
                    </button>

                </div>

                <input type="hidden" id="maBienTheChon" value="@bienTheHienTai?.MaBienThe" />
                <small class="text-muted">Mã SKU: <span id="skuHienTai">@bienTheHienTai?.MaSku</span></small>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-8">
                <nav>
                    <div class="nav nav-tabs mb-3">
                        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#nav-thongso">Thông số</button>
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#nav-mota">Mô tả</button>
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#nav-danhgia">Đánh giá</button>
                    </div>
                </nav>
                <div class="tab-content border rounded p-4 bg-white" style="border-color: var(--lg-border) !important;">
                    <div class="tab-pane active" id="nav-thongso"><partial name="_ThongSoPartial" model="Model" /></div>
                    <div class="tab-pane" id="nav-mota"><partial name="_MoTaPartial" model="Model.MoTa" /></div>
                    <div class="tab-pane" id="nav-danhgia"><partial name="_DanhGiaPartial" model="Model" /></div>
                </div>
            </div>

            <div class="col-lg-4">
                <form asp-action="Index" method="get" class="input-group mb-4">
                    <input name="keyword" class="form-control" placeholder="Tìm đồng hồ...">
                    <button class="btn btn-primary"><i class="fa fa-search"></i></button>
                </form>
                @await Component.InvokeAsync("DanhMuc")
                <h5 class="mt-4 mb-3" style="color: var(--luxury-dark);">Sản phẩm liên quan</h5>
                @foreach (var sp in ViewBag.SpLienQuan as List<WebDongHoLG.ViewModels.SanPhamVM>)
                {
                    <div class="d-flex gap-3 mb-3 border-bottom pb-2" style="border-color: var(--lg-border) !important;">
                        <img src="@sp.Hinh" style="width:60px; height:60px; object-fit:contain; background: #f5ede0;" class="rounded p-1">
                        <div>
                            <a href="/SanPhams/Detail/@sp.MaSp" class="text-dark d-block fw-bold">@sp.TenSp</a>
                            <span class="fw-bold" style="color: #8a4a10;">@sp.GiaBan?.ToString("N0") ₫</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalPhongTo" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-transparent border-0">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center p-2">
                <img id="imgPhongTo" src=""
                     style="max-width:100%; max-height:80vh; object-fit:contain;">
            </div>
            <div class="modal-footer border-0 justify-content-center pt-0">
                <button class="btn btn-dark btn-sm" onclick="chuyenAnhModal(-1)">
                    <i class="fa fa-chevron-left"></i>
                </button>
                <button class="btn btn-dark btn-sm" onclick="chuyenAnhModal(1)">
                    <i class="fa fa-chevron-right"></i>
                </button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        const bienThes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BienThes));
        const isLoggedIn = @(User.Identity.IsAuthenticated.ToString().ToLower());
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/nguoidung/sanphamdetail.js" asp-append-version="true"></script>
}