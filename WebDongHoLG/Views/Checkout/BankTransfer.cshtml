<div class="card shadow-sm text-start mb-4 border-primary">
    <div class="card-body">
        <h5 class="fw-bold border-bottom pb-2 mb-3 text-primary">Thông tin tài khoản</h5>
        <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">Số tiền hàng</span>
            <strong>@((ViewBag.TongTien - (ViewBag.PhiShip ?? 0) + (ViewBag.GiamGia ?? 0)).ToString("#,##0")) ₫</strong>
        </div>

        <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">Phí vận chuyển</span>
            <span class="text-dark">@((ViewBag.PhiShip > 0) ? "+" + ViewBag.PhiShip.ToString("#,##0") + " ₫" : "Miễn phí")</span>
        </div>

        @if (ViewBag.GiamGia > 0)
        {
            <div class="d-flex justify-content-between mb-2 text-success">
                <span class="text-muted">Voucher giảm giá</span>
                <strong>- @ViewBag.GiamGia.ToString("#,##0") ₫</strong>
            </div>
        }

        <div class="d-flex justify-content-between mb-2 py-2 border-top">
            <span class="fw-bold">TỔNG SỐ TIỀN CẦN CK</span>
            <strong class="text-danger h4 mb-0">@ViewBag.TongTien?.ToString("#,##0") ₫</strong>
        </div>

    </div>
</div>