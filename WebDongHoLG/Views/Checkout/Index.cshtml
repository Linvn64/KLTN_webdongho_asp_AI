@model WebDongHoLG.ViewModels.DonHangVM

@section Styles {
    <style>
        .custom-radio-address {
            cursor: pointer;
            transition: background 0.2s;
        }

            .custom-radio-address:hover {
                background-color: var(--lg-bg);
            }

            .custom-radio-address .form-check-input {
                width: 1.2rem;
                height: 1.2rem;
                cursor: pointer;
            }

                .custom-radio-address .form-check-input:checked {
                    background-color: var(--lg-primary);
                    border-color: var(--lg-primary);
                }

        .action-icons a {
            font-size: 1rem;
            padding: 5px;
        }

        .img-product-large {
            width: 80px;
            height: 80px;
            object-fit: cover;
            border-radius: 8px;
        }

        .table-checkout thead {
            background-color: var(--lg-bg) !important;
        }

            .table-checkout thead th {
                color: var(--lg-primary) !important;
                font-weight: 700;
            }

        .table-checkout th, .table-checkout td {
            padding: 16px 15px;
            vertical-align: middle;
        }

        .table-checkout tbody tr:hover {
            background-color: var(--lg-bg);
        }

        .form-check-input:checked {
            background-color: var(--lg-primary) !important;
            border-color: var(--lg-primary) !important;
        }

        .form-check-input:focus {
            border-color: var(--luxury-gold) !important;
            box-shadow: 0 0 0 0.2rem rgba(106,64,16,0.2) !important;
        }
    </style>
}

<div class="container-fluid py-5">
    <div class="container py-5">

        <form asp-controller="Checkout" asp-action="PlaceOrder" method="post">
            <input type="hidden" name="isBuyNow"
                   value="@(ViewBag.IsBuyNow != null ? ViewBag.IsBuyNow.ToString().ToLower() : "false")" />
            <input type="hidden" name="selectedIds"
                   value="@string.Join(",", Model.DanhSachSanPham.Select(x => x.MaBienThe))" />
            <input type="hidden" id="hiddenMaVoucher" name="MaVoucherChon" value="@Model.MaVoucherChon" />

            <div class="row">

                @await Html.PartialAsync("_CheckoutProducts", Model)

                <div class="col-lg-8">
                    <div class="p-4 border rounded bg-white mb-4 shadow-sm"
                         style="border-top: 4px solid var(--lg-primary) !important;">
                        <h5 class="fw-bold mb-3" style="color:var(--lg-primary);">
                            <i class="fas fa-map-marker-alt me-2"></i>Địa Chỉ Nhận Hàng
                        </h5>
                        <div class="d-flex justify-content-between align-items-center">
                            <div id="displayCurrentAddress">
                                @if (Model.DiaChiChiTiet != "Chưa có địa chỉ giao hàng")
                                {
                                    <strong>@Model.HoTen (@Model.SdtNhanHang)</strong>
                                    <span class="ms-3 text-muted">@Model.DiaChiHienThi</span>
                                }
                                else
                                {
                                    <span class="fw-bold" style="color:var(--lg-primary);">Vui lòng thêm địa chỉ nhận hàng!</span>
                                }
                            </div>
                            <button type="button" class="btn btn-sm fw-bold border"
                                    style="color:var(--lg-primary); border-color:var(--lg-primary);"
                                    data-bs-toggle="modal" data-bs-target="#addressModal">
                                THAY ĐỔI
                            </button>
                        </div>
                    </div>

                    @await Html.PartialAsync("_CheckoutVoucher", Model)
                </div>

                <div class="col-lg-4">
                    @await Html.PartialAsync("_CheckoutSummary", Model)
                </div>

            </div>
        </form>

        @await Html.PartialAsync("_CheckoutAddress", Model)

    </div>
</div>
@section Scripts {
    <script src="~/js/nguoidung/checkout.js"></script>
    <script>
        document.querySelectorAll('input[type="radio"][name="MaVoucherChon"]').forEach(radio => {
            radio.addEventListener('change', function () {
                document.getElementById('hiddenMaVoucher').value = this.value;
            });
        });
    </script>
}
