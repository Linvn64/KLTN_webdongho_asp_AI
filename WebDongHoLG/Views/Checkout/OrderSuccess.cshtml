@model WebDongHoLG.Models.DonHang
@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="container py-5 text-center">
    <div class="mb-4">
        <i class="fas fa-check-circle fa-5x text-success"></i>
    </div>
    <h2 class="fw-bold text-success mb-2">Đặt hàng thành công!</h2>
    <p class="text-muted mb-1">Mã đơn hàng: <strong>#@Model.MaDonHang</strong></p>
    <p class="text-muted mb-4">Trạng thái: <span class="badge bg-warning text-dark">@Model.TrangThai</span></p>

    <div class="card shadow-sm mx-auto mb-4" style="max-width:600px;">
        <div class="card-body text-start">
            <h5 class="fw-bold mb-3">Sản phẩm đã đặt</h5>
            @foreach (var ct in Model.ChiTietDonHangs)
            {
                <div class="d-flex justify-content-between mb-2">
                    <span>@ct.MaBienTheNavigation.MaSpNavigation.TenSanPham x @ct.SoLuong</span>
                    <span class="text-danger fw-bold">@(((ct.DonGiaTaiThoiDiem ?? 0) * (ct.SoLuong ?? 0)).ToString("#,##0")) ₫</span>
                </div>
            }
            <hr>
            <div class="d-flex justify-content-between">
                <strong>Tổng cộng</strong>
                <strong class="text-danger">@((Model.TongTien ?? 0).ToString("#,##0")) ₫</strong>
            </div>
        </div>
    </div>

    <a asp-controller="SanPhams" asp-action="Index" class="btn btn-primary rounded-pill px-5 me-2">
        Tiếp tục mua sắm
    </a>
</div>