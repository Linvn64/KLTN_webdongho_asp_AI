@model WebDongHoLG.Models.DonHang
@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="container py-5 text-center">
    <div class="mb-4">
        <i class="fas fa-check-circle fa-5x" style="color:var(--lg-primary);"></i>
    </div>
    <h2 class="fw-bold mb-2" style="color:var(--lg-primary);">Đặt hàng thành công!</h2>
    <p class="text-muted mb-1">Mã đơn hàng: <strong>#@Model.MaDonHang</strong></p>
    <p class="text-muted mb-4">
        Trạng thái:
        <span class="badge" style="background-color:var(--lg-primary);">@Model.TrangThai</span>
    </p>

    <div class="card shadow-sm mx-auto mb-4" style="max-width:600px; border-top: 4px solid var(--lg-primary);">
        <div class="card-body text-start">
            <h5 class="fw-bold mb-3 border-bottom pb-2" style="color:var(--lg-primary);">
                Chi tiết thanh toán
            </h5>

            @foreach (var ct in Model.ChiTietDonHangs)
            {
                <div class="d-flex justify-content-between mb-2 text-secondary">
                    <span>@ct.MaBienTheNavigation.MaSpNavigation.TenSanPham x @ct.SoLuong</span>
                    <span>@(((ct.DonGiaTaiThoiDiem ?? 0) * (ct.SoLuong ?? 0)).ToString("#,##0")) ₫</span>
                </div>
            }

            <hr class="my-3">

            @{
                var tienHang = Model.ChiTietDonHangs.Sum(ct => (ct.DonGiaTaiThoiDiem ?? 0) * (ct.SoLuong ?? 0));
            }

            <div class="d-flex justify-content-between mb-2">
                <span>Tổng tiền hàng:</span>
                <span class="fw-bold">@tienHang.ToString("#,##0") ₫</span>
            </div>

            @if (Model.TienGiamGia > 0)
            {
                <div class="d-flex justify-content-between mb-2" style="color:var(--lg-primary);">
                    <span>Giảm giá Voucher:</span>
                    <span class="fw-bold">- @Model.TienGiamGia.ToString("#,##0") ₫</span>
                </div>
            }

            <div class="d-flex justify-content-between mb-2">
                <span>Phí vận chuyển:</span>
                <span class="fw-bold">
                    @(Model.PhiVanChuyen > 0 ? "+" + Model.PhiVanChuyen.ToString("#,##0") + " ₫" : "Miễn phí")
                </span>
            </div>

            <hr class="my-2">

            <div class="d-flex justify-content-between mt-3">
                <strong class="h5">Tổng thanh toán:</strong>
                <strong class="h4" style="color:var(--lg-primary);">
                    @(((decimal)Model.TongTien).ToString("#,##0")) ₫
                </strong>
            </div>
        </div>
    </div>

    <a asp-controller="SanPhams" asp-action="Index"
       class="btn fw-bold rounded-pill px-5 me-2 text-white"
       style="background-color:var(--lg-primary);">
        Tiếp tục mua sắm
    </a>
</div>