@{
    ViewData["Title"] = "AI Tư Vấn — LG WATCH";
}

@section Styles {
    <link rel="stylesheet" href="~/css/chat/chat-page.css" asp-append-version="true" />
}

<div class="chat-page">

    <!-- SIDEBAR -->
    <aside class="chat-sidebar">
        <div class="chat-sidebar-brand">
            <span class="brand-star">✦</span>
            <h2>LG WATCH</h2>
            <p>Trợ lý tư vấn AI</p>
        </div>

        <div class="chat-sidebar-section">
            <h4>Gợi ý cho bạn</h4>
            <div class="chat-suggestions-list">
                <button class="chat-suggest-item" onclick="sendSuggested('Đồng hồ nam dưới 5 triệu đồng')">
                    <span class="suggest-icon">⌚</span>Đồng hồ nam dưới 5 triệu
                </button>
                <button class="chat-suggest-item" onclick="sendSuggested('Đồng hồ nữ phong cách văn phòng')">
                    <span class="suggest-icon">✨</span>Đồng hồ nữ văn phòng
                </button>
                <button class="chat-suggest-item" onclick="sendSuggested('Tư vấn đồng hồ làm quà tặng')">
                    <span class="suggest-icon">🎁</span>Đồng hồ làm quà tặng
                </button>
                <button class="chat-suggest-item" onclick="sendSuggested('Rolex Datejust giá bao nhiêu?')">
                    <span class="suggest-icon">👑</span>Rolex Datejust
                </button>
                <button class="chat-suggest-item" onclick="sendSuggested('Sự khác biệt giữa Automatic và Quartz')">
                    <span class="suggest-icon">⚙️</span>Automatic vs Quartz
                </button>
            </div>
        </div>

        <div class="chat-sidebar-footer">
            <p>LG WATCH — Chính hãng · Uy tín<br>Tư vấn AI hoạt động 24/7</p>
        </div>
    </aside>

    <!-- MAIN -->
    <main class="chat-main">

        <!-- TOPBAR -->
        <div class="chat-topbar">
            <div class="chat-topbar-left">
                <div class="chat-topbar-ava">✦</div>
                <div class="chat-topbar-info">
                    <h3>LG WATCH — Tư Vấn AI</h3>
                    <p>Đang trực tuyến · Phản hồi ngay lập tức</p>
                </div>
            </div>
            <div class="chat-topbar-actions">
                <button class="topbar-btn" onclick="resetChat()">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6" />
                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                    </svg>
                    Xóa lịch sử
                </button>
            </div>
        </div>

        <!-- MESSAGES -->
        <div id="chat-messages" class="chat-messages">
            <div id="chat-welcome" class="chat-welcome">
                <div class="welcome-star">✦</div>
                <h2>Xin chào Quý khách</h2>
                <p>Tôi là trợ lý AI của LG WATCH — sẵn sàng tư vấn đồng hồ chính hãng cho bạn.</p>
                <div class="welcome-chips">
                    <button class="welcome-chip" onclick="sendSuggested('Đồng hồ nam dưới 5 triệu')">Đồng hồ nam &lt; 5 triệu</button>
                    <button class="welcome-chip" onclick="sendSuggested('Đồng hồ nữ văn phòng')">Đồng hồ nữ văn phòng</button>
                    <button class="welcome-chip" onclick="sendSuggested('Rolex Datejust giá bao nhiêu?')">Rolex Datejust</button>
                    <button class="welcome-chip" onclick="sendSuggested('Tư vấn quà tặng đồng hồ')">Quà tặng đồng hồ</button>
                </div>
            </div>
        </div>

        <!-- INPUT BAR -->
        <div class="chat-inputbar">
            <div class="chat-inputbar-inner">
                <textarea id="chat-input" class="chat-textarea"
                          placeholder="Hỏi tôi về bất kỳ dòng đồng hồ nào..." rows="1"></textarea>
                <button id="chat-send" class="chat-send" onclick="handleSend()">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="22" y1="2" x2="11" y2="13" />
                        <polygon points="22 2 15 22 11 13 2 9 22 2" />
                    </svg>
                </button>
            </div>
            <p class="inputbar-hint">Nhấn Enter để gửi · Shift+Enter để xuống dòng</p>
        </div>

    </main>
</div>

@section Scripts {
    <script src="~/js/nguoidung/chat-page.js" asp-append-version="true"></script>
}
