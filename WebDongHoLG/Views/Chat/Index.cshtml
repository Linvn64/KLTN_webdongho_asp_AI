@{
    ViewData["Title"] = "AI Tư Vấn — LG WATCH";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <style>
        :root {
            --c-gold: #b5893f;
            --c-gold-mid: #d4a84b;
            --c-gold-bright: #f0d080;
            --c-gold-glow: rgba(212,168,75,.08);
            --c-gold-border: rgba(181,137,63,0.18);
            --c-bg-0: #ffffff;
            --c-bg-1: #f8f9fa;
            --c-bg-3: #f1f3f5;
            --c-bg-4: #e9ecef;
            --c-text: #1a1a1a;
            --c-muted: #6c757d;
            --c-dim: #adb5bd;
            --c-dark-text: #1a1712;
        }

        /* ── LAYOUT FULLPAGE ── */
        .chat-page {
            display: flex;
            height: calc(100vh - 70px); /* trừ navbar */
            background: #fafaf8;
            overflow: hidden;
        }

        /* ── SIDEBAR ── */
        .chat-sidebar {
            width: 260px;
            min-width: 260px;
            background: var(--c-bg-0);
            border-right: 1px solid var(--c-gold-border);
            display: flex;
            flex-direction: column;
            padding: 28px 0 20px;
        }

        .chat-sidebar-brand {
            padding: 0 22px 24px;
            border-bottom: 1px solid var(--c-gold-border);
            text-align: center;
        }

            .chat-sidebar-brand .brand-star {
                font-size: 22px;
                color: var(--c-gold-mid);
                display: block;
                margin-bottom: 8px;
            }

            .chat-sidebar-brand h2 {
                font-size: 17px;
                font-weight: 600;
                color: #8b6120;
                letter-spacing: 1px;
                margin: 0 0 4px;
            }

            .chat-sidebar-brand p {
                font-size: 11px;
                color: var(--c-dim);
                font-weight: 300;
                letter-spacing: .4px;
                margin: 0;
            }

        .chat-sidebar-section {
            padding: 20px 16px 10px;
        }

            .chat-sidebar-section h4 {
                font-size: 10px;
                font-weight: 400;
                letter-spacing: 1.5px;
                color: var(--c-dim);
                text-transform: uppercase;
                margin: 0 0 12px 6px;
            }

        .chat-suggestions-list {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .chat-suggest-item {
            background: none;
            border: 1px solid var(--c-gold-border);
            border-radius: 10px;
            padding: 9px 14px;
            font-size: 12.5px;
            font-weight: 300;
            cursor: pointer;
            text-align: left;
            transition: all .2s;
            line-height: 1.4;
        }

            .chat-suggest-item:hover {
                background: var(--c-gold-glow);
                border-color: var(--c-gold);
                color: #8b6120;
                transform: translateX(2px);
            }

            .chat-suggest-item .suggest-icon {
                font-size: 13px;
                margin-right: 6px;
                opacity: 0.7;
            }

        .chat-sidebar-footer {
            margin-top: auto;
            padding: 16px 20px;
            border-top: 1px solid var(--c-gold-border);
        }

            .chat-sidebar-footer p {
                font-size: 10.5px;
                color: var(--c-dim);
                font-weight: 300;
                letter-spacing: .3px;
                line-height: 1.6;
                text-align: center;
            }

        /* ── MAIN CHAT AREA ── */
        .chat-main {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background: var(--c-bg-1);
        }

        /* ── CHAT TOPBAR ── */
        .chat-topbar {
            background: var(--c-bg-0);
            border-bottom: 1px solid var(--c-gold-border);
            padding: 0 28px;
            height: 58px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-shrink: 0;
            position: relative;
        }

            .chat-topbar::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 0;
                right: 0;
                height: 1px;
                background: linear-gradient(90deg, transparent 0%, var(--c-gold-mid) 50%, transparent 100%);
                opacity: .3;
            }

        .chat-topbar-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .chat-topbar-ava {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            border: 1px solid var(--c-gold);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            color: var(--c-gold-mid);
            position: relative;
        }

            .chat-topbar-ava::after {
                content: '';
                position: absolute;
                bottom: 1px;
                right: 0px;
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: #3ecf72;
                border: 1.5px solid var(--c-bg-0);
            }

        .chat-topbar-info h3 {
            font-size: 15px;
            font-weight: 600;
            color: #8b6120;
            letter-spacing: .6px;
            line-height: 1;
            margin: 0;
        }

        .chat-topbar-info p {
            font-size: 10px;
            color: var(--c-dim);
            font-weight: 300;
            margin: 3px 0 0;
            letter-spacing: .3px;
        }

        .chat-topbar-actions {
            display: flex;
            gap: 6px;
        }

        .topbar-btn {
            background: none;
            border: 1px solid var(--c-gold-border);
            border-radius: 8px;
            padding: 6px 14px;
            font-size: 11.5px;
            font-weight: 300;
            font-family: var(--font-b);
            color: var(--c-muted);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all .2s;
            letter-spacing: .3px;
        }

            .topbar-btn:hover {
                background: var(--c-gold-glow);
                border-color: var(--c-gold);
                color: #8b6120;
            }

            .topbar-btn svg {
                flex-shrink: 0;
            }

        /* ── MESSAGES ── */
        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 32px 0;
            display: flex;
            flex-direction: column;
            gap: 0;
            scrollbar-width: thin;
            scrollbar-color: var(--c-bg-4) transparent;
        }

            .chat-messages::-webkit-scrollbar {
                width: 4px;
            }

            .chat-messages::-webkit-scrollbar-track {
                background: transparent;
            }

            .chat-messages::-webkit-scrollbar-thumb {
                background: var(--c-bg-4);
                border-radius: 4px;
            }

        /* Message row */
        .msg-row {
            padding: 10px 28px;
            display: flex;
            gap: 14px;
            max-width: 860px;
            width: 100%;
            margin: 0 auto;
            align-items: flex-start;
        }

            .msg-row.user {
                flex-direction: row-reverse;
            }

        .msg-ava {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            margin-top: 2px;
        }

        .msg-row:not(.user) .msg-ava {
            border: 1px solid var(--c-gold-border);
            color: var(--c-gold-mid);
            background: #fff;
        }

        .msg-row.user .msg-ava {
            background: var(--c-bg-4);
            color: var(--c-muted);
            border: 1px solid transparent;
        }

        .msg-body {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .msg-row.user .msg-body {
            align-items: flex-end;
        }

        .msg-name {
            font-size: 11px;
            font-weight: 400;
            color: var(--c-dim);
            letter-spacing: .4px;
            padding: 0 2px;
        }

        .msg-bubble {
            max-width: 680px;
            padding: 13px 18px;
            border-radius: 18px;
            font-size: 14px;
            font-weight: 300;
            line-height: 1.7;
            word-wrap: break-word;
            overflow-wrap: break-word;
            word-break: break-word;
            position: relative;
        }

        .msg-row:not(.user) .msg-bubble {
            background: #ffffff;
            color: var(--c-dark-text);
            border: 1px solid rgba(0,0,0,0.05);
            border-top-left-radius: 4px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.04);
        }

            .msg-row:not(.user) .msg-bubble::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                bottom: 0;
                width: 2.5px;
                background: linear-gradient(180deg, var(--c-gold) 0%, transparent 100%);
                border-radius: 2px 0 0 2px;
                opacity: .35;
            }

            .msg-row:not(.user) .msg-bubble b {
                color: #8b6120;
                font-weight: 500;
            }

        .msg-row.user .msg-bubble {
            background: var(--c-gold);
            color: #fff;
            border-top-right-radius: 4px;
        }

            .msg-row.user .msg-bubble b {
                color: var(--c-gold-bright);
                font-weight: 500;
            }

        .msg-time {
            font-size: 10px;
            color: var(--c-dim);
            font-weight: 300;
            padding: 0 2px;
            letter-spacing: .3px;
        }

        /* streaming cursor */
        .msg-cursor {
            display: inline-block;
            width: 2px;
            height: 13px;
            background: var(--c-gold);
            margin-left: 2px;
            vertical-align: middle;
            border-radius: 1px;
            animation: cur .9s infinite;
        }
        @@keyframes cur {
            0%,100%

        {
            opacity: 1
        }

        50% {
            opacity: 0
        }

        }

        /* ── WELCOME STATE ── */
        .chat-welcome {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            flex: 1;
            padding: 48px 24px;
            text-align: center;
        }

        .welcome-star {
            font-size: 36px;
            color: var(--c-gold-mid);
            margin-bottom: 16px;
            opacity: .8;
        }

        .chat-welcome h2 {
            font-size: 28px;
            font-weight: 400;
            color: #8b6120;
            letter-spacing: 1px;
            margin: 0 0 8px;
        }

        .chat-welcome p {
            font-size: 14px;
            font-weight: 300;
            color: var(--c-muted);
            margin: 0 0 32px;
            max-width: 360px;
            line-height: 1.6;
        }

        .welcome-chips {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            justify-content: center;
            max-width: 500px;
        }

        .welcome-chip {
            background: #fff;
            border: 1px solid var(--c-gold-border);
            border-radius: 20px;
            padding: 8px 18px;
            font-size: 13px;
            font-weight: 300;
            font-family: var(--font-b);
            color: var(--c-muted);
            cursor: pointer;
            transition: all .2s;
            letter-spacing: .3px;
        }

            .welcome-chip:hover {
                background: var(--c-gold-glow);
                border-color: var(--c-gold);
                color: #8b6120;
                transform: translateY(-2px);
            }

        /* ── INPUT BAR ── */
        .chat-inputbar {
            background: var(--c-bg-0);
            border-top: 1px solid var(--c-gold-border);
            padding: 16px 28px 20px;
            flex-shrink: 0;
        }

        .chat-inputbar-inner {
            max-width: 860px;
            margin: 0 auto;
            display: flex;
            gap: 10px;
            align-items: flex-end;
            background: var(--c-bg-1);
            border: 1px solid var(--c-gold-border);
            border-radius: 16px;
            padding: 10px 12px 10px 16px;
            transition: border-color .25s;
        }

            .chat-inputbar-inner:focus-within {
                border-color: rgba(181,137,63,.4);
                background: #fff;
            }

        .chat-textarea {
            flex: 1;
            border: none;
            background: none;
            outline: none;
            resize: none;
            font-size: 14px;
            font-weight: 300;
            line-height: 1.55;
            font-family: var(--font-b);
            color: var(--c-text);
            max-height: 120px;
            overflow-y: auto;
            padding: 0;
        }

            .chat-textarea::placeholder {
                color: var(--c-dim);
            }

            .chat-textarea::-webkit-scrollbar {
                width: 2px;
            }

            .chat-textarea::-webkit-scrollbar-thumb {
                background: var(--c-bg-4);
            }

        .chat-send {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: var(--c-gold);
            border: none;
            color: #fff;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: all .25s;
            align-self: flex-end;
        }

            .chat-send:hover {
                background: #c8972a;
                transform: scale(1.06);
                box-shadow: 0 4px 14px rgba(181,137,63,.3);
            }

            .chat-send:active {
                transform: scale(.96);
            }

            .chat-send:disabled {
                background: var(--c-bg-4);
                color: var(--c-dim);
                cursor: not-allowed;
                transform: none;
                box-shadow: none;
            }

        .inputbar-hint {
            max-width: 860px;
            margin: 8px auto 0;
            font-size: 10.5px;
            color: var(--c-dim);
            font-weight: 300;
            text-align: center;
            letter-spacing: .3px;
        }

        /* ── PRODUCT CARD ── */
        .wc-product-card {
            display: flex;
            gap: 12px;
            margin-top: 10px;
            background: #fafaf8;
            border-radius: 12px;
            border: 1px solid rgba(181,137,63,.2);
            padding: 10px 12px;
            transition: border-color .2s, box-shadow .2s;
            max-width: 300px;
        }

            .wc-product-card:hover {
                border-color: var(--c-gold);
                box-shadow: 0 2px 12px rgba(181,137,63,.1);
            }

        .wc-card-img {
            width: 52px;
            height: 52px;
            border-radius: 8px;
            object-fit: cover;
            flex-shrink: 0;
            border: 1px solid rgba(0,0,0,.07);
            background: #f0ece4;
        }

        .wc-card-body {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            flex: 1;
            min-width: 0;
        }

        .wc-card-name {
            font-size: 12.5px;
            font-weight: 400;
            color: var(--c-dark-text);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .wc-card-price {
            font-family: var(--font-d);
            font-size: 13px;
            font-weight: 500;
            color: #8b6120;
        }

        .wc-card-btn {
            align-self: flex-start;
            background: none;
            border: 1px solid rgba(181,137,63,.3);
            border-radius: 5px;
            padding: 3px 10px;
            font-size: 10.5px;
            font-weight: 400;
            letter-spacing: .6px;
            cursor: pointer;
            color: var(--c-gold);
            font-family: var(--font-b);
            transition: all .2s;
        }

            .wc-card-btn:hover {
                background: var(--c-gold);
                border-color: var(--c-gold);
                color: #fff;
            }

        /* ── RESPONSIVE ── */
        @@media (max-width: 768px) {
            .chat-sidebar {
                display: none;
            }

            .msg-row {
                padding: 8px 16px;
            }

            .chat-topbar {
                padding: 0 16px;
            }

            .chat-inputbar {
                padding: 12px 16px 16px;
            }
        }
    </style>
}

<div class="chat-page">

    <!-- SIDEBAR -->
    <aside class="chat-sidebar">
        <div class="chat-sidebar-brand">
            <span class="brand-star">✦</span>
            <h2>LG WATCH</h2>
            <p>Trợ lý tư vấn AI</p>
        </div>

        <div class="chat-sidebar-section">
            <h4>Gợi ý cho bạn</h4>
            <div class="chat-suggestions-list">
                <button class="chat-suggest-item" onclick="sendSuggested('Đồng hồ nam dưới 5 triệu đồng')">
                    <span class="suggest-icon">⌚</span>Đồng hồ nam dưới 5 triệu
                </button>
                <button class="chat-suggest-item" onclick="sendSuggested('Đồng hồ nữ phong cách văn phòng')">
                    <span class="suggest-icon">✨</span>Đồng hồ nữ văn phòng
                </button>
                <button class="chat-suggest-item" onclick="sendSuggested('Tư vấn đồng hồ làm quà tặng')">
                    <span class="suggest-icon">🎁</span>Đồng hồ làm quà tặng
                </button>
                <button class="chat-suggest-item" onclick="sendSuggested('Rolex Datejust giá bao nhiêu?')">
                    <span class="suggest-icon">👑</span>Rolex Datejust
                </button>
                <button class="chat-suggest-item" onclick="sendSuggested('Sự khác biệt giữa Automatic và Quartz')">
                    <span class="suggest-icon">⚙️</span>Automatic vs Quartz
                </button>
            </div>
        </div>

        <div class="chat-sidebar-footer">
            <p>LG WATCH — Chính hãng · Uy tín<br>Tư vấn AI hoạt động 24/7</p>
        </div>
    </aside>

    <!-- MAIN -->
    <main class="chat-main">

        <!-- TOPBAR -->
        <div class="chat-topbar">
            <div class="chat-topbar-left">
                <div class="chat-topbar-ava">✦</div>
                <div class="chat-topbar-info">
                    <h3>LG WATCH — Tư Vấn AI</h3>
                    <p>Đang trực tuyến · Phản hồi ngay lập tức</p>
                </div>
            </div>
            <div class="chat-topbar-actions">
                <button class="topbar-btn" onclick="resetChat()">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6" />
                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                    </svg>
                    Xóa lịch sử
                </button>
            </div>
        </div>

        <!-- MESSAGES -->
        <div id="chat-messages" class="chat-messages">
            <!-- Welcome state hiển thị khi chưa có tin -->
            <div id="chat-welcome" class="chat-welcome">
                <div class="welcome-star">✦</div>
                <h2>Xin chào Quý khách</h2>
                <p>Tôi là trợ lý AI của LG WATCH — sẵn sàng tư vấn đồng hồ chính hãng cho bạn.</p>
                <div class="welcome-chips">
                    <button class="welcome-chip" onclick="sendSuggested('Đồng hồ nam dưới 5 triệu')">Đồng hồ nam &lt; 5 triệu</button>
                    <button class="welcome-chip" onclick="sendSuggested('Đồng hồ nữ văn phòng')">Đồng hồ nữ văn phòng</button>
                    <button class="welcome-chip" onclick="sendSuggested('Rolex Datejust giá bao nhiêu?')">Rolex Datejust</button>
                    <button class="welcome-chip" onclick="sendSuggested('Tư vấn quà tặng đồng hồ')">Quà tặng đồng hồ</button>
                </div>
            </div>
        </div>

        <!-- INPUT BAR -->
        <div class="chat-inputbar">
            <div class="chat-inputbar-inner">
                <textarea id="chat-input" class="chat-textarea" placeholder="Hỏi tôi về bất kỳ dòng đồng hồ nào..." rows="1"></textarea>
                <button id="chat-send" class="chat-send" onclick="handleSend()">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="22" y1="2" x2="11" y2="13" />
                        <polygon points="22 2 15 22 11 13 2 9 22 2" />
                    </svg>
                </button>
            </div>
            <p class="inputbar-hint">Nhấn Enter để gửi · Shift+Enter để xuống dòng</p>
        </div>

    </main>
</div>

@section Scripts {
    <script>
        const chatState = {
            isStreaming: false,
            messages: loadFromSession()
        };

        function loadFromSession() {
            try {
                const raw = sessionStorage.getItem("lgw_chat_v3");
                if (raw) return JSON.parse(raw);
            } catch (_) {}
            return [];
        }

        function saveToSession() {
            try {
                const clean = chatState.messages.map(m => ({ ...m, streaming: false }));
                sessionStorage.setItem("lgw_chat_v3", JSON.stringify(clean));
            } catch (_) {}
        }

        function now() {
            const d = new Date();
            return String(d.getHours()).padStart(2, "0") + ":" + String(d.getMinutes()).padStart(2, "0");
        }

        // Setup input
        document.addEventListener("DOMContentLoaded", () => {
            const input = document.getElementById("chat-input");
            if (input) {
                input.addEventListener("keydown", e => {
                    if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); handleSend(); }
                });
                input.addEventListener("input", function () {
                    this.style.height = "auto";
                    this.style.height = Math.min(this.scrollHeight, 120) + "px";
                });
            }
            // Render messages từ session (nếu có)
            if (chatState.messages.length > 0) {
                document.getElementById("chat-welcome").style.display = "none";
                renderAllMessages();
            }
        });

        function sendSuggested(text) {
            const input = document.getElementById("chat-input");
            if (input) { input.value = text; handleSend(); }
        }

        async function handleSend() {
            const input = document.getElementById("chat-input");
            const question = input?.value.trim();
            if (!question || chatState.isStreaming) return;

            input.value = "";
            input.style.height = "auto";

            // Ẩn welcome
            const welcome = document.getElementById("chat-welcome");
            if (welcome) welcome.style.display = "none";

            chatState.messages.push({ role: "user", content: question, time: now() });
            appendMessage(chatState.messages.length - 1);

            chatState.isStreaming = true;
            setSendBtn(false);

            const aiIdx = chatState.messages.push({ role: "assistant", content: "", streaming: true }) - 1;
            appendMessage(aiIdx);

            try {
                const res = await fetch(`/api/Chat/stream?question=${encodeURIComponent(question)}`);
                const reader = res.body.getReader();
                const dec = new TextDecoder();
                let buf = "";

                while (true) {
                    const { done, value } = await reader.read();
                    if (done) break;
                    for (const line of dec.decode(value).split("\n")) {
                        if (!line.startsWith("data: ")) continue;
                        const data = line.slice(6).trim();
                        if (data === "[DONE]") break;
                        try {
                            buf += JSON.parse(data).text;
                            chatState.messages[aiIdx].content = buf;
                            updateBubble(aiIdx);
                        } catch (_) {}
                    }
                }
            } catch (err) {
                chatState.messages[aiIdx].content = "Xin lỗi Quý khách, đã có lỗi kết nối. Vui lòng thử lại sau.";
                updateBubble(aiIdx);
                console.error("[LGW Chat]", err);
            } finally {
                chatState.isStreaming = false;
                chatState.messages[aiIdx].streaming = false;
                chatState.messages[aiIdx].time = now();
                setSendBtn(true);
                updateBubble(aiIdx);
                saveToSession();
            }
        }

        function renderBubbleHtml(msg) {
            return (msg.content || "...")
                .replace(/\[CARD:(.*?)\|(.*?)\|(.*?)\|(.*?)\]/g, (_, id, name, price, img) => `
                    <div class="wc-product-card">
                        <img src="${img}" class="wc-card-img" alt="${name}" onerror="this.src='/images/no-image.jpg'">
                        <div class="wc-card-body">
                            <div class="wc-card-name">${name}</div>
                            <div class="wc-card-price">${price}</div>
                            <button class="wc-card-btn" onclick="location.href='/SanPhams/Detail/${id}'">XEM CHI TIẾT</button>
                        </div>
                    </div>`)
                .replace(/\*\*(.*?)\*\*/g, "<b>$1</b>")
                .replace(/\n/g, "<br>")
                .replace(/^- /gm, "• ");
        }

        function appendMessage(idx) {
            const msg = chatState.messages[idx];
            const container = document.getElementById("chat-messages");
            const isUser = msg.role === "user";

            const row = document.createElement("div");
            row.className = `msg-row ${isUser ? "user" : ""}`;
            row.id = `msg-${idx}`;

            row.innerHTML = `
                <div class="msg-ava">${isUser ? "👤" : "✦"}</div>
                <div class="msg-body">
                    <div class="msg-name">${isUser ? "Bạn" : "LG WATCH AI"}</div>
                    <div class="msg-bubble" id="bubble-${idx}">
                        ${renderBubbleHtml(msg)}
                        ${msg.streaming ? '<span class="msg-cursor"></span>' : ""}
                    </div>
                    ${msg.time ? `<span class="msg-time">${msg.time}</span>` : ""}
                </div>`;

            container.appendChild(row);
            container.scrollTop = container.scrollHeight;
        }

        function updateBubble(idx) {
            const bubble = document.getElementById(`bubble-${idx}`);
            if (!bubble) return;
            const msg = chatState.messages[idx];
            bubble.innerHTML = renderBubbleHtml(msg) + (msg.streaming ? '<span class="msg-cursor"></span>' : "");

            // Update time
            const row = document.getElementById(`msg-${idx}`);
            if (row && msg.time && !msg.streaming) {
                let timeEl = row.querySelector(".msg-time");
                if (!timeEl) {
                    timeEl = document.createElement("span");
                    timeEl.className = "msg-time";
                    row.querySelector(".msg-body").appendChild(timeEl);
                }
                timeEl.textContent = msg.time;
            }

            const container = document.getElementById("chat-messages");
            container.scrollTop = container.scrollHeight;
        }

        function renderAllMessages() {
            chatState.messages.forEach((_, idx) => appendMessage(idx));
        }

        function setSendBtn(enabled) {
            const btn = document.getElementById("chat-send");
            if (btn) btn.disabled = !enabled;
        }

        function resetChat() {
            if (!confirm("Xóa toàn bộ lịch sử trò chuyện?")) return;
            chatState.messages = [];
            try { sessionStorage.removeItem("lgw_chat_v3"); } catch (_) {}

            const container = document.getElementById("chat-messages");
            container.innerHTML = `
                <div id="chat-welcome" class="chat-welcome">
                    <div class="welcome-star">✦</div>
                    <h2>Xin chào Quý khách</h2>
                    <p>Tôi là trợ lý AI của LG WATCH — sẵn sàng tư vấn đồng hồ chính hãng cho bạn.</p>
                    <div class="welcome-chips">
                        <button class="welcome-chip" onclick="sendSuggested('Đồng hồ nam dưới 5 triệu')">Đồng hồ nam &lt; 5 triệu</button>
                        <button class="welcome-chip" onclick="sendSuggested('Đồng hồ nữ văn phòng')">Đồng hồ nữ văn phòng</button>
                        <button class="welcome-chip" onclick="sendSuggested('Rolex Datejust giá bao nhiêu?')">Rolex Datejust</button>
                        <button class="welcome-chip" onclick="sendSuggested('Tư vấn quà tặng đồng hồ')">Quà tặng đồng hồ</button>
                    </div>
                </div>`;
        }
    </script>
}
