<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebDongHo</title>
    <meta content="" name="keywords">
    <meta content="" name="description">
    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&family=Raleway:wght@600;800&display=swap" rel="stylesheet">

    <!-- Icon Font Stylesheet -->
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="~/home/lib/lightbox/css/lightbox.min.css" rel="stylesheet">
    <link href="~/home/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">


    <!-- Customized Bootstrap Stylesheet -->
    <link href="~/home/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

    <!-- Template Stylesheet -->
    <link href="~/home/css/style.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/user-home.css?v=1.1" asp-append-version="true" />

    @RenderSection("Styles", required: false)

</head>

<body>

    @await Html.PartialAsync("_ThemNhanhSanPham")

    @if (TempData["ToastSuccess"] != null)
    {
        <input type="hidden" id="_toastSuccess" value="@TempData["ToastSuccess"]" />
    }
    @if (TempData["ToastError"] != null)
    {
        <input type="hidden" id="_toastError" value="@TempData["ToastError"]" />
    }
    @if (TempData["ToastWarning"] != null)
    {
        <input type="hidden" id="_toastWarning" value="@TempData["ToastWarning"]" />
    }


    <!-- Spinner Start -->
    <div id="spinner" class="show w-100 vh-100 bg-white position-fixed translate-middle top-50 start-50  d-flex align-items-center justify-content-center">
        <div class="spinner-grow text-primary" role="status"></div>
    </div>
    <!-- Spinner End -->
    <!-- Navbar start -->
    <div class="container-fluid fixed-top">
        <div class="container topbar bg-primary d-none d-lg-block">
            <div class="d-flex justify-content-between">
                <div class="top-info ps-2">
                    <small class="me-3"><i class="fas fa-map-marker-alt me-2 text-secondary"></i> <a href="#" class="text-white">UNETI UNIVERSITY</a></small>
                    <small class="me-3"><i class="fas fa-envelope me-2 text-secondary"></i><a href="#" class="text-white">gmail@uneti.com</a></small>
                </div>
            </div>
        </div>
        <div class="container px-0">
            <nav class="navbar navbar-light bg-white navbar-expand-xl">
                <a asp-area="Default" asp-controller="Home" asp-action="Index" class="navbar-brand"><h1 class="text-primary display-6">LGWATCH</h1></a>
                <button class="navbar-toggler py-2 px-3" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                    <span class="fa fa-bars text-primary"></span>
                </button>
                <div class="collapse navbar-collapse bg-white" id="navbarCollapse">
                    <div class="navbar-nav mx-auto">
                        @{
                            var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                            var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                        }

                        <a asp-area="Default" asp-controller="Home" asp-action="Index"
                           class="nav-item nav-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")">Trang chủ</a>

                        <a asp-area="Default" asp-controller="SanPhams" asp-action="Index"
                           class="nav-item nav-link @(currentController == "SanPhams" ? "active" : "")">Sản phẩm</a>

                        <a asp-area="Default" asp-controller="Home" asp-action="Faq"
                           class="nav-item nav-link @(currentAction == "Faq" ? "active" : "")">FAQ</a>

                        <a asp-area="Default" asp-controller="Home" asp-action="Contact"
                           class="nav-item nav-link @(currentAction == "Contact" ? "active" : "")">Về LGWATCH</a>

                        <a asp-area="Default" asp-controller="Chat" asp-action="Index"
                           class="nav-item nav-link @(currentController == "Chat" && currentAction == "Index" ? "active" : "")">AI</a>
                    </div>                   
                    <div class="d-flex m-3 me-0">
                        <button class="btn-search btn border border-secondary btn-md-square rounded-circle bg-white me-4" data-bs-toggle="modal" data-bs-target="#searchModal"><i class="fas fa-search text-primary"></i></button>
                        <a asp-controller="GioHangs" asp-action="Index" class="position-relative me-4 my-auto">
                            <i class="fa fa-shopping-bag fa-2x"></i>
                            <span class="position-absolute bg-secondary rounded-circle d-flex align-items-center justify-content-center text-dark px-1"
                                  style="top: -5px; left: 15px; height: 20px; min-width: 20px;">
                                 @await Component.InvokeAsync("GioHang") 
                            </span>
                        </a>
                        <div class="nav-item dropdown my-auto position-relative user-dropdown">
                            <a href="javascript:void(0)" class="nav-link">
                                <i class="fas fa-user fa-2x text-primary"></i>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end m-0 bg-white shadow border-0 rounded-3">
                                <partial name="_LoginPartial" />
                            </div>
                        </div>
                    </div>
                </div>
            </nav>
        </div>
    </div>
    <!-- Navbar End -->
    <!-- Modal Search Start -->
    <div class="modal fade" id="searchModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content rounded-0">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Tìm kiếm sản phẩm</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body d-flex align-items-center">
                    <form action="/SanPhams/Search" method="get" class="w-75 mx-auto">
                        <div class="input-group d-flex">
                            <input id="searchText" name="keyword" type="search" class="form-control p-3"
                                   placeholder="Nhập tên đồng hồ hoặc thương hiệu cần tìm..." aria-describedby="search-icon-1">
                            <button type="submit" class="input-group-text p-3">
                                <i class="fa fa-search"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>    <!-- Modal Search End -->

    <div style="margin-top: 150px;">
        <main role="main" class="pb-3">
            <div class="container">
                @RenderBody()
            </div>
        </main>
    </div>

    @await Html.PartialAsync("_Footer")

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/home/lib/easing/easing.min.js"></script>
    <script src="~/home/lib/waypoints/waypoints.min.js"></script>
    <script src="~/home/lib/lightbox/js/lightbox.min.js"></script>
    <script src="~/home/lib/owlcarousel/owl.carousel.min.js"></script>
    <script src="~/home/js/main.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {

            $('#searchText').keypress(function (e) {
                if (e.which == 13) {
                    e.preventDefault();
                    $(this).closest('form').submit();
                }
            });
        });
    </script>

    <div id="toastContainer" style="position:fixed; top:20px; right:20px; z-index:9999; min-width:320px;">
    </div>
    <script src="~/js/layout.js" asp-append-version="true"></script>

    <div id="root"></div>
    <link href="~/chat/chatbot.css" rel="stylesheet" />
    <script src="~/chat/chatbot.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
