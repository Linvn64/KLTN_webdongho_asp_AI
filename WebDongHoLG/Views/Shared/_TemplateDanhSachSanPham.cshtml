@{
    Layout = "_Layout";
}

@* <!-- Single Page Header start -->
@RenderSection("BreadCum", required: false)
<!-- Single Page Header End --> *@
<!-- Fruits Shop Start-->
<div class="container-fluid fruite py-5">
    <div class="container py-5">
        <div class="row g-4">
            <div class="col-lg-12">
                <div class="row g-4">
                    <div class="col-lg-12 mb-4">
                        <form asp-action="Index" asp-controller="SanPhams" method="get" class="input-group">
                            <input name="keyword" class="form-control border-end-0 px-3"
                                   placeholder="Tìm đồng hồ..."
                                   style="height: 46px; border-radius: 8px 0 0 8px; border-color: var(--lg-border); box-shadow: none;">

                            <button class="btn border-start-0 px-3" type="submit"
                                    style="height: 46px; border-radius: 0 8px 8px 0; background: #fff; border: 1px solid var(--lg-border); color: var(--lg-primary);">
                                <i class="fa fa-search"></i>
                            </button>
                        </form>
                    </div>
                </div>
                <div class="row g-4">
                    <div class="col-lg-3">
                        @await Component.InvokeAsync("DanhMuc")
                    </div>
                    <div class="col-lg-9">
                        @RenderSection("FilterBar", required: false)
                        <div class="row g-4 justify-content-center">    
                            @RenderBody()
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Fruits Shop End-->
