@{
    Layout = "_Layout";
}

@* <!-- Single Page Header start -->
@RenderSection("BreadCum", required: false)
<!-- Single Page Header End --> *@
<!-- Fruits Shop Start-->
<div class="container-fluid fruite py-5">
    <div class="container py-5">
        <div class="row g-4">
            <div class="col-lg-12">
                <div class="row g-4">
                    <div class="col-xl-3">
                        <form asp-controller="SanPhams" asp-action="Search" method="get">
                            <div class="input-group w-100 mx-auto d-flex">
                                <input name="keyword" type="search" class="form-control p-3" placeholder="Tìm tên đồng hồ, thương hiệu..." aria-describedby="search-icon-1">
                                <button type="submit" id="search-icon-1" class="input-group-text p-3 border-0">
                                    <i class="fa fa-search text-primary"></i>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
                <div class="row g-4">
                    <div class="col-lg-3">
                        @await Component.InvokeAsync("DanhMuc")
                    </div>
                    <div class="col-lg-9">
                        @RenderSection("FilterBar", required: false)
                        <div class="row g-4 justify-content-center">    
                            @RenderBody()
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Fruits Shop End-->
