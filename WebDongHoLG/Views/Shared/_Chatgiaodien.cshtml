<div id="chatWidget" style="position:fixed; bottom:24px; right:24px; z-index:9999;">

    <button id="btnOpenChat" onclick="toggleChat()"
            style="width:56px; height:56px; border-radius:50%; background:#1a56a0;
                   border:none; color:white; cursor:pointer; position:relative;
                   box-shadow:0 4px 14px rgba(26,86,160,0.4);">
        <span class="fab-ring"></span>
        <span class="fab-ring fab-ring2"></span>
        <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5"
             style="width:26px;height:26px;position:relative;z-index:1;">
            <path d="M12 2a2 2 0 012 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 017 7h1a1 1 0 010 2h-1v1a2 2 0 01-2 2H5a2 2 0 01-2-2v-1H2a1 1 0 010-2h1a7 7 0 017-7h1V5.73A2 2 0 0110 4a2 2 0 012-2z" />
        </svg>
    </button>

    <div id="chatBox"
         style="display:none; position:absolute; bottom:70px; right:0;
                width:370px; height:520px; background:white; border-radius:14px;
                box-shadow:0 8px 32px rgba(0,0,0,0.18);
                flex-direction:column; overflow:hidden;
                border:0.5px solid rgba(0,0,0,0.1);">

        <div style="background:#1a56a0; color:white; padding:12px 14px;
                    display:flex; justify-content:space-between; align-items:center; flex-shrink:0;">
            <div style="display:flex; align-items:center; gap:10px;">
                <div style="width:36px; height:36px; border-radius:50%; position:relative; flex-shrink:0;">
                    <div class="ai-spin" style="width:100%; height:100%; border-radius:50%;
                         background:conic-gradient(#60a5fa,#a78bfa,#34d399,#60a5fa);"></div>
                    <div style="position:absolute; inset:0; margin:auto; width:26px; height:26px;
                                border-radius:50%; background:#1a56a0; display:flex;
                                align-items:center; justify-content:center;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5"
                             style="width:14px;height:14px;">
                            <path d="M12 2a2 2 0 012 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 017 7h1a1 1 0 010 2h-1v1a2 2 0 01-2 2H5a2 2 0 01-2-2v-1H2a1 1 0 010-2h1a7 7 0 017-7h1V5.73A2 2 0 0110 4a2 2 0 012-2z" />
                        </svg>
                    </div>
                </div>
                <div>
                    <div style="font-weight:600; font-size:14px;">Tư vấn đồng hồ</div>
                    <div style="font-size:11px; opacity:0.8;">Trợ lý AI · Phản hồi tức thì</div>
                </div>
            </div>
            <div style="display:flex; gap:6px; align-items:center;">
                <button onclick="newChat()"
                        title="Tạo đoạn chat mới"
                        style="background:rgba(255,255,255,0.15); border:none; color:white;
                               border-radius:6px; padding:5px 9px; font-size:11px;
                               cursor:pointer; display:flex; align-items:center; gap:4px;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         style="width:12px;height:12px;">
                        <path d="M12 5v14M5 12h14" />
                    </svg>
                    Chat mới
                </button>
                <button onclick="openFullPage()"
                        title="Mở trang tư vấn"
                        style="background:rgba(255,255,255,0.15); border:none; color:white;
                               border-radius:6px; padding:5px 9px; font-size:11px;
                               cursor:pointer; display:flex; align-items:center; gap:4px;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         style="width:12px;height:12px;">
                        <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3" />
                    </svg>
                    Mở rộng
                </button>
                <button onclick="toggleChat()"
                        style="background:none; border:none; color:white;
                               font-size:18px; cursor:pointer; padding:2px 4px; line-height:1;">
                    &#x2715;
                </button>
            </div>
        </div>

        <div id="chatMessages"
             style="flex:1; overflow-y:auto; padding:14px;
                    display:flex; flex-direction:column; gap:10px;
                    background:#f8f9fc;">
            <div class="chat-msg bot">
                Xin chào! Tôi là trợ lý tư vấn đồng hồ LGWATCH. Bạn cần tôi giúp gì? 😊
            </div>
        </div>

        <div style="padding:10px 12px; border-top:1px solid #eee;
                    display:flex; gap:8px; align-items:center; background:white; flex-shrink:0;">
            <input id="chatInput" type="text" placeholder="Nhập câu hỏi..."
                   style="flex:1; border:1px solid #ddd; border-radius:20px;
                          padding:8px 14px; font-size:13px; outline:none; background:#f8f9fc;"
                   onkeydown="if(event.key==='Enter') sendChat()" />
            <button onclick="sendChat()"
                    style="width:36px; height:36px; border-radius:50%; background:#1a56a0;
                           color:white; border:none; cursor:pointer;
                           display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     style="width:15px;height:15px;">
                    <line x1="22" y1="2" x2="11" y2="13" />
                    <polygon points="22 2 15 22 11 13 2 9 22 2" />
                </svg>
            </button>
        </div>
    </div>
</div>

<style>
    .fab-ring {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        border: 2px solid rgba(255,255,255,0.4);
        animation: pulse-ring 2s ease-out infinite;
    }

    .fab-ring2 {
        animation-delay: 0.8s;
    }

    @@keyframes pulse-ring {
        0% {
            transform: scale(1);
            opacity: 0.6;
        }

        100% {
            transform: scale(1.6);
            opacity: 0;
        }
    }

    .ai-spin {
        animation: ai-rotate 3s linear infinite;
    }

    @@keyframes ai-rotate {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    .chat-msg {
        max-width: 80%;
        padding: 9px 13px;
        border-radius: 12px;
        font-size: 13px;
        line-height: 1.55;
        word-break: break-word;
    }

        .chat-msg.bot {
            background: white;
            color: #333;
            align-self: flex-start;
            border-bottom-left-radius: 3px;
            border: 0.5px solid rgba(0,0,0,0.08);
        }

        .chat-msg.user {
            background: #1a56a0;
            color: white;
            align-self: flex-end;
            border-bottom-right-radius: 3px;
        }

        .chat-msg.typing {
            background: white;
            align-self: flex-start;
            color: #888;
            font-style: italic;
            font-size: 12px;
            border: 0.5px solid rgba(0,0,0,0.08);
        }
</style>

<script>
    let chatOpen = false;
    let historyLoaded = false;

    function toggleChat() {
        chatOpen = !chatOpen;
        const box = document.getElementById("chatBox");
        box.style.display = chatOpen ? "flex" : "none";
        if (chatOpen) {
            if (!historyLoaded) loadHistory();
            document.getElementById("chatInput").focus();
        }
    }

    document.addEventListener("click", function(e) {
        if (!chatOpen) return;
        const widget = document.getElementById("chatWidget");
        if (!widget.contains(e.target)) {
            chatOpen = false;
            document.getElementById("chatBox").style.display = "none";
        }
    });

    function openFullPage() {
        window.location.href = "/Chatbot/Index";
    }

    function newChat() {
        if (!confirm("Bắt đầu đoạn chat mới? Lịch sử hiện tại vẫn được lưu.")) return;

        fetch("/Chatbot/NewSession", { method: "POST" })
            .then(() => {
                const messages = document.getElementById("chatMessages");
                messages.innerHTML = `<div class="chat-msg bot">
                    Xin chào! Tôi là trợ lý tư vấn đồng hồ LGWATCH. Bạn cần tôi giúp gì? 😊
                </div>`;
                historyLoaded = true;
            });
    }

    function loadHistory() {
        fetch("/Chatbot/GetHistory")
            .then(res => res.json())
            .then(data => {
                if (data.success && data.data.length > 0) {
                    const messages = document.getElementById("chatMessages");
                    messages.innerHTML = "";
                    data.data.forEach(item => {
                        appendMsg(item.cauHoi, "user");
                        appendMsg(item.cauTraLoi, "bot");
                    });
                    messages.scrollTop = messages.scrollHeight;
                }
                historyLoaded = true;
            })
            .catch(() => { historyLoaded = true; });
    }

    function sendChat() {
        const input = document.getElementById("chatInput");
        const msg = input.value.trim();
        if (!msg) return;

        appendMsg(msg, "user");
        input.value = "";
        input.disabled = true;

        const typingId = "typing-" + Date.now();
        appendMsg("Đang soạn trả lời...", "typing", typingId);

        // GỌI ĐẾN ĐÚNG CONTROLLER C# ĐỂ KẾT NỐI SERVER
        fetch("/api/Chatbot/ask", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ message: msg })
        })
        .then(res => res.json())
        .then(data => {
            document.getElementById(typingId)?.remove();

            // Xử lý dữ liệu trả về từ C#
            if (data.reply) {
                appendMsg(data.reply, "bot");
            } else if (data.error) {
                appendMsg("Lỗi: " + data.error, "bot");
            }
        })
        .catch(() => {
            document.getElementById(typingId)?.remove();
            appendMsg("Xin lỗi, có lỗi xảy ra. Vui lòng thử lại!", "bot");
        })
        .finally(() => {
            input.disabled = false;
            input.focus();
        });
    }

    function appendMsg(text, type, id = null) {
        const messages = document.getElementById("chatMessages");
        const div = document.createElement("div");

        // Đã sửa lỗi thiếu khoảng trắng ở đây
        div.className = `chat-msg ${type}`;

        if (type === "bot") {
            // Xóa HTML thừa AI có thể trả về
            let clean = text
                .replace(/<[^>]+>/g, " ")
                .replace(/style="[^"]*"/g, "")
                .replace(/\s{2,}/g, " ")
                .trim();

            // Parse [Xem sản phẩm](url|img)
            clean = clean.replace(
                /\[Xem sản phẩm\]\(([^|)]+)\|?([^)]*)\)/g,
                (match, url, img) => {
                    const imgHtml = img && img.trim()
                        ? `<img src="${img.trim()}" onerror="this.style.display='none'" style="width:100%;height:100%;object-fit:cover;border-radius:8px;" />`
                        : `<div style="font-size:22px;text-align:center;line-height:48px;">🕐</div>`;

                    return `<a href="${url}" style="display:flex;align-items:center;gap:10px;
                        background:#f0f4ff;border:1px solid #d0e0ff;border-radius:10px;
                        padding:8px 12px;text-decoration:none;margin:6px 0;cursor:pointer;">
                        <div style="width:48px;height:48px;border-radius:8px;overflow:hidden;flex-shrink:0;background:#e8eef8;">
                            ${imgHtml}
                        </div>
                        <div>
                            <div style="font-size:12px;font-weight:600;color:#1a56a0;">Xem sản phẩm</div>
                            <div style="font-size:11px;color:#888;">Nhấn để xem chi tiết →</div>
                        </div>
                    </a>`;
                }
            );
            div.innerHTML = clean.replace(/\n/g, "<br>");
        } else {
            div.textContent = text;
        }

        if (id) div.id = id;
        messages.appendChild(div);
        messages.scrollTop = messages.scrollHeight;
    }
</script>