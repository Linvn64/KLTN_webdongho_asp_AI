@using Microsoft.AspNetCore.Identity
@using WebDongHoLG.Data

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject ShopDongHoDbContext Context

@if (SignInManager.IsSignedIn(User))
{
    var userId = UserManager.GetUserId(User);
    var userProfile = Context.NguoiDungs.FirstOrDefault(u => u.UserId == userId);
    var displayName = userProfile != null ? userProfile.HoTen : UserManager.GetUserName(User);
    var anhDaiDien = userProfile?.AnhDaiDien;

    @if (User.IsInRole("Admin") || User.IsInRole("NhanVien"))
    {
        <a class="dropdown-item fw-bold text-danger py-2" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
            <i class="fas fa-user-shield me-2"></i>Trang quản trị
        </a>
        <div class="dropdown-divider"></div>
    }

    <a class="dropdown-item py-2" asp-area="Identity" asp-page="/Account/Manage/Index">
        <i class="fas fa-user-circle me-2 text-primary"></i>
        Chào, <strong>@displayName</strong>
    </a>


    <a class="dropdown-item py-2" asp-controller="DonHangKhach" asp-action="Index">
        <i class="fas fa-history me-2 text-info"></i>Đơn hàng của tôi
    </a>


    <div class="dropdown-divider"></div>

    <form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout"
          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
        <button type="submit" class="dropdown-item py-2 text-danger">
            <i class="fas fa-sign-out-alt me-2"></i>Đăng xuất
        </button>
    </form>
}
else
{
    <a class="dropdown-item py-2" asp-area="Identity" asp-page="/Account/Register">
        <i class="fas fa-user-plus me-2 text-success"></i>Đăng ký
    </a>
    <div class="dropdown-divider"></div>
    <a class="dropdown-item py-2" asp-area="Identity" asp-page="/Account/Login">
        <i class="fas fa-sign-in-alt me-2 text-primary"></i>Đăng nhập
    </a>
}