@model IEnumerable<WebDongHoLG.ViewModels.GioHangVM>
@{
    ViewData["Title"] = "Giỏ hàng";
}

@* <div class="container-fluid page-header py-5" style="background: var(--lg-primary);">
    <h1 class="text-center text-white display-6">Giỏ hàng</h1>
</div> *@

<div class="container-fluid py-5 mt-5">
    <div class="container py-5">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" style="background-color: #e8f5ee; border-color: #5a8a6a; color: #1e4b30;">
                <i class="fa fa-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" style="background-color: #fde8e8; border-color: #7a3030; color: #5a1010;">
                <i class="fa fa-times-circle me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="text-center py-5 summary-box">
                <i class="fa fa-shopping-cart fa-4x mb-3 d-block" style="color: var(--lg-border);"></i>
                <h4 style="color: var(--lg-primary);">Giỏ hàng trống</h4>
                <a asp-controller="SanPhams" asp-action="Index" class="btn-detail rounded-pill px-5 mt-3 d-inline-block text-decoration-none fw-bold">
                    Tiếp tục mua sắm
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive summary-box p-3 mb-4">
                <table class="table table-cart mb-0">
                    <thead>
                        <tr>
                            <th><input type="checkbox" id="checkAll"></th>
                            <th style="width:90px;">Ảnh</th>
                            <th>Sản phẩm</th>
                            <th class="text-center">Đơn giá</th>
                            <th class="text-center">Số lượng</th>
                            <th class="text-end">Thành tiền</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <input type="checkbox" class="item-check"
                                           value="@item.MaBienThe" data-gia="@item.DonGia"
                                           data-soluong="@item.SoLuong" data-tonkho="@item.SoLuongTon"
                                           @(item.SoLuongTon <= 0 ? "disabled" : "")>
                                </td>
                                <td>
                                    <a asp-controller="SanPhams" asp-action="Detail" asp-route-id="@item.MaSpGoc">
                                        <img src="@(item.Hinh ?? "/home/img/no-image.jpg")" class="cart-img" alt="@item.TenSp">
                                    </a>
                                </td>
                                <td>
                                    <p class="fw-bold mb-1" style="color: var(--luxury-dark);">@item.TenSp</p>
                                    @if (!string.IsNullOrEmpty(item.TenThuongHieu))
                                    {
                                        <small style="color: var(--bs-secondary); text-transform: uppercase; font-weight: 600;">@item.TenThuongHieu</small>
                                    }

                                    <div class="mt-2">
                                        <button type="button" onclick="moModalDoiBienTheGH(@item.MaBienThe, @item.MaSpGoc, @item.SoLuong)" class="btn-change-variant d-inline-flex align-items-center gap-1">
                                            @if (!string.IsNullOrEmpty(item.MauSac))
                                            {
                                                <span>@item.MauSac</span>
                                            }
                                            @if (item.DuongKinhMat.HasValue)
                                            {
                                                <span>| @item.DuongKinhMat mm</span>
                                            }
                                            @if (!string.IsNullOrEmpty(item.ChatLieuDay))
                                            {
                                                <span>| @item.ChatLieuDay</span>
                                            }
                                            <i class="fa fa-chevron-down ms-1" style="font-size:10px;"></i>
                                        </button>
                                    </div>

                                    @if (item.SoLuongTon <= 5 && item.SoLuongTon > 0)
                                    {
                                        <small class="d-block mt-2 fw-bold" style="color: var(--luxury-gold);">Còn @item.SoLuongTon sản phẩm</small>
                                    }
                                    @if (item.SoLuongTon == 0)
                                    {
                                        <small class="text-danger fw-bold d-block mt-2">Hết hàng</small>
                                    }
                                </td>
                                <td class="text-center fw-bold" style="color: var(--luxury-dark);">
                                    @item.DonGia.ToString("#,##0") ₫
                                </td>
                                <td class="text-center">
                                    <div class="qty-wrap" style="margin:auto; width:fit-content;">
                                        <button type="button" class="qty-btn btn-minus" data-id="@item.MaBienThe" data-max="@item.SoLuongTon"><i class="fa fa-minus"></i></button>
                                        <input type="text" class="qty-input" value="@item.SoLuong" data-id="@item.MaBienThe" data-max="@item.SoLuongTon" data-gia="@item.DonGia">
                                        <button type="button" class="qty-btn btn-plus" data-id="@item.MaBienThe" data-max="@item.SoLuongTon"><i class="fa fa-plus"></i></button>
                                    </div>
                                </td>
                                <td class="text-end fw-bold" id="thanhTien-@item.MaBienThe" style="color: var(--lg-primary); font-size: 1.1rem;">
                                    @item.ThanhTien.ToString("#,##0") ₫
                                </td>
                                <td class="text-center">
                                    <a asp-action="RemoveCart" asp-route-id="@item.MaBienThe"
                                       style="color: #b8a898; transition: color 0.2s ease;" title="Xóa"
                                       onmouseover="this.style.color='#7a3030'" onmouseout="this.style.color='#b8a898'"
                                       onclick="return confirm('Xóa sản phẩm này khỏi giỏ hàng?')">
                                        <i class="fa fa-trash fa-lg"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="row justify-content-end mt-4">
                <div class="col-lg-4">
                    <div class="summary-box p-4">
                        <h5 class="fw-bold mb-3" style="color: var(--luxury-dark); border-bottom: 2px solid var(--lg-border); padding-bottom: 10px;">Tóm tắt đơn hàng</h5>
                        <div class="d-flex justify-content-between mb-3">
                            <span style="color: var(--bs-secondary);">Đã chọn:</span>
                            <span class="fw-bold" style="color: var(--luxury-dark);"><span id="selectedCount">0</span> sản phẩm</span>
                        </div>
                        <div class="d-flex justify-content-between mb-4 pt-2">
                            <h5 class="fw-bold" style="color: var(--luxury-dark);">Tổng thanh toán:</h5>
                            <h4 class="fw-bold m-0" style="color: var(--lg-primary);"><span id="totalPrice">0</span> ₫</h4>
                        </div>

                        <button type="button" id="btnMuaHang" onclick="proceedToCheckout()" class="btn-add w-100 py-3 fw-bold fs-6" disabled>
                            Mua hàng (<span id="btnCount">0</span>)
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="modalChonBienTheGH" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 8px;">
            <div class="modal-header border-0 pb-0">
                <div>
                    <h5 class="fw-bold mb-0" id="modalTenSpGH" style="color: var(--luxury-dark);">Đang tải...</h5>
                    <small style="color: var(--bs-secondary); text-transform: uppercase; font-weight: 600;" id="modalThuongHieuGH"></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-3">
                <div class="mb-3 text-center">
                    <img id="modalAnhBienTheGH" src="/home/img/no-image.jpg" style="width:140px; height:140px; object-fit:cover; border-radius:6px; border: 1px solid var(--lg-border); background: var(--lg-bg);">
                </div>
                <div class="rounded p-3 mb-4 text-center" style="background-color: var(--lg-bg); border: 1px solid var(--lg-border);">
                    <h3 class="fw-bold mb-0" id="modalGiaGH" style="color: var(--lg-primary);">--</h3>
                </div>

                <div id="modalBienTheListGH" class="d-flex flex-wrap gap-2 mb-4"></div>

                <div id="modalHetHangGH" class="text-danger text-center fw-bold d-none mb-3">
                    <i class="fa fa-times-circle me-1"></i>Biến thể này đã hết hàng
                </div>

                <div class="d-flex align-items-center gap-3 mb-2 p-3 rounded" style="background-color: var(--lg-bg); border: 1px dashed var(--lg-border);">
                    <span class="fw-bold" style="color: var(--luxury-dark);">Số lượng:</span>
                    <div class="qty-wrap">
                        <button type="button" id="modalBtnMinusGH" class="qty-btn"><i class="fa fa-minus"></i></button>
                        <input type="text" id="modalSoLuongGH" class="qty-input" value="1">
                        <button type="button" id="modalBtnPlusGH" class="qty-btn"><i class="fa fa-plus"></i></button>
                    </div>
                    <small class="fw-bold" style="color: var(--luxury-gold);" id="modalTonKhoGH"></small>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0 pb-4 px-4">
                <button type="button" id="modalBtnXacNhanGH" class="btn-add w-100 py-3 fw-bold fs-6" onclick="xacNhanDoiBienTheGH()">
                    Xác nhận đổi
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/nguoidung/giohang.js" asp-append-version="true"></script>
}