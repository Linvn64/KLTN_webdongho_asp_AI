@model WebDongHoLG.Data.Voucher

@{
    ViewData["Title"] = "Xác nhận trạng thái";
    bool isActive = Model.IsActive ?? false;
}

<div class="page-header d-print-none mb-3">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title @(isActive ? "text-danger" : "text-success")">
                <i class="ti @(isActive ? "ti-power" : "ti-circle-check") me-2"></i>
                @(isActive ? "Vô hiệu hóa Voucher" : "Kích hoạt lại Voucher")
            </h2>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-status-top @(isActive ? "bg-danger" : "bg-success")"></div>

            <div class="card-body py-4 text-center">
                <div class="mb-3">
                    <span class="avatar avatar-xl rounded @(isActive ? "bg-danger-lt" : "bg-success-lt")">
                        <i class="ti @(isActive ? "ti-alert-triangle" : "ti-info-circle")" style="font-size: 2rem;"></i>
                    </span>
                </div>

                <h3>Bạn có chắc chắn muốn @(isActive ? "DỪNG" : "BẬT LẠI") mã này?</h3>
                <p class="text-muted small">
                    @(isActive
                                        ? "Sau khi dừng, khách hàng sẽ không thể áp dụng mã này khi thanh toán."
                                        : "Mã này sẽ hoạt động trở lại nếu vẫn còn trong thời hạn cho phép.")
                </p>

                <div class="list-group list-group-flush border-top border-bottom mb-4 mt-3">
                    <div class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Mã Voucher:</span>
                        <strong class="text-uppercase text-primary">@Model.TenVoucher</strong>
                    </div>
                    <div class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Mức giảm:</span>
                        <strong class="text-danger">@((Model.PhanTramGiam * 100).ToString("N0"))%</strong>
                    </div>
                    <div class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Hiệu lực:</span>
                        <span class="small">@Model.NgayBatDau.ToString("dd/MM/yyyy") - @Model.NgayKetThuc.ToString("dd/MM/yyyy")</span>
                    </div>
                </div>

                <form asp-action="ToggleStatus" method="post">
                    <input type="hidden" asp-for="MaVoucher" />
                    <div class="d-flex gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary w-100 fw-bold">
                            Hủy bỏ
                        </a>
                        <button type="submit" class="btn @(isActive ? "btn-danger" : "btn-success") w-100 fw-bold shadow-sm">
                            <i class="ti @(isActive ? "ti-power" : "ti-circle-check") me-1"></i>
                            Xác nhận @(isActive ? "Dừng mã" : "Kích hoạt")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>