@model IEnumerable<WebDongHoLG.Data.Voucher>
@{
    ViewData["Title"] = "Quản lý Mã giảm giá";
}

<div class="page-header d-print-none mb-3">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title text-primary">
                <i class="ti ti-ticket me-2"></i>Quản lý Voucher
            </h2>
            <div class="text-secondary mt-1">Danh sách các chương trình khuyến mãi hiện có</div>
        </div>
        <div class="col-auto ms-auto">
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="ti ti-plus me-2"></i> Thêm mã mới
            </a>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-12">
        <div class="card card-sm bg-primary-lt border-primary shadow-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <span class="bg-primary text-white avatar avatar-lg">
                            <i class="ti ti-report-money" style="font-size: 24px;"></i>
                        </span>
                    </div>
                    <div class="col">
                        <div class="font-weight-medium text-uppercase text-muted mb-1" style="letter-spacing: 0.05em;">
                            Tổng ngân sách đã tiêu cho khuyến mãi
                        </div>
                        <div class="h1 mb-0 fw-bold text-primary">
                            @String.Format("{0:#,##0}", ViewBag.TongNganSachVoucher ?? 0)₫
                        </div>
                    </div>
                    <div class="col-auto text-end text-muted">
                        <small>Dựa trên tất cả đơn hàng đã phát sinh</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3 shadow-sm border-0">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-bold">Tìm mã Voucher</label>
                <input type="text" name="searchName" class="form-control" placeholder="Nhập tên mã..." value="@ViewBag.SearchName">
            </div>

            <div class="col-md-2">
                <label class="form-label fw-bold">Trạng thái</label>
                <select name="status" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="active" selected="@(ViewBag.CurrentStatus == "active")">Đang chạy</option>
                    <option value="inactive" selected="@(ViewBag.CurrentStatus == "inactive")">Ngừng hoạt động</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-bold">Từ ngày</label>
                <input type="date" name="tuNgay" class="form-control" value="@ViewBag.TuNgay">
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">Đến ngày</label>
                <input type="date" name="denNgay" class="form-control" value="@ViewBag.DenNgay">
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="ti ti-filter me-1"></i> Áp dụng bộ lọc
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary w-50">Làm mới</a>
            </div>
        </form>
    </div>
</div>


@* SỬA LẠI DÒNG ID DƯỚI ĐÂY CHO ĐÚNG *@
<div class="card shadow-sm border-0" id="js-list">
    <div class="table-responsive">
        <table class="table table-vcenter table-hover card-table">
            <thead>
                <tr>
                    <th><button class="table-sort sort" data-sort="sort-name">Mã Voucher</button></th>
                    <th class="text-center"><button class="table-sort sort" data-sort="sort-percent">Mức giảm</button></th>
                    <th class="text-center"><button class="table-sort sort" data-sort="sort-min">Đơn tối thiểu</button></th>
                    <th><button class="table-sort sort" data-sort="sort-date">Thời hạn</button></th>
                    <th class="text-center">Sử dụng</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-center">Ngân sách đã dùng</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody class="list">
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        var isExpired = item.NgayKetThuc < DateTime.Now;
                        var isFull = (item.DaDung ?? 0) >= (item.SoLuong ?? 0) && (item.SoLuong > 0);

                        <tr>
                            <td class="sort-name">
                                <div class="fw-bold text-primary text-uppercase">@item.TenVoucher</div>
                                <div class="text-muted small">ID: #@item.MaVoucher</div>
                            </td>

                            <td class="text-center sort-percent" data-value="@(item.PhanTramGiam * 100)">
                                <span class="badge bg-red-lt fw-bold" style="font-size: 13px;">
                                    @((item.PhanTramGiam * 100).ToString("N0"))%
                                </span>
                            </td>

                            <td class="text-center sort-min" data-value="@item.GiaTriToiThieu">
                                <div class="fw-bold text-primary">
                                    @item.GiaTriToiThieu.ToString("N0") <small class="text-muted">đ</small>
                                </div>
                            </td>

                            <td class="sort-date" data-value="@item.NgayKetThuc.ToString("yyyyMMddHHmm")">
                                <div class="small">Từ: @item.NgayBatDau.ToString("dd/MM/yyyy")</div>
                                <div class="small @(isExpired ? "text-danger fw-bold" : "text-muted")">
                                    Đến: @item.NgayKetThuc.ToString("dd/MM/yyyy")
                                </div>
                            </td>

                            <td class="text-center">@item.DaDung / @item.SoLuong</td>

                            <td class="text-center">
                                @if (item.IsActive == true && !isExpired && !isFull)
                                {
                                    <span class="status status-green">
                                        <span class="status-dot status-dot-animated"></span> Đang chạy
                                    </span>
                                }
                                else if (isExpired)
                                {
                                    <span class="status status-red">
                                        <span class="status-dot"></span> Hết hạn
                                    </span>
                                }
                                else if (isFull)
                                {
                                    <span class="status status-orange">
                                        <span class="status-dot"></span> Hết lượt
                                    </span>
                                }
                                else
                                {
                                    <span class="status status-yellow">
                                        <span class="status-dot"></span> Đã tắt
                                    </span>
                                }
                            </td>

                            <td>
                                @{
                                    var thongKe = ViewBag.ThongKeVoucher as Dictionary<int?, decimal>;
                                    decimal tongTien = 0;

                                    if (thongKe != null && thongKe.ContainsKey(item.MaVoucher))
                                    {
                                        tongTien = thongKe[item.MaVoucher];
                                    }
                                }
                                <span class="text-danger fw-bold">
                                    @tongTien.ToString("#,##0")₫
                                </span>
                            </td>

                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    @if (item.DaDung > 0)
                                    {
                                        <a asp-action="Details" asp-route-id="@item.MaVoucher" class="btn btn-icon btn-outline-info" title="Xem chi tiết">
                                            <i class="ti ti-eye"></i>
                                        </a>
                                        <a asp-action="ToggleStatus" asp-route-id="@item.MaVoucher" class="btn btn-icon btn-outline-danger" title="Bật/Tắt">
                                            <i class="ti @(item.IsActive == true ? "ti-power" : "ti-circle-check")"></i>
                                        </a>
                                        <span class="text-muted small mt-1" style="font-size: 11px;">(Đã phát sinh GD)</span>
                                    }
                                    else
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.MaVoucher" class="btn btn-icon btn-outline-warning" title="Sửa">
                                            <i class="ti ti-edit"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.MaVoucher" class="btn btn-icon btn-outline-info" title="Xem chi tiết">
                                            <i class="ti ti-eye"></i>
                                        </a>
                                        <a asp-action="ToggleStatus" asp-route-id="@item.MaVoucher" class="btn btn-icon btn-outline-danger" title="Bật/Tắt">
                                            <i class="ti @(item.IsActive == true ? "ti-power" : "ti-circle-check")"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.MaVoucher" class="btn btn-icon btn-outline-dark" title="Xóa vĩnh viễn">
                                            <i class="ti ti-trash"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>