@model WebDongHoLG.Data.Voucher

@{
    ViewData["Title"] = "Chỉnh sửa Voucher";
}

<div class="page-header d-print-none mb-3">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title text-primary">
                <i class="ti ti-edit me-2"></i>Chỉnh sửa Voucher
            </h2>
            <div class="text-secondary mt-1">Cập nhật thông tin cho mã: <b class="text-uppercase">@Model.TenVoucher</b></div>
        </div>
    </div>
</div>

<div class="row row-cards">
    <div class="col-12">
        <form asp-action="Edit" class="card shadow-sm border-0">
            <div class="card-body">
                <div asp-validation-summary="All" class="alert alert-danger mb-3"></div>

                <input type="hidden" asp-for="MaVoucher" />
                <input type="hidden" asp-for="DaDung" />

                <div class="row">
                    <div class="col-md-6 border-end">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Mã Voucher (Code)</label>
                            <div class="input-icon">
                                <span class="input-icon-addon"><i class="ti ti-tag"></i></span>
                                <input asp-for="TenVoucher" class="form-control fw-bold text-uppercase" />
                            </div>
                            <span asp-validation-for="TenVoucher" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Mức giảm giá</label>
                                    <div class="input-group">
                                        <input asp-for="PhanTramGiam" class="form-control fw-bold text-danger" type="number" />
                                        <span class="input-group-text">%</span>
                                    </div>
                                    <span asp-validation-for="PhanTramGiam" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Giá trị tối thiểu</label>
                                    <div class="input-group input-group-flat">
                                        <input asp-for="GiaTriToiThieu" class="form-control fw-bold text-end" type="number" id="inputTien" />
                                        <span class="input-group-text px-2">₫</span>
                                    </div>
                                    <div id="previewTien" class="form-hint text-primary fw-bold mt-1">@Model.GiaTriToiThieu.ToString("N0") ₫</div>
                                </div>
                            </div>
                        </div>

                        <div class="hr-text text-blue">Quản lý số lượng</div>
                        <div class="row g-3">
                            <div class="col-6">
                                <div class="form-label mb-1 text-muted">Đang có / Đã dùng</div>
                                <div class="h3 fw-bold">@Model.SoLuong / <span class="text-danger">@Model.DaDung</span></div>
                                <input type="hidden" name="SoLuongCu" value="@Model.SoLuong" />
                            </div>
                            <div class="col-6">
                                <div class="mb-3">
                                    <label class="form-label fw-bold text-azure">Số lượng cấp thêm</label>
                                    <div class="input-icon">
                                        <span class="input-icon-addon"><i class="ti ti-plus"></i></span>
                                        <input type="number" name="SoLuongTangThem" class="form-control fw-bold border-azure" value="0" min="0" />
                                    </div>
                                    <small class="text-muted">Nhập số lượng muốn cộng thêm (ví dụ: 10, 20...)</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="mb-3 ps-md-3">
                            <label class="form-label fw-bold">Ngày bắt đầu</label>
                            <input asp-for="NgayBatDau" class="form-control" type="datetime-local" />
                            <span asp-validation-for="NgayBatDau" class="text-danger small"></span>
                        </div>

                        <div class="mb-3 ps-md-3">
                            <label class="form-label fw-bold">Ngày kết thúc</label>
                            <input asp-for="NgayKetThuc" class="form-control" type="datetime-local" />
                            <span asp-validation-for="NgayKetThuc" class="text-danger small"></span>
                        </div>

                        <div class="mb-3 mt-4 ps-md-3">
                            <label class="form-check form-switch p-0">
                                <input class="form-check-input ms-0 me-2" type="checkbox"
                                       id="IsActive" name="IsActive" value="true"
                                       @(Model.IsActive == true ? "checked" : "") />
                                <input type="hidden" name="IsActive" value="false" />
                                <span class="form-check-label fw-bold">Kích hoạt Voucher</span>
                            </label>
                        </div>
                    </div> 
                </div>
            </div>

            <div class="card-footer bg-light d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-link text-secondary fw-bold text-decoration-none">
                    <i class="ti ti-arrow-left me-1"></i> Quay lại
                </a>
                <button type="submit" class="btn btn-warning px-4 shadow-sm fw-bold">
                    <i class="ti ti-device-floppy me-2"></i> Cập nhật thay đổi
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        const inputTien = document.getElementById('inputTien');
        const previewTien = document.getElementById('previewTien');

        inputTien.addEventListener('input', function(e) {
            const value = e.target.value;
            previewTien.innerText = value ? new Intl.NumberFormat('vi-VN').format(value) + ' ₫' : '0 ₫';
        });
    </script>
}