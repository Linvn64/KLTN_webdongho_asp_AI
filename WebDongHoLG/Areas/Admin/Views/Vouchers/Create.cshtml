@model WebDongHoLG.Data.Voucher

@{
    ViewData["Title"] = "Tạo mới Voucher";
}

<div class="page-header d-print-none mb-3">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title text-primary">
                <i class="ti ti-ticket me-2"></i>Thêm mã giảm giá mới
            </h2>
        </div>
    </div>
</div>

<div class="row row-cards">
    <div class="col-12">
        <form asp-action="Create" class="card shadow-sm border-0">
            <div class="card-body">
                <div asp-validation-summary="All" class="alert alert-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-6 border-end">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Mã Voucher (Code)</label>
                            <div class="input-icon">
                                <span class="input-icon-addon"><i class="ti ti-tag"></i></span>
                                <input asp-for="TenVoucher" class="form-control" placeholder="Ví dụ: GIAM20K" />
                            </div>
                            <span asp-validation-for="TenVoucher" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Mức giảm giá</label>
                                    <div class="input-group">
                                        <input asp-for="PhanTramGiam" class="form-control fw-bold text-danger" type="number" min="1" max="100" placeholder="15" />
                                        <span class="input-group-text">%</span>
                                    </div>
                                    <span asp-validation-for="PhanTramGiam" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Giá trị tối thiểu</label>
                                    <div class="input-group input-group-flat">
                                        <input asp-for="GiaTriToiThieu" class="form-control fw-bold text-end" type="number" id="inputTien" placeholder="500000" />
                                        <span class="input-group-text px-2">₫</span>
                                    </div>
                                    <div id="previewTien" class="form-hint text-primary fw-bold mt-1">0 ₫</div>
                                    <span asp-validation-for="GiaTriToiThieu" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Số lượng phát hành</label>
                            <input asp-for="SoLuong" class="form-control" type="number" min="1" placeholder="Số lượt tối đa" />
                            <span asp-validation-for="SoLuong" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Ngày bắt đầu</label>
                            <input asp-for="NgayBatDau" class="form-control" type="datetime-local" />
                            <span asp-validation-for="NgayBatDau" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Ngày kết thúc</label>
                            <input asp-for="NgayKetThuc" class="form-control" type="datetime-local" />
                            <span asp-validation-for="NgayKetThuc" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-check form-switch mt-4">
                                <input class="form-check-input" type="checkbox" name="IsActive" value="true" @(Model?.IsActive == false ? "" : "checked")>
                                <span class="form-check-label fw-bold">Cho phép sử dụng ngay</span>
                                <small class="text-muted d-block mt-1 italic border-top pt-2">
                                    * Hệ thống sẽ tự động chặn nếu trùng mã và thời gian.
                                </small>
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-footer bg-light d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-link text-secondary fw-bold">
                    <i class="ti ti-arrow-left me-1"></i> Quay lại danh sách
                </a>
                <button type="submit" class="btn btn-primary px-4 shadow-sm">
                    <i class="ti ti-device-floppy me-2"></i> Lưu Voucher
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const inputTien = document.getElementById('inputTien');
        const previewTien = document.getElementById('previewTien');

        inputTien.addEventListener('input', function(e) {
            const value = e.target.value;
            if (value) {
                previewTien.innerText = new Intl.NumberFormat('vi-VN').format(value) + ' ₫';
            } else {
                previewTien.innerText = '0 ₫';
            }
        });
    </script>
}