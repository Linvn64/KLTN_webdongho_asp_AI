<div class="modal fade" id="modalDelete" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="ti ti-trash me-2"></i>Xác nhận xóa biến thể</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalDeleteBody">
                <div class="text-center py-3"><div class="spinner-border text-danger"></div></div>
            </div>
            <div class="modal-footer" id="modalDeleteFooter"></div>
        </div>
    </div>
</div>

<form id="formDelete" action="/Admin/BienTheSanPhams/Delete" method="post" style="display:none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteId" />
    <input type="hidden" name="deleteType" id="deleteType" value="soft" />
</form>

<script>
    function confirmDelete(id, sku) {
        const body   = document.getElementById("modalDeleteBody");
        const footer = document.getElementById("modalDeleteFooter");

        body.innerHTML = `<div class="text-center py-3"><div class="spinner-border text-danger"></div></div>`;
        footer.innerHTML = "";
        document.getElementById("deleteId").value = id;
        new bootstrap.Modal(document.getElementById("modalDelete")).show();

        fetch(`/Admin/BienTheSanPhams/CheckBeforeDelete?id=${id}`)
            .then(res => res.json())
            .then(data => {

                // TH1: có lịch sử mua hàng → chỉ cho ẩn
                if (data.coLichSuMuaHang) {
                    body.innerHTML = `
                        <div class="alert alert-warning mb-0">
                            <i class="ti ti-alert-triangle me-2"></i>
                            SKU <b>${sku}</b> đã có trong lịch sử đơn hàng.<br>
                            Chỉ có thể <b>ẩn</b>, không thể xóa vĩnh viễn.
                        </div>`;
                    footer.innerHTML = `
                        <button class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button class="btn btn-warning" onclick="submitDelete('soft')">
                            <i class="ti ti-eye-off me-1"></i> Ẩn vào thùng rác
                        </button>`;
                    return;
                }

                // TH2: có nhập kho hoặc tồn kho
                if (data.coLichSuNhapKho || data.coTonKho) {
                    const msg = data.coLichSuNhapKho
                        ? `SKU <b>${sku}</b> có lịch sử nhập kho.`
                        : `SKU <b>${sku}</b> còn dữ liệu tồn kho.`;
                    body.innerHTML = `
                        <div class="alert alert-info mb-0">
                            <i class="ti ti-package me-2"></i>${msg}<br>
                            Bạn muốn xử lý như thế nào?
                        </div>`;
                    footer.innerHTML = `
                        <button class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button class="btn btn-warning" onclick="submitDelete('soft')">
                            <i class="ti ti-eye-off me-1"></i> Chỉ ẩn
                        </button>
                        <button class="btn btn-danger" onclick="submitDelete('hard')">
                            <i class="ti ti-trash me-1"></i> Xóa luôn cả kho
                        </button>`;
                    return;
                }

                // TH3: không liên quan gì → cho