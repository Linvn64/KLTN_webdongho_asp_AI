@model WebDongHoLG.Data.BienTheSanPham
@{
    ViewData["Title"] = "Thêm biến thể sản phẩm";
}

<div class="page-header mb-3">
    <h2 class="text-primary">
        <i class="ti ti-layers-plus me-2"></i>Thêm biến thể sản phẩm
    </h2>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <form asp-action="Create" method="post" id="createForm">
                <div class="card-body">
                    <div asp-validation-summary="All" class="alert alert-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Sản phẩm chính</label>
                        <select asp-for="MaSp" id="inputProduct" class="form-select" asp-items="ViewBag.MaSp">
                            <option value="">-- Chọn sản phẩm gốc --</option>
                        </select>
                    </div>

                    <div class="hr-text">Thông số kỹ thuật</div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Màu sắc</label>
                            <input asp-for="MauSac" id="inputColor" class="form-control" placeholder="Đen, Bạc..." />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Size (mm)</label>
                            <input asp-for="DuongKinhMat" id="inputSize" type="number" class="form-control" placeholder="40" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Chất liệu dây</label>
                            <input asp-for="ChatLieuDay" id="inputStrap" class="form-control" placeholder="Dây da..." />
                        </div>
                    </div>

                    <div class="hr-text">Giá & Định danh</div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Giá nhập</label>
                            <input type="text" id="giaNhapDisplay" class="form-control money-input" placeholder="0" />
                            <input type="hidden" asp-for="GiaNhap" id="giaNhapRaw" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-success fw-bold">Giá bán (+30%)</label>
                            <input type="text" id="giaBanDisplay" class="form-control text-success fw-bold money-input" placeholder="0" />
                            <input type="hidden" asp-for="GiaBan" id="giaBanRaw" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Mã SKU</label>
                            <input asp-for="MaSku" id="inputSku" class="form-control font-monospace text-uppercase" placeholder="Tự động tạo..." />
                        </div>
                    </div>

                    <div class="hr-text">Hình ảnh</div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Thư mục ảnh (trong hinhanhbienthe)</label>
                        <select name="ImageFolder" id="inputFolder" class="form-select">
                            <option value="">-- Chọn folder ảnh --</option>
                            @if (ViewBag.FolderList != null)
                            {
                                foreach (var f in ViewBag.FolderList)
                                {
                                    <option value="@f">@f</option>
                                }
                            }
                        </select>
                        <small class="text-muted italic">Chọn folder, hệ thống sẽ tự lấy ảnh đầu tiên làm ảnh đại diện.</small>
                    </div>
                </div>

                <div class="card-footer text-end bg-light">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="ti ti-check me-1"></i>Hoàn tất thêm
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="col-md-4">
        <div class="sticky-top" style="top: 20px;">
            <div class="card shadow-lg border-primary">
                <div class="card-status-top bg-primary"></div>
                <div class="card-body">
                    <h3 class="card-title text-primary"><i class="ti ti-eye me-2"></i>Xem trước biến thể</h3>

                    <div class="mb-3 border-bottom pb-2">
                        <small class="text-muted text-uppercase fw-bold">Đường dẫn folder:</small>
                        <div id="previewFolder" class="text-primary small font-monospace mt-1">---</div>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted text-uppercase fw-bold">Mã SKU dự kiến:</small>
                        <div id="previewSku" class="h4 font-monospace text-blue fw-bold mt-1">---</div>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted text-uppercase fw-bold">Giá bán hiển thị:</small>
                        <div id="previewPrice" class="h2 fw-bold text-success mt-1">0 ₫</div>
                    </div>

                    <div>
                        <small class="text-muted d-block mb-2 fw-bold uppercase">Ảnh trong thư mục:</small>
                        <div id="previewImages" class="d-flex flex-wrap gap-2">
                            <div class="text-muted small italic">Chưa chọn thư mục...</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Định dạng tiền
            const formatVN = (val) => new Intl.NumberFormat('vi-VN').format(val);
            const cleanNum = (str) => str.replace(/\D/g, '');

            const el = {
                giaNhapDisp: document.getElementById("giaNhapDisplay"),
                giaNhapRaw: document.getElementById("giaNhapRaw"),
                giaBanDisp: document.getElementById("giaBanDisplay"),
                giaBanRaw: document.getElementById("giaBanRaw"),
                product: document.getElementById("inputProduct"),
                color: document.getElementById("inputColor"),
                size: document.getElementById("inputSize"),
                strap: document.getElementById("inputStrap"),
                sku: document.getElementById("inputSku"),
                folder: document.getElementById("inputFolder"),
                previewPrice: document.getElementById("previewPrice"),
                previewSku: document.getElementById("previewSku"),
                previewFolder: document.getElementById("previewFolder"),
                previewImages: document.getElementById("previewImages")
            };

            // 1. Xử lý giá
            el.giaNhapDisp.addEventListener("input", function() {
                let val = cleanNum(this.value);
                this.value = val ? formatVN(val) : "";
                el.giaNhapRaw.value = val;

                if(val) {
                    let autoGiaBan = Math.round(val * 1.3);
                    el.giaBanRaw.value = autoGiaBan;
                    el.giaBanDisp.value = formatVN(autoGiaBan);
                    el.previewPrice.innerText = formatVN(autoGiaBan) + " ₫";
                }
            });

            el.giaBanDisp.addEventListener("input", function() {
                let val = cleanNum(this.value);
                this.value = val ? formatVN(val) : "";
                el.giaBanRaw.value = val;
                el.previewPrice.innerText = (this.value || "0") + " ₫";
            });

            // 2. Tự động SKU
            const updateSku = () => {
                let pId = el.product.value || "SP";
                let color = el.color.value.trim().toUpperCase() || "MAU";
                let size = el.size.value || "SIZE";
                let autoSku = `${pId}-${color}-${size}`;
                el.sku.value = autoSku;
                el.previewSku.innerText = autoSku;
            };
            ["inputProduct", "inputColor", "inputSize"].forEach(id => {
                document.getElementById(id).addEventListener("input", updateSku);
                document.getElementById(id).addEventListener("change", updateSku);
            });

            // 3. Xử lý ảnh thật từ folder
            el.folder.addEventListener("change", function() {
                const folderName = this.value;
                el.previewFolder.innerText = folderName ? `/hinhanhbienthe/${folderName}/` : "---";

                if (!folderName) {
                    el.previewImages.innerHTML = "Chưa chọn thư mục...";
                    return;
                }

                el.previewImages.innerHTML = '<div class="spinner-border spinner-border-sm text-primary"></div>';

                // Gọi API lấy danh sách file thật
                fetch(`/Admin/BienTheSanPhams/GetImagesInFolder?folderName=${folderName}`)
                    .then(res => res.json())
                    .then(files => {
                        el.previewImages.innerHTML = "";
                        if (files.length === 0) {
                            el.previewImages.innerHTML = '<small class="text-danger">Thư mục không có ảnh!</small>';
                        } else {
                            files.forEach(file => {
                                el.previewImages.innerHTML += `
                                    <div class="avatar avatar-lg shadow-sm border"
                                         style="background-image: url(/hinhanhbienthe/${folderName}/${file}); width: 60px; height: 60px;">
                                    </div>`;
                            });
                        }
                    })
                    .catch(() => {
                        el.previewImages.innerHTML = '<small class="text-danger">Lỗi nạp ảnh!</small>';
                    });
            });
        });
    </script>
}