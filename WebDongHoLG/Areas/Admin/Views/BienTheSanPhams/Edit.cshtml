@model WebDongHoLG.Data.BienTheSanPham

@{
    ViewData["Title"] = "Chỉnh sửa biến thể";
}

<div class="page-header mb-3">
    <h2 class="text-primary">
        <i class="ti ti-edit me-2"></i>Chỉnh sửa biến thể
    </h2>
    <div class="text-secondary mt-1">Cập nhật chi tiết cho SKU: <b class="font-monospace">@Model.MaSku</b></div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <form asp-action="Edit" method="post" id="editForm">
                <div class="card-body">
                    <div asp-validation-summary="All" class="alert alert-danger mb-3"></div>

                    @* Các trường ẩn bắt buộc *@
                    <input type="hidden" asp-for="MaBienThe" />
                    <input type="hidden" asp-for="ImageUrl" id="hiddenImageUrl" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Sản phẩm chính</label>
                        <select asp-for="MaSp" id="inputProduct" class="form-select" asp-items="ViewBag.MaSp"></select>
                    </div>

                    <div class="hr-text">Thông số kỹ thuật</div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Màu sắc</label>
                            <input asp-for="MauSac" id="inputColor" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Size (mm)</label>
                            <input asp-for="DuongKinhMat" id="inputSize" type="number" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Chất liệu dây</label>
                            <input asp-for="ChatLieuDay" id="inputStrap" class="form-control" />
                        </div>
                    </div>

                    <div class="hr-text">Giá & Định danh</div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Giá nhập</label>
                            <input type="text" id="giaNhapDisplay" class="form-control money-input" value="@(Model.GiaNhap?.ToString("N0"))" />
                            <input type="hidden" asp-for="GiaNhap" id="giaNhapRaw" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-success fw-bold">Giá bán</label>
                            <input type="text" id="giaBanDisplay" class="form-control text-success fw-bold money-input" value="@(Model.GiaBan?.ToString("N0"))" />
                            <input type="hidden" asp-for="GiaBan" id="giaBanRaw" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Mã SKU</label>
                            <input asp-for="MaSku" id="inputSku" class="form-control font-monospace text-uppercase" />
                        </div>
                    </div>

                    <div class="hr-text">Hình ảnh & Trạng thái</div>
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-bold">Thư mục ảnh (chọn để đổi mới)</label>
                            <select name="ImageFolder" id="inputFolder" class="form-select">
                                <option value="">-- Giữ nguyên thư mục cũ --</option>
                                @if (ViewBag.FolderList != null)
                                {
                                    foreach (var f in ViewBag.FolderList)
                                    {
                                        <option value="@f" selected="@(Model.ImageUrl?.Contains("/" + f + "/") == true ? "selected" : null)">@f</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Trạng thái</label>
                            <label class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" name="IsActive" value="true" @(Model.IsActive == true ? "checked" : "")>
                                <input type="hidden" name="IsActive" value="false" />
                                <span class="form-check-label">Đang kinh doanh</span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="card-footer text-end bg-light">
                    <a asp-action="Index" class="btn btn-ghost-secondary me-2">Hủy</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="ti ti-device-floppy me-1"></i>Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="col-md-4">
        <div class="sticky-top" style="top: 20px;">
            <div class="card shadow-lg border-primary">
                <div class="card-status-top bg-primary"></div>
                <div class="card-body">
                    <h3 class="card-title text-primary"><i class="ti ti-eye me-2"></i>Xem trước cập nhật</h3>

                    <div class="mb-3 border-bottom pb-2">
                        <small class="text-muted text-uppercase fw-bold">Đường dẫn ảnh hiện tại:</small>
                        <div id="previewFolder" class="text-primary small font-monospace mt-1 text-truncate">@Model.ImageUrl</div>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted text-uppercase fw-bold">Mã SKU:</small>
                        <div id="previewSku" class="h4 font-monospace text-blue fw-bold mt-1">@Model.MaSku</div>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted text-uppercase fw-bold">Giá bán hiển thị:</small>
                        <div id="previewPrice" class="h2 fw-bold text-success mt-1">@(Model.GiaBan?.ToString("N0")) ₫</div>
                    </div>

                    <div>
                        <small class="text-muted d-block mb-2 fw-bold uppercase">Ảnh trong thư mục:</small>
                        <div id="previewImages" class="d-flex flex-wrap gap-2">
                            @* JS sẽ tự nạp ảnh vào đây qua hàm fetch tương tự Create *@
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const formatVN = (val) => new Intl.NumberFormat('vi-VN').format(val);
            const cleanNum = (str) => String(str).replace(/\D/g, '');

            const el = {
                giaNhapDisp: document.getElementById("giaNhapDisplay"),
                giaNhapRaw: document.getElementById("giaNhapRaw"),
                giaBanDisp: document.getElementById("giaBanDisplay"),
                giaBanRaw: document.getElementById("giaBanRaw"),
                product: document.getElementById("inputProduct"),
                color: document.getElementById("inputColor"),
                size: document.getElementById("inputSize"),
                sku: document.getElementById("inputSku"),
                folder: document.getElementById("inputFolder"),
                previewPrice: document.getElementById("previewPrice"),
                previewSku: document.getElementById("previewSku"),
                previewFolder: document.getElementById("previewFolder"),
                previewImages: document.getElementById("previewImages")
            };

            // Đồng bộ giá trị khởi tạo cho hidden fields
            el.giaNhapRaw.value = cleanNum(el.giaNhapDisp.value);
            el.giaBanRaw.value = cleanNum(el.giaBanDisp.value);

            // 1. Xử lý giá (Edit không tự nhảy +30% trừ khi người dùng xóa trắng nhập lại)
            el.giaNhapDisp.addEventListener("input", function() {
                let val = cleanNum(this.value);
                this.value = val ? formatVN(val) : "";
                el.giaNhapRaw.value = val;
            });

            el.giaBanDisp.addEventListener("input", function() {
                let val = cleanNum(this.value);
                this.value = val ? formatVN(val) : "";
                el.giaBanRaw.value = val;
                el.previewPrice.innerText = (this.value || "0") + " ₫";
            });

                   // 2. Cập nhật Preview SKU
        const updateSku = () => {
            let pId = el.product.value || "SP";
            let color = el.color.value.trim().toUpperCase() || "MAU";
            let size = el.size.value || "SIZE";

            // Tạo mã SKU theo quy tắc: MaSp-MauSac-Size
            let autoSku = `${pId}-${color}-${size}`;

            el.sku.value = autoSku; // Cập nhật vào ô input SKU
            el.previewSku.innerText = autoSku; // Cập nhật vào bảng Preview bên phải
        };

        // Lắng nghe tất cả các ô input có thể làm thay đổi SKU
        ["inputProduct", "inputColor", "inputSize"].forEach(id => {
            let target = document.getElementById(id);
            if(target) {
                target.addEventListener("change", updateSku);
                target.addEventListener("input", updateSku);
            }
        });

            // 3. Hàm quét ảnh thật từ Server (Dùng chung logic với Create)
            const fetchFolderImages = (folderName) => {
                if (!folderName) {
                    el.previewImages.innerHTML = '<div class="text-muted small italic">Chưa chọn thư mục...</div>';
                    return;
                }

                el.previewImages.innerHTML = '<div class="spinner-border spinner-border-sm text-primary"></div>';

                fetch(`/Admin/BienTheSanPhams/GetImagesInFolder?folderName=${folderName}`)
                    .then(res => res.json())
                    .then(files => {
                        el.previewImages.innerHTML = "";
                        if (files.length === 0) {
                            el.previewImages.innerHTML = '<small class="text-danger">Thư mục trống!</small>';
                        } else {
                            files.forEach(file => {
                                el.previewImages.innerHTML += `
                                    <div class="avatar avatar-lg shadow-sm border"
                                         style="background-image: url(/hinhanhbienthe/${folderName}/${file}); width: 60px; height: 60px;">
                                    </div>`;
                            });
                        }
                    });
            };

            // Chạy preview ảnh ngay khi load trang Edit dựa trên folder hiện tại
            if (el.folder.value) {
                fetchFolderImages(el.folder.value);
            }

            // Lắng nghe thay đổi folder
            el.folder.addEventListener("change", function() {
                el.previewFolder.innerText = this.value ? `/hinhanhbienthe/${this.value}/` : "---";
                fetchFolderImages(this.value);
            });
        });
    </script>
}