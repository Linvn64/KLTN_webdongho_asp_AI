@model WebDongHoLG.Data.Faq

@{
    ViewData["Title"] = "Chi tiết FAQ";
}

<div class="page-header d-print-none mb-3">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title text-body">
                <i class="ti ti-file-info me-2 text-info"></i>@ViewData["Title"]
            </h2>
            <div class="text-secondary mt-1 small">Xem nội dung đầy đủ và thông số quản lý của câu hỏi này.</div>
        </div>
        <div class="col-auto ms-auto">
            <div class="btn-list">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="ti ti-arrow-left me-2"></i> Quay lại
                </a>
                <a asp-action="Edit" asp-route-id="@Model?.IdFaq" class="btn btn-primary shadow-sm">
                    <i class="ti ti-edit me-2"></i> Chỉnh sửa ngay
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row row-cards">
    <!-- Cột nội dung chính -->
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary-lt">
                <h3 class="card-title text-primary fw-bold">Nội dung câu hỏi & Trả lời</h3>
            </div>
            <div class="card-body">
                <div class="mb-4">
                    <label class="form-label text-secondary fw-medium small text-uppercase">Câu hỏi:</label>
                    <div class="h2 mb-0 text-body fw-bold">@Model.CauHoi</div>
                </div>

                <hr class="my-4 opacity-50" />

                <div>
                    <label class="form-label text-secondary fw-medium small text-uppercase mb-3">Câu trả lời chi tiết:</label>
                    @* Khối hiển thị nội dung Rich Text từ Summernote *@
                    <div class="faq-details-content p-4 rounded-3 border-start border-blue border-3 bg-body-tertiary">
                        @if (!string.IsNullOrEmpty(Model.CauTraLoi))
                        {
                            @Html.Raw(Model.CauTraLoi)
                        }
                        else
                        {
                            <span class="text-muted italic">Chưa có nội dung câu trả lời.</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Cột thông tin hệ thống -->
    <div class="col-md-4">
        <div class="card shadow-sm border-0">
            <div class="card-header border-0 pb-0">
                <h3 class="card-title text-secondary">Thông tin quản lý</h3>
            </div>
            <div class="card-body pt-3">
                <div class="mb-3">
                    <div class="form-label text-secondary small">Mã định danh (ID):</div>
                    <div class="fw-bold text-body">#@Model.IdFaq</div>
                </div>

                <div class="mb-3">
                    <div class="form-label text-secondary small">Trạng thái hiện tại:</div>
                    @if (Model.TrangThai == "Hoạt động")
                    {
                        <span class="status status-green">
                            <span class="status-dot status-dot-animated"></span> Hoạt động
                        </span>
                    }
                    else if (Model.TrangThai == "Bản nháp")
                    {
                        <span class="status status-warning">
                            <span class="status-dot"></span> Bản nháp
                        </span>
                    }
                    else
                    {
                        <span class="status status-red">
                            <span class="status-dot"></span> Lưu trữ
                        </span>
                    }
                </div>

                <div class="mt-4 pt-3 border-top text-secondary small italic">
                    <i class="ti ti-info-circle me-1 text-info"></i>
                    Dữ liệu này được hiển thị công khai trên website nếu ở trạng thái <b>Hoạt động</b>.
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0 pb-4">
                <a asp-action="Delete" asp-route-id="@Model.IdFaq" class="btn btn-ghost-danger w-100">
                    <i class="ti ti-trash me-2"></i> Xóa câu hỏi này
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    /* Tối ưu hiển thị Rich Text (ảnh, màu chữ) trong cả Light và Dark Mode */
    .faq-details-content {
        line-height: 1.8;
        word-wrap: break-word;
        color: var(--tblr-body-color);
    }

        /* Ép nội dung từ editor không bị sai màu trong Dark Mode */
        .faq-details-content * {
            color: inherit !important;
            background-color: transparent !important;
        }

        /* Định dạng hình ảnh trong bài viết */
        .faq-details-content img {
            max-width: 100%;
            height: auto;
            border-radius: 8px;
            margin: 1.5rem 0;
            box-shadow: var(--tblr-shadow-sm);
            display: block;
        }

        /* Tùy chỉnh danh sách nếu có */
        .faq-details-content ul, .faq-details-content ol {
            padding-left: 1.5rem;
            margin-bottom: 1rem;
        }

    /* Hiệu ứng khi ở giao diện tối */
    [data-bs-theme="dark"] .faq-details-content {
        background-color: rgba(255, 255, 255, 0.02) !important;
        border-color: rgba(255, 255, 255, 0.1) !important;
    }
</style>