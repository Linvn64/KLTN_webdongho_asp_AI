@model WebDongHoLG.Data.Faq

@{
    ViewData["Title"] = "Xóa câu hỏi thường gặp";
}

<div class="page-header d-print-none mb-3">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title text-danger">
                <i class="ti ti-alert-octagon me-2"></i>Xác nhận xóa câu hỏi thường gặp
            </h2>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-danger shadow-sm border-0 border-top border-3">
            <div class="card-status-top bg-danger"></div>
            <div class="card-body text-center py-4">
                <div class="mb-3 text-danger">
                    <i class="ti ti-trash-x" style="font-size: 4rem;"></i>
                </div>

                <h3 class="h2 text-body">Bạn có chắc chắn muốn xóa?</h3>
                <p class="text-secondary px-md-5">
                    Hành động này sẽ xóa vĩnh viễn câu hỏi:
                    <strong class="text-danger bg-red-lt px-2 py-1 rounded">@Model.CauHoi</strong>
                    khỏi hệ thống và không thể hoàn tác.
                </p>

                <div class="hr-text text-danger fw-bold">Thông tin chi tiết câu hỏi</div>

                @* Sử dụng bg-body-tertiary để nhìn rõ trong cả Light và Dark mode *@
                <div class="datagrid text-start my-4 p-4 rounded-3 border bg-body-tertiary shadow-none">
                    <div class="datagrid-item">
                        <div class="datagrid-title fw-bold text-secondary text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Mã định danh (ID)</div>
                        <div class="datagrid-content text-body fw-bold" style="font-size: 1rem;">#@Model.IdFaq</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title fw-bold text-secondary text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Tiêu đề câu hỏi</div>
                        <div class="datagrid-content text-body fw-bold">@Model.CauHoi</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title fw-bold text-secondary text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Trạng thái hiện tại</div>
                        <div class="datagrid-content">
                            @if (Model.TrangThai == "Hoạt động")
                            {
                                <span class="badge bg-green text-white shadow-sm border-0">Hoạt động</span>
                            }
                            else if (Model.TrangThai == "Bản nháp")
                            {
                                <span class="badge bg-warning text-white shadow-sm border-0">Bản nháp</span>
                            }
                            else
                            {
                                <span class="badge bg-red text-white shadow-sm border-0">Lưu trữ</span>
                            }
                        </div>
                    </div>
                    <div class="datagrid-item" style="grid-column: span 2;">
                        <div class="datagrid-title fw-bold text-secondary text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Nội dung câu trả lời (Xem trước)</div>
                        <div class="datagrid-content text-body small mt-1 faq-delete-preview">
                            @* Dùng Html.Raw vì nội dung có thể chứa HTML/Ảnh từ editor *@
                            @Html.Raw(Model.CauTraLoi)
                        </div>
                    </div>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="IdFaq" />
                    <div class="d-flex justify-content-center gap-3 mt-2">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            <i class="ti ti-arrow-left me-1"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-danger px-4 shadow-sm">
                            <i class="ti ti-trash me-1"></i> Xác nhận xóa ngay
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="alert alert-important alert-warning shadow-sm mt-3 border-0">
            <div class="d-flex align-items-center">
                <i class="ti ti-alert-circle icon alert-icon me-2"></i>
                <div>
                    <strong>Cảnh báo:</strong> Việc xóa FAQ này sẽ gỡ bỏ nội dung hỗ trợ khách hàng trên trang công khai.
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Đảm bảo nội dung Rich Text hiển thị tốt trong Dark Mode khi xác nhận xóa */
    .faq-delete-preview {
        max-height: 200px;
        overflow-y: auto;
        border: 1px dashed var(--tblr-border-color);
        padding: 10px;
        border-radius: 4px;
    }

        .faq-delete-preview * {
            color: inherit !important;
            background-color: transparent !important;
        }

        .faq-delete-preview img {
            max-width: 100px; /* Thu nhỏ ảnh lại trong phần xem trước xóa */
            height: auto;
            border-radius: 4px;
        }
</style>