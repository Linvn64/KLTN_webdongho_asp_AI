@{
    ViewData["Title"] = "Nhập kho mới";
}

<div class="page-header d-print-none mb-3">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title">
                <i class="ti ti-truck-delivery me-2"></i>Nhập kho mới
            </h2>
        </div>
        <div class="col-auto ms-auto">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="ti ti-history me-2"></i>Lịch sử nhập kho
            </a>
            <a href="/Admin/Khoes" class="btn btn-outline-secondary ms-2">
                <i class="ti ti-building-warehouse me-2"></i>Xem kho
            </a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-header">
                <h3 class="card-title fw-bold">
                    <i class="ti ti-search me-2"></i>Chọn biến thể
                </h3>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">Sản phẩm</label>
                    <select id="selectSanPham" class="form-select">
                        <option value="">-- Chọn sản phẩm --</option>
                        @foreach (var sp in ViewData["SanPhams"] as dynamic)
                        {
                            <option value="@sp.MaSp"
                                    selected="@(ViewBag.SelectedMaSp != null && ViewBag.SelectedMaSp == sp.MaSp ? "selected" : null)">
                                @sp.TenHienThi
                            </option>
                        }
                    </select>
                </div>

                <div id="bienTheContainer" class="d-none">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label fw-bold mb-0">Biến thể</label>
                        <button type="button" id="btnThemTatCa"
                                class="btn btn-xs btn-outline-primary">
                            <i class="ti ti-plus me-1"></i>Thêm tất cả
                        </button>
                    </div>
                    <div id="bienTheList"
                         class="list-group list-group-flush border rounded"
                         style="max-height:400px; overflow-y:auto;">
                    </div>
                </div>

                <div id="loadingBienThe" class="d-none text-center py-3">
                    <div class="spinner-border spinner-border-sm text-primary"></div>
                    <div class="text-muted small mt-1">Đang tải...</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title fw-bold mb-0">
                    <i class="ti ti-clipboard-list me-2"></i>Phiếu nhập kho
                </h3>
                <span class="badge bg-primary" id="soLuongPhieu">0 biến thể</span>
            </div>

            <form method="post" asp-action="Create" id="formNhapKho">
                <div class="card-body p-0">
                    <div id="phieuTrong" class="text-center py-5 text-muted">
                        <i class="ti ti-clipboard fs-1 mb-2 d-block"></i>
                        Chưa có biến thể nào.<br>
                        <small>Chọn sản phẩm bên trái và thêm biến thể vào phiếu.</small>
                    </div>

                    <div id="phieuTable" class="d-none table-responsive">
                        <table class="table table-vcenter mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Biến thể</th>
                                    <th class="text-center">Tồn hiện tại</th>
                                    <th style="width:120px;" class="text-center">Số lượng nhập</th>
                                    <th style="width:160px;" class="text-end">Giá nhập (₫)</th>
                                    <th style="width:40px;"></th>
                                </tr>
                            </thead>
                            <tbody id="phieuBody"></tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="2" class="text-end fw-bold">Tổng:</td>
                                    <td class="text-center fw-bold text-primary" id="tongSoLuong">0</td>
                                    <td class="text-end fw-bold text-success" id="tongGiaTri">0 ₫</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <div class="card-footer d-flex justify-content-between align-items-center">
                    <button type="button" class="btn btn-outline-danger btn-sm"
                            onclick="xoaTatCa()">
                        <i class="ti ti-trash me-1"></i>Xóa tất cả
                    </button>
                    <button type="submit" class="btn btn-primary px-4"
                            id="btnLuu" disabled>
                        <i class="ti ti-device-floppy me-1"></i>Xác nhận nhập kho
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/nhapkho.js"></script>
}