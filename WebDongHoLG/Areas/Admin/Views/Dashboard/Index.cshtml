@{
    ViewData["Title"] = "Bảng điều khiển";
}
<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title text-primary">
                    <i class="ti ti-dashboard me-2"></i> LGWATCH - Tổng quan hệ thống
                </h2>
            </div>
            @* Nút làm mới dữ liệu *@
            <div class="col-auto ms-auto d-print-none">
                <div class="btn-list">
                    <button onclick="window.location.reload();" class="btn btn-primary d-none d-sm-inline-block">
                        <i class="ti ti-refresh me-1"></i> Làm mới dữ liệu
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
@* Hàng 1: 4 thẻ thống kê tổng quát *@
<div class="mb-3 pt-10">
    @await Component.InvokeAsync("TheThongKe")
</div>

@* Hàng 2: Biểu đồ doanh thu chiếm trọn bề ngang cho đẹp *@
<div class="row row-cards">
    <div class="col-12">
        @await Component.InvokeAsync("BieuDoDoanhThu")
    </div>
</div>

<div class="row row-cards mt-1">
    @* Bảng đơn hàng chiếm 8 phần *@
    <div class="col-lg-8">
        @await Component.InvokeAsync("DonHangMoiNhat")
    </div>
    @* Bảng bán chạy chiếm 4 phần *@
    <div class="col-lg-4">
        @await Component.InvokeAsync("SanPhamBanChay")
    </div>
@section Scripts {
    <script src="~/dist/libs/apexcharts/dist/apexcharts.min.js"></script>
}
