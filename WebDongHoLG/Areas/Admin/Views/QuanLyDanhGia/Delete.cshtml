@model WebDongHoLG.Models.DanhGium

@{
    ViewData["Title"] = "Xóa đánh giá";
}

<div class="page-header d-print-none mb-3">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title text-danger">
                <i class="ti ti-alert-octagon me-2"></i>Xác nhận xóa đánh giá
            </h2>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-danger shadow-sm">
            <div class="card-status-top bg-danger"></div>
            <div class="card-body text-center py-4">
                <div class="mb-3 text-danger">
                    <i class="ti ti-trash-x" style="font-size: 4rem;"></i>
                </div>

                <h3 class="h2 text-dark">Bạn có chắc chắn muốn xóa?</h3>
                <p class="text-secondary px-md-5">
                    Hành động này sẽ xóa vĩnh viễn đánh giá của khách hàng <strong class="text-primary bg-primary-lt px-2 py-1 rounded">@Model.MaNguoiDungNavigation?.HoTen</strong>
                    về sản phẩm <strong class="text-dark">@(Model.MaSpNavigation?.TenSanPham ?? "N/A")</strong>.
                </p>

                <div class="hr-text text-danger fw-bold">Thông tin chi tiết đánh giá</div>

                <div class="datagrid text-start my-4 p-4 rounded-3 border bg-azure-lt shadow-none">
                    <div class="datagrid-item">
                        <div class="datagrid-title fw-bold text-secondary text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Khách hàng</div>
                        <div class="datagrid-content text-indigo fw-bold">@Model.MaNguoiDungNavigation?.HoTen</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title fw-bold text-secondary text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Sản phẩm</div>
                        <div class="datagrid-content text-indigo fw-bold">@Model.MaSpNavigation?.TenSanPham</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title fw-bold text-secondary text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Số sao</div>
                        <div class="datagrid-content">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="fa fa-star @(i <= Model.SoSao ? "text-warning" : "text-muted")"></i>
                            }
                            <span class="ms-1 fw-bold">(@Model.SoSao sao)</span>
                        </div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title fw-bold text-secondary text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Ngày đánh giá</div>
                        <div class="datagrid-content text-indigo">@Model.NgayDanhGia?.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                    <div class="datagrid-item" style="grid-column: span 2;">
                        <div class="datagrid-title fw-bold text-secondary text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Nội dung phản hồi</div>
                        <div class="datagrid-content text-dark italic">"@Model.NoiDung"</div>
                    </div>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="MaDanhGia" />
                    <div class="d-flex justify-content-center gap-3 mt-2">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            <i class="ti ti-arrow-left me-1"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-danger px-4 shadow-sm">
                            <i class="ti ti-trash me-1"></i> Xác nhận xóa ngay
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="alert alert-important alert-warning shadow-sm mt-3 border-0">
            <div class="d-flex">
                <div><i class="ti ti-alert-circle icon alert-icon"></i></div>
                <div>
                    <strong>Lưu ý:</strong> Việc xóa đánh giá này có thể ảnh hưởng đến điểm trung bình sao của sản phẩm. Hãy cân nhắc kỹ trước khi thực hiện.
                </div>
            </div>
        </div>
    </div>
</div>