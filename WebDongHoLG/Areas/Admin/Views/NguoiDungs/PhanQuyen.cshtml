@model WebDongHoLG.Areas.Admin.Models.PhanQuyenViewModel
@{
    ViewData["Title"] = "Phân quyền mục lục";
}

<div class="page-header d-print-none mb-3">
    <div class="row g-2 align-items-center">
        <div class="col">
            <h2 class="page-title text-uppercase fw-bold text-primary">
                <i class="ti ti-lock-access me-2"></i> Phân quyền truy cập
            </h2>
            <div class="text-muted mt-1">Thiết lập các mục menu mà nhân viên được phép xem</div>
        </div>
    </div>
</div>

<div class="row row-cards">
    <div class="col-md-12">
        <form asp-action="LuuPhanQuyen" method="post" class="card shadow-sm border-0">
            <input type="hidden" name="userId" value="@Model.UserId" />

            <div class="card-header bg-primary-lt">
                <h3 class="card-title">
                    <i class="ti ti-user me-2"></i>Nhân viên: <span class="text-primary">@Model.HoTen</span>
                </h3>
            </div>

            <div class="table-responsive">
                <table class="table table-vcenter card-table table-striped">
                    <thead>
                        <tr>
                            <th>Chức năng hệ thống</th>
                            <th class="text-secondary small">Mô tả quyền hạn</th>
                            <th class="w-1 text-center">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var mucMoTa = new Dictionary<string, (string Icon, string MoTa)>
                            {
                                ["SanPham"] = ("ti-package", "Xem danh sách, danh mục và thương hiệu đồng hồ"),
                                ["DonHang"] = ("ti-shopping-cart", "Xem và quản lý đơn hàng, vận đơn giao hàng"),
                                ["Kho"] = ("ti-building-warehouse", "Xem tồn kho và thực hiện nhập kho"),
                                ["AI"] = ("ti-robot", "Truy cập trang dự báo và phân tích AI"),
                                ["Reviews"] = ("ti-message-circle", "Xem phản hồi và đánh giá từ khách hàng"),
                            };
                        }
                        @foreach (var muc in Model.TatCaChucNang)
                        {
                            var (icon, moTa) = mucMoTa.GetValueOrDefault(muc, ("ti-lock", "Chức năng hệ thống"));
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="avatar avatar-sm bg-azure-lt text-azure">
                                            <i class="ti @icon"></i>
                                        </span>
                                        <span class="fw-bold">@muc</span>
                                    </div>
                                </td>
                                <td class="text-muted small">@moTa</td>
                                <td class="text-center">
                                    <label class="form-check form-switch m-0 justify-content-center">
                                        <input class="form-check-input" type="checkbox"
                                               name="selectedClaims" value="@muc"
                                               @(Model.QuyenHienTai.Contains(muc) ? "checked" : "")>
                                    </label>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer bg-light d-flex justify-content-between align-items-center">
                <a asp-action="Index" class="btn btn-link text-secondary">
                    <i class="ti ti-arrow-left me-1"></i> Quay lại danh sách
                </a>
                <div class="d-flex gap-2">
                    <button type="reset" class="btn btn-outline-secondary">Hoàn tác</button>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm">
                        <i class="ti ti-device-floppy me-2"></i> Xác nhận cấp quyền
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @if (TempData["Success"] != null)
    {
        <script>
            console.log("@TempData["Success"]");
        </script>
    }
}

