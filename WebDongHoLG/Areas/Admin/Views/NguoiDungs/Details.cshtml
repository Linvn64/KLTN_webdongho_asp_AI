@model WebDongHoLG.Areas.Admin.Models.NguoiDungViewModel
@{
    ViewData["Title"] = "Chi tiết người dùng";
}

<div class="page-header d-print-none mb-3">
    <div class="row g-2 align-items-center">
        <div class="col">
            <h2 class="page-title text-uppercase fw-bold text-primary">
                <i class="ti ti-id me-2"></i> Hồ sơ chi tiết người dùng
            </h2>
        </div>
        <div class="col-auto ms-auto">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="ti ti-arrow-back-up me-1"></i> Quay lại danh sách
            </a>
        </div>
    </div>
</div>

<div class="row row-cards">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
                <div class="mb-3">
                    @if (!string.IsNullOrEmpty(Model.AnhDaiDien))
                    {
                        <span class="avatar avatar-xl rounded-circle shadow-sm border"
                              style="width: 120px; height: 120px; background-image: url('@Url.Content("~/avatarUploads/" + Model.AnhDaiDien.TrimStart('/'))')"></span>
                    }
                    else
                    {
                        <span class="avatar avatar-xl rounded-circle shadow-sm border"
                              style="width: 120px; height: 120px; background-image: url(https://ui-avatars.com/api/?name=@Model.HoTen&size=120&background=random)"></span>
                    }
                </div>
                <h3 class="m-0 mb-1 fw-bold text-primary">@Model.HoTen</h3>
                <div class="text-secondary mb-3">Mã người dùng: #@Model.MaNguoiDung</div>

                @if (Model.VaiTro == "Admin")
                {
                    <span class="badge bg-red-lt fs-4 px-3 py-2"><i class="ti ti-shield-check me-1"></i>Quản trị viên</span>
                }
                else if (Model.VaiTro == "NhanVien")
                {
                    <span class="badge bg-azure-lt fs-4 px-3 py-2"><i class="ti ti-user-check me-1"></i>Nhân viên</span>
                }
                else
                {
                    <span class="badge bg-gray-lt fs-4 px-3 py-2"><i class="ti ti-user me-1"></i>Khách hàng</span>
                }
            </div>
            <div class="d-flex">
                <a href="mailto:@Model.Email" class="card-btn"><i class="ti ti-mail me-2"></i> Gửi Email</a>
                <a href="tel:@Model.Sdt" class="card-btn"><i class="ti ti-phone me-2"></i> Gọi điện</a>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header">
                <h3 class="card-title fw-bold"><i class="ti ti-list-details me-2 text-primary"></i>Thông tin cá nhân</h3>
            </div>
            <div class="card-body">
                <div class="datagrid">
                    <div class="datagrid-item">
                        <div class="datagrid-title">Họ và Tên</div>
                        <div class="datagrid-content fw-bold text-primary">@Model.HoTen</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Giới tính</div>
                        <div class="datagrid-content">
                            @if (Model.GioiTinh?.Trim().ToLower() == "nam")
                            {
                                <span class="text-azure fw-bold"><i class="ti ti-gender-male me-1"></i>Nam</span>
                            }
                            else if (Model.GioiTinh?.Trim().ToLower() == "nu" || Model.GioiTinh?.Trim().ToLower() == "nữ")
                            {
                                <span class="text-pink fw-bold"><i class="ti ti-gender-female me-1"></i>Nữ</span>
                            }
                            else
                            {
                                <span>Khác</span>
                            }
                        </div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Địa chỉ Email</div>
                        <div class="datagrid-content">@Model.Email</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Số điện thoại</div>
                        <div class="datagrid-content">@Model.Sdt</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Ngày tham gia hệ thống</div>
                        <div class="datagrid-content text-success fw-bold">
                            <i class="ti ti-calendar-event me-1"></i>
                            @(Model.NgayTao?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa rõ")
                        </div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">ID Tài khoản (Hệ thống)</div>
                        <div class="datagrid-content">
                            <code class="text-azure">@Model.UserId</code>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-light-lt">
                <small class="text-muted italic">
                    <i class="ti ti-info-circle me-1 text-primary"></i> Bạn chỉ có quyền xem thông tin này. Mọi thay đổi cần được thực hiện bởi người dùng hoặc hệ thống bảo mật.
                </small>
            </div>
        </div>
    </div>
</div>