@model WebDongHoLG.Areas.Admin.Models.EditProfileViewModel
@{
    ViewData["Title"] = "Cài đặt";
}
<div class="page-header d-print-none mb-3">
    <div class="row g-2 align-items-center">
        <div class="col">
            <h2 class="page-title text-uppercase fw-bold text-primary">
                <i class="ti ti-user-check me-2"></i> Hồ sơ của tôi
            </h2>
        </div>
    </div>
</div>

<div class="row row-cards">
    <div class="col-md-12">
        <form id="profile-form" method="post" enctype="multipart/form-data" asp-action="Profile" class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="row g-0">
                    <div class="col-xl-4 col-md-5 border-end bg-light-lt">
                        <div class="d-flex flex-column align-items-center p-4 text-center">
                            <div class="position-relative mb-3">
                                <img id="avatar-preview" class="avatar avatar-xl rounded-circle shadow border border-3 border-white"
                                     style="width: 150px; height: 150px; object-fit: cover;"
                                     src="@(string.IsNullOrEmpty(Model.AnhDaiDien) ? "https://ui-avatars.com/api/?name=" + Model.HoTen : Url.Content("~/avatarUploads/" + Model.AnhDaiDien))">

                                <label class="btn btn-icon btn-primary rounded-circle position-absolute bottom-0 end-0 shadow-sm" style="cursor: pointer;">
                                    <i class="ti ti-camera"></i>
                                    <input type="file" asp-for="UploadAnh" hidden accept="image/*" onchange="previewImage(event)" />
                                </label>
                            </div>

                            <h3 class="mb-1 fw-bold">@Model.HoTen</h3>
                            <p class="text-secondary small mb-3">@Model.Email</p>

                            <div class="hr-text w-100">Quyền hạn</div>
                            <span class="badge bg-purple-lt fw-bold px-3 py-2">
                                <i class="ti ti-shield-check me-1"></i>@(User.IsInRole("Admin") ? "Quản trị viên" : "Nhân viên")
                            </span>
                        </div>
                    </div>

                    <div class="col-xl-8 col-md-7">
                        <div class="p-4">
                            <h4 class="mb-4 fw-bold text-azure"><i class="ti ti-id me-2"></i>Chỉnh sửa thông tin</h4>

                            @if (TempData["Success"] != null)
                            {
                                <div class="alert alert-important alert-success alert-dismissible shadow-sm mb-4" role="alert">
                                    <div class="d-flex">
                                        <div><i class="ti ti-check icon me-2"></i></div>
                                        <div>@TempData["Success"]</div>
                                    </div>
                                    <a class="btn-close" data-bs-dismiss="alert" aria-label="close"></a>
                                </div>
                            }

                            <div class="row g-3">
                                <div class="col-12">
                                    <div class="form-floating mb-3">
                                        <input asp-for="HoTen" class="form-control border-primary-subtle" placeholder="Họ và tên" />
                                        <label>Họ và Tên</label>
                                        <span asp-validation-for="HoTen" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-floating mb-3">
                                        <input asp-for="Sdt" class="form-control border-primary-subtle" placeholder="Số điện thoại" />
                                        <label>Số điện thoại</label>
                                        <span asp-validation-for="Sdt" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-floating mb-3">
                                        <select asp-for="GioiTinh" class="form-select border-primary-subtle">
                                            <option value="Nam">Nam</option>
                                            <option value="Nu">Nữ</option>
                                            <option value="Khac">Khác</option>
                                        </select>
                                        <label>Giới tính</label>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="form-floating mb-3">
                                        <input asp-for="Email" class="form-control bg-light" readonly />
                                        <label>Email đăng nhập (Cố định)</label>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-4 pt-3 border-top d-flex justify-content-end">
                                <button type="submit" class="btn btn-primary px-4 shadow-sm">
                                    <i class="ti ti-device-floppy me-2"></i> Lưu hồ sơ cá nhân
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImage(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('avatar-preview').src = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        }
    </script>
}