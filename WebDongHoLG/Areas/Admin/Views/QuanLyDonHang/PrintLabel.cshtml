@model WebDongHoLG.Models.DonHang
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>In nhãn dán #@Model.MaDonHang</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        body {
            background: #fff;
            font-family: 'Arial', sans-serif;
            padding: 0;
            margin: 0;
        }

        .shipping-label {
            width: 100mm; /* Khổ A6 chuẩn */
            border: 2px solid #000;
            margin: 10px auto;
            padding: 15px;
            position: relative;
            background: #fff;
        }

        .header-label {
            border-bottom: 2px solid #000;
            padding-bottom: 10px;
            margin-bottom: 15px;
        }

        .section-title {
            font-weight: bold;
            text-decoration: underline;
            font-size: 13px;
            margin-bottom: 5px;
        }

        .info-text {
            font-size: 14px;
            margin-bottom: 10px;
            line-height: 1.4;
        }

        .barcode-area {
            text-align: center;
            border: 1px dashed #000;
            margin: 15px 0;
            padding: 10px;
            font-weight: bold;
            letter-spacing: 5px;
        }

        .product-list {
            font-size: 12px;
            border-top: 1px solid #000;
            padding-top: 10px;
            margin-top: 10px;
        }

        @@media print {
            .no-print

        {
            display: none !important;
        }

        body {
            margin: 0;
            padding: 0;
        }

        .shipping-label {
            border: 2px solid #000;
            margin: 0;
            width: 100mm;
        }

        }
    </style>
</head>
<body onload="window.print()">
    @* Nút điều khiển chỉ hiện trên web, không hiện khi in *@
    <div class="no-print text-center my-3">
        <button onclick="window.print()" class="btn btn-primary btn-lg">Bấm để in lại</button>
        <a href="javascript:window.close()" class="btn btn-secondary btn-lg">Đóng trang</a>
    </div>

    <div class="shipping-label">
        <div class="header-label d-flex justify-content-between align-items-center">
            <h4 class="mb-0 fw-bold">DONGHO LG - MALL</h4>
            <span class="fw-bold">Mã đơn: #@Model.MaDonHang</span>
        </div>

        <div class="row">
            <div class="col-6 border-end">
                <div class="section-title">TỪ (SENDER):</div>
                <div class="info-text">
                    <strong>DongHo LG Store</strong><br>
                    Số 1 Cầu Giấy, Hà Nội<br>
                    SĐT: 0987.654.321
                </div>
            </div>
            <div class="col-6">
                <div class="section-title">ĐẾN (RECEIVER):</div>
                <div class="info-text">
                    <strong>@Model.MaNguoiDungNavigation?.HoTen</strong><br>
                    SĐT: @Model.MaDiaChiNavigation?.SdtNhanHang<br>
                    @Model.MaDiaChiNavigation?.DiaChi
                </div>
            </div>
        </div>

        <div class="barcode-area">
            <div style="font-size: 20px;">|||||| |||| |||||| ||||</div>
            <div style="font-size: 12px; font-family: Arial; letter-spacing: normal;">DH-LG-@Model.MaDonHang</div>
        </div>

        <div class="product-list">
            <div class="section-title">NỘI DUNG HÀNG:</div>
            @foreach (var item in Model.ChiTietDonHangs)
            {
                <div class="mb-1">- @item.MaBienTheNavigation?.MaSpNavigation?.TenSanPham (@item.MaBienTheNavigation?.MauSac) x @item.SoLuong</div>
            }
        </div>

        <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-end">
            <div style="flex: 1;">
                <div class="section-title">CHI TIẾT THANH TOÁN:</div>
                <div style="font-size: 12px; line-height: 1.6;">
                    Tiền hàng: @String.Format("{0:#,##0}", Model.TongTien + Model.TienGiamGia - Model.PhiVanChuyen)₫<br />
                    Phí ship: + @String.Format("{0:#,##0}", Model.PhiVanChuyen)₫<br />
                    Giảm giá: - @String.Format("{0:#,##0}", Model.TienGiamGia)₫
                </div>

                <div class="section-title mt-2">TỔNG THU HỘ (COD):</div>
                <h2 class="fw-bold mb-0">
                    @if (Model.ThanhToan != null && Model.ThanhToan.TrangThai == "Thành công")
                    {
                        <span>0 VNĐ</span>
                        <div style="font-size: 11px; color: green;">(Đã thanh toán Online)</div>
                    }
                    else
                    {
                        <span>@String.Format("{0:#,##0}", Model.TongTien) VNĐ</span>
                    }
                </h2>
            <div class="text-center" style="width: 150px;">
                <small class="text-muted">Chữ ký người nhận</small>
                <div style="height: 50px;"></div>
                <div style="border-top: 1px solid #ccc;"></div>
            </div>
        </div>
        <div class="text-center mt-3" style="font-size: 10px; font-style: italic; border-top: 1px dashed #ccc; pt-2">
            Cảm ơn bạn đã tin tưởng DONGHO LG! Kiểm tra hàng trước khi nhận.
        </div>
    </div>
</body>
</html>