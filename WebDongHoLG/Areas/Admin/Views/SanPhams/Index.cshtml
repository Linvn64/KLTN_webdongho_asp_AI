@model IEnumerable<WebDongHoLG.Data.SanPham>
@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="page-header d-print-none mb-3">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title">Quản lý sản phẩm</h2>
        </div>
        <div class="col-auto ms-auto">
            <a asp-action="Create" class="btn btn-primary">
                <i class="ti ti-plus me-2"></i> Thêm sản phẩm
            </a>
        </div>
    </div>
</div>

<div class="card mb-3 shadow-sm">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-3">
                <select name="idDanhmuc" class="form-select">
                    <option value="">-- Tất cả Danh mục --</option>
                    @foreach (var c in ViewBag.DanhMucSanPhams)
                    {
                        <option value="@c.IdDanhMuc" selected="@(Context.Request.Query["idDanhmuc"] == c.IdDanhMuc.ToString() ? "selected" : null)">
                            @c.TenDanhMuc
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="idThuongHieu" class="form-select">
                    <option value="">-- Tất cả Thương hiệu --</option>
                    @foreach (var b in ViewBag.ThuongHieus)
                    {
                        <option value="@b.Id" selected="@(Context.Request.Query["idThuongHieu"] == b.Id.ToString() ? "selected" : null)">
                            @b.TenThuongHieu
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="doiTuong" class="form-select">
                    @{
                        var dt = Context.Request.Query["doiTuong"].ToString();
                    }
                    <option value="">-- Tất cả Đối tượng --</option>
                    <option value="Nam" selected="@(dt == "Nam" ? "selected" : null)">Nam</option>
                    <option value="Nữ" selected="@(dt == "Nữ" ? "selected" : null)">Nữ</option>
                    <option value="Unisex" selected="@(dt == "Unisex" ? "selected" : null)">Unisex</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <a asp-action="Index" class="btn btn-secondary w-50">
                    <i class="ti ti-refresh me-2"></i> Tải lại
                </a>
                <button type="submit" class="btn btn-primary w-50">
                    <i class="ti ti-filter me-2"></i> Lọc dữ liệu
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-vcenter table-hover card-table">
            <thead>
                <tr>
                    <th>Tên sản phẩm</th>
                    <th style="width:150px;">Thương hiệu</th>
                    <th>Danh mục</th>
                    <th>Đối tượng</th>
                    <th>Ngày tạo</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <!-- Hàng sản phẩm chính -->
                    <tr class="product-row" style="cursor:pointer;"
                        data-sp-id="@item.MaSp"
                        onclick="toggleBienThe(@item.MaSp, this)">
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <i class="ti ti-chevron-right text-muted toggle-icon" style="transition:0.2s;"></i>
                                <div>
                                    <div class="fw-bold text-primary">@item.TenSanPham</div>
                                    <div class="text-muted small text-truncate" style="max-width:250px;">@item.MoTa</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="badge bg-primary text-primary-fg w-100 py-2">
                                @(item.ThuongHieuNavigation?.TenThuongHieu ?? "N/A")
                            </span>
                        </td>
                        <td><span class="text-secondary">@(item.IdDanhMucNavigation?.TenDanhMuc ?? "N/A")</span></td>
                        <td>@item.DoiTuong</td>
                        <td class="text-muted small">@item.NgayTao?.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (item.IsActive == true)
                            {
                                <span class="status status-green">
                                    <span class="status-dot status-dot-animated"></span> Đang bán
                                </span>
                            }
                            else
                            {
                                <span class="status status-red">
                                    <span class="status-dot"></span> Ẩn/Ngừng
                                </span>
                            }
                        </td>
                        <td class="text-end" onclick="event.stopPropagation()">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Edit" asp-route-id="@item.MaSp"
                                   class="btn btn-icon btn-outline-warning" title="Sửa">
                                    <i class="ti ti-edit"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.MaSp"
                                   class="btn btn-icon btn-outline-info" title="Xem">
                                    <i class="ti ti-eye"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.MaSp"
                                   class="btn btn-icon btn-outline-danger" title="Xóa">
                                    <i class="ti ti-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>

                    <!-- Hàng biến thể (ẩn ban đầu) -->
                    <tr id="bienthe-row-@item.MaSp" class="bienthe-row d-none">
                        <td colspan="7" class="p-0 bg-light border-top-0">
                            <div class="px-4 py-3" id="bienthe-content-@item.MaSp">
                                <div class="text-center py-3 text-muted">
                                    <div class="spinner-border spinner-border-sm me-2"></div>
                                    Đang tải biến thể...
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        // Track trạng thái đã load chưa để không fetch lại
        const loadedMap = {};

        function toggleBienThe(maSp, row) {
            const bienTheRow = document.getElementById(`bienthe-row-${maSp}`);
            const icon = row.querySelector('.toggle-icon');
            const isHidden = bienTheRow.classList.contains('d-none');

            // Đóng/mở
            bienTheRow.classList.toggle('d-none', !isHidden);
            icon.style.transform = isHidden ? 'rotate(90deg)' : 'rotate(0deg)';

            // Nếu đang mở và chưa load thì fetch
            if (isHidden && !loadedMap[maSp]) {
                loadedMap[maSp] = true;
                loadBienThe(maSp);
            }
        }

        function loadBienThe(maSp) {
            const container = document.getElementById(`bienthe-content-${maSp}`);

            fetch(`/Admin/BienTheSanPhams/GetBienTheBySpId?maSp=${maSp}`)
                .then(res => res.json())
                .then(data => {
                    if (!data || data.length === 0) {
                        container.innerHTML = `
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="text-muted small italic">Chưa có biến thể nào.</span>
                                <a href="/Admin/BienTheSanPhams/Create?maSp=${maSp}" class="btn btn-sm btn-primary">
                                    <i class="ti ti-plus me-1"></i>Thêm biến thể
                                </a>
                            </div>`;
                        return;
                    }

                    let html = `
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <small class="text-muted fw-bold text-uppercase">
                                ${data.length} biến thể
                            </small>
                            <a href="/Admin/BienTheSanPhams/Create?maSp=${maSp}" class="btn btn-sm btn-primary">
                                <i class="ti ti-plus me-1"></i>Thêm biến thể
                            </a>
                        </div>
                        <div class="table-responsive">
                        <table class="table table-sm table-vcenter mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Ảnh</th>
                                    <th>SKU</th>
                                    <th>Màu sắc</th>
                                    <th>Size</th>
                                    <th>Dây</th>
                                    <th>Giá bán</th>
                                    <th>Trạng thái</th>
                                    <th class="text-end">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>`;

                    data.forEach(bt => {
                        html += `
                            <tr>
                                <td>
                                    ${bt.imageUrl
                                        ? `<span class="avatar avatar-sm border shadow-sm"
                                                style="background-image:url('${bt.imageUrl}')"></span>`
                                        : `<span class="avatar avatar-sm border"><i class="ti ti-photo-off"></i></span>`}
                                </td>
                                <td class="font-monospace small">${bt.maSku ?? '-'}</td>
                                <td><span class="badge bg-blue-lt">${bt.mauSac ?? '-'}</span></td>
                                <td>${bt.duongKinhMat ? bt.duongKinhMat + ' mm' : '-'}</td>
                                <td class="small text-muted">${bt.chatLieuDay ?? '-'}</td>
                                <td class="fw-bold text-danger">${bt.giaBan ? bt.giaBan.toLocaleString('vi-VN') + ' ₫' : '-'}</td>
                                <td>
                                    ${bt.isActive
                                        ? `<span class="status status-green">
                                               <span class="status-dot status-dot-animated"></span> Hoạt động
                                           </span>`
                                        : `<span class="status status-red">
                                               <span class="status-dot"></span> Ngừng bán
                                           </span>`}
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a href="/Admin/BienTheSanPhams/Edit/${bt.maBienThe}"
                                           class="btn btn-icon btn-sm btn-outline-warning" title="Sửa">
                                            <i class="ti ti-edit"></i>
                                        </a>
                                        <a href="/Admin/BienTheSanPhams/Details/${bt.maBienThe}"
                                           class="btn btn-icon btn-sm btn-outline-info" title="Xem">
                                            <i class="ti ti-eye"></i>
                                        </a>
                                        <a href="/Admin/BienTheSanPhams/Delete/${bt.maBienThe}"
                                           class="btn btn-icon btn-sm btn-outline-danger" title="Xóa">
                                            <i class="ti ti-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>`;
                    });

                    html += `</tbody></table></div>`;
                    container.innerHTML = html;
                })
                .catch(() => {
                    container.innerHTML = `<div class="text-danger small p-2">
                        <i class="ti ti-wifi-off me-1"></i>Không tải được biến thể.
                    </div>`;
                });
        }
    </script>
}