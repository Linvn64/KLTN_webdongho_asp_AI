@model IEnumerable<WebDongHoLG.Data.SanPham>
@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="page-header d-print-none mb-3">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title">Quản lý sản phẩm</h2>
        </div>
        <div class="col-auto ms-auto">
            <a asp-action="Create" class="btn btn-primary">
                <i class="ti ti-plus me-2"></i> Thêm sản phẩm
            </a>
            <a asp-action="Trash" class="btn btn-outline-danger">
                Ngừng hoạt động
            </a>
        </div>
    </div>
</div>

<div class="card mb-3 shadow-sm">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-3">
                <select name="idDanhmuc" class="form-select">
                    <option value="">-- Tất cả Danh mục --</option>
                    @foreach (var c in ViewBag.DanhMucSanPhams)
                    {
                        <option value="@c.IdDanhMuc"
                                selected="@(Context.Request.Query["idDanhmuc"] == c.IdDanhMuc.ToString() ? "selected" : null)">
                            @c.TenDanhMuc
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <select name="idThuongHieu" class="form-select">
                    <option value="">-- Tất cả Thương hiệu --</option>
                    @foreach (var b in ViewBag.ThuongHieus)
                    {
                        <option value="@b.Id"
                                selected="@(Context.Request.Query["idThuongHieu"] == b.Id.ToString() ? "selected" : null)">
                            @b.TenThuongHieu
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <select name="doiTuong" class="form-select">
                    @{
                        var dt = Context.Request.Query["doiTuong"].ToString();
                    }
                    <option value="">-- Tất cả Đối tượng --</option>
                    <option value="Nam" selected="@(dt == "Nam" ? "selected" : null)">Nam</option>
                    <option value="Nữ" selected="@(dt == "Nữ" ? "selected" : null)">Nữ</option>
                    <option value="Unisex" selected="@(dt == "Unisex" ? "selected" : null)">Unisex</option>
                </select>
            </div>

            <div class="col-md-3 d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary w-50">
                    <i class="ti ti-refresh me-2"></i> Tải lại
                </a>
                <button type="submit" class="btn btn-primary w-50">
                    <i class="ti ti-filter me-2"></i> Lọc dữ liệu
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-vcenter table-hover card-table">

            <!-- FIX -->
            <thead class="bg-body">
                <tr>
                    <th>Tên sản phẩm</th>
                    <th style="width:150px;">Thương hiệu</th>
                    <th>Danh mục</th>
                    <th>Đối tượng</th>
                    <th>Ngày tạo</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    if (item.IsActive == true)
                    {
                        <tr class="product-row" style="cursor:pointer;"
                            onclick="toggleBienThe(@item.MaSp, this)">

                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <i class="ti ti-chevron-right text-muted toggle-icon"></i>
                                    <div>
                                        <div class="fw-bold text-primary">
                                            @item.TenSanPham
                                        </div>

                                        <div class="text-muted small text-truncate"
                                             style="max-width:250px;">
                                            @item.MoTa
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <span class="badge bg-primary-lt">
                                    @(item.ThuongHieuNavigation?.TenThuongHieu ?? "N/A")
                                </span>
                            </td>

                            <!-- FIX: text-secondary -> text-body -->
                            <td class="text-body">
                                @(item.IdDanhMucNavigation?.TenDanhMuc ?? "N/A")
                            </td>

                            <td class="text-body">@item.DoiTuong</td>

                            <td class="text-muted small">
                                @item.NgayTao?.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                <span class="status status-green">
                                    <span class="status-dot status-dot-animated"></span>
                                    Đang bán
                                </span>
                            </td>

                            <td class="text-end" onclick="event.stopPropagation()">
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.MaSp"
                                       class="btn btn-icon btn-outline-warning">
                                        <i class="ti ti-edit"></i>
                                    </a>

                                    <a asp-action="Details" asp-route-id="@item.MaSp"
                                       class="btn btn-icon btn-outline-info">
                                        <i class="ti ti-eye"></i>
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.MaSp"
                                       asp-route-returnUrl="@Context.Request.Path"
                                       class="btn btn-icon btn-outline-danger">
                                        <i class="ti ti-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>

                        <!-- FIX: bg-light -> bg-body -->
                        <tr id="bienthe-row-@item.MaSp" class="d-none">
                            <td colspan="7" class="p-0 bg-body border-top-0">
                                <div class="px-4 py-3" id="bienthe-content-@item.MaSp">
                                    <div class="text-center py-3 text-muted">
                                        <div class="spinner-border spinner-border-sm me-2"></div>
                                        Đang tải biến thể...
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/sanpham.js"></script>
}