@model WebDongHoLG.Data.SanPham

@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<div class="page-header d-print-none mb-3">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title">
                Chỉnh sửa sản phẩm
            </h2>
            <div class="text-primary mt-1">Mã hệ thống: #@Model.MaSp</div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <form asp-area="Admin" asp-controller="SanPhams" asp-action="Edit" method="post">
        <div class="card-body">
            <input type="hidden" asp-for="MaSp" />
            <input type="hidden" asp-for="NgayTao" />

            <div asp-validation-summary="All" class="alert alert-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Tên sản phẩm</label>
                    <input asp-for="TenSanPham" class="form-control" placeholder="Nhập tên sản phẩm..." />
                    <span asp-validation-for="TenSanPham" class="text-danger small"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Danh mục</label>
                    <select asp-for="IdDanhMuc" class="form-select" asp-items="ViewBag.IdDanhMuc">
                        <option value="">-- Chọn danh mục --</option>
                    </select>
                    <span asp-validation-for="IdDanhMuc" class="text-danger small"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Thương hiệu</label>
                    <select asp-for="ThuongHieuId" class="form-select" asp-items="ViewBag.ThuongHieuId">
                        <option value="">-- Chọn thương hiệu --</option>
                    </select>
                    <span asp-validation-for="ThuongHieuId" class="text-danger small"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Đối tượng</label>
                    <select asp-for="DoiTuong" class="form-select">
                        <option value="Nam">Nam</option>
                        <option value="Nữ">Nữ</option>
                        <option value="Unisex">Unisex</option>
                    </select>
                    <span asp-validation-for="DoiTuong" class="text-danger small"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Trạng thái kinh doanh</label>
                    <label class="form-check form-switch mt-2">
                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" @(Model.IsActive == true ? "checked" : "") />
                        <input type="hidden" name="IsActive" value="false" />
                        <span class="form-check-label">Đang hiển thị trên Web</span>
                    </label>
                </div>

                <div class="col-md-12 mb-3">
                    <label class="form-label fw-bold">Mô tả sản phẩm</label>
                    <textarea asp-for="MoTa" class="form-control" rows="6" placeholder="Nhập mô tả chi tiết..."></textarea>
                    <span asp-validation-for="MoTa" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="card-footer text-end bg-light">
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted small">
                    <i class="ti ti-history me-1"></i> Cập nhật: @DateTime.Now.ToString("dd/MM/yyyy")
                </span>
                <div>
                    <a asp-action="Index" class="btn btn-ghost-secondary me-2">
                        <i class="ti ti-arrow-left me-1"></i> Hủy bỏ
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="ti ti-device-floppy me-1"></i> Lưu thay đổi
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}