@model WebDongHoLG.Data.SanPham
@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<div class="page-header mb-3">
    <h2 class="page-title">Chỉnh sửa sản phẩm</h2>
    <div class="text-primary mt-1">Mã hệ thống: #@Model.MaSp</div>
</div>

<div class="card shadow-sm">
    <form asp-action="Edit" method="post">
        <div class="card-body">
            <input type="hidden" asp-for="MaSp" />
            <input type="hidden" asp-for="NgayTao" />
            <div asp-validation-summary="All" class="alert alert-danger mb-3"></div>

            @* GỌI PARTIAL VIEW Ở ĐÂY *@
            <partial name="_SanPhamForm" model="Model" />

        </div>
        <div class="card-footer text-end bg-light">
            <a asp-action="Index" class="btn btn-ghost-secondary me-2">Hủy bỏ</a>
            <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i> Lưu thay đổi</button>
        </div>
    </form>
</div>