@model WebDongHoLG.Data.SanPham
@{
    ViewData["Title"] = "Thêm sản phẩm mới";
}

<div class="page-header d-print-none mb-3">
    <h2 class="page-title">Thêm sản phẩm mới</h2>
</div>

<div class="card shadow-sm">
    <form asp-action="Create" method="post">
        <div class="card-body">
            <div asp-validation-summary="All" class="alert alert-danger mb-3"></div>

            @* GỌI PARTIAL VIEW Ở ĐÂY *@
            <partial name="_SanPhamForm" model="Model" />

        </div>
        <div class="card-footer text-end bg-light">
            <a asp-action="Index" class="btn btn-ghost-secondary me-2">Hủy bỏ</a>
            <button type="submit" class="btn btn-primary"><i class="ti ti-plus me-1"></i> Tạo sản phẩm</button>
        </div>
    </form>
</div>