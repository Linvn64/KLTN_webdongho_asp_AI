@model IEnumerable<WebDongHoLG.Data.SanPham>
@{
    ViewData["Title"] = "Thùng rác sản phẩm";
}

<div class="page-header d-print-none mb-3">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title text-danger"><i class="ti ti-trash-x me-2"></i>Thùng rác hệ thống</h2>
        </div>
        <div class="col-auto ms-auto">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="ti ti-arrow-left me-2"></i> Quay lại danh sách
            </a>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-vcenter table-hover card-table">
            <thead>
                <tr class="bg-light">
                    <th>Tên sản phẩm (Cha)</th>
                    <th>Danh mục</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="product-row" style="cursor:pointer;" onclick="toggleTrashRow(@item.MaSp, this)">
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <i class="ti ti-chevron-right text-muted toggle-icon" style="transition:0.2s;"></i>
                                <span class="fw-bold text-danger">@item.TenSanPham</span>
                            </div>
                        </td>
                        <td><span class="text-muted">@(item.IdDanhMucNavigation?.TenDanhMuc ?? "N/A")</span></td>
                        <td class="text-end" onclick="event.stopPropagation()">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Details" asp-route-id="@item.MaSp" class="btn btn-icon btn-outline-info" title="Xem chi tiết sản phẩm">
                                    <i class="ti ti-eye"></i>
                                </a>
                                <form asp-action="Restore" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.MaSp" />
                                    <input type="hidden" name="type" value="SanPham" />
                                    <button type="submit" class="btn btn-success"><i class="ti ti-refresh"></i> Khôi phục SP</button>
                                </form>
                            </div>
                        </td>
                    </tr>

                    <tr id="trash-row-@item.MaSp" class="d-none bg-light">
                        <td colspan="3" class="p-0 border-top-0">
                            <div id="trash-content-@item.MaSp" class="px-5 py-3 border-start border-danger border-3 ms-3 my-2">
                                <div class="text-center text-muted small py-2">Đang tải biến thể ẩn...</div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        const loadedTrash = {};

        function toggleTrashRow(maSp, row) {
            const contentRow = document.getElementById(`trash-row-${maSp}`);
            const icon = row.querySelector('.toggle-icon');
            const isHidden = contentRow.classList.contains('d-none');

            contentRow.classList.toggle('d-none', !isHidden);
            icon.style.transform = isHidden ? 'rotate(90deg)' : 'rotate(0deg)';

            if (isHidden && !loadedTrash[maSp]) {
                fetch(`/Admin/BienTheSanPhams/GetBienTheBySpId?maSp=${maSp}`)
                    .then(res => res.json())
                    .then(data => {
                        // Lọc các biến thể bị ẩn
                        const hiddenBT = data.filter(x => x.isActive === false);
                        const container = document.getElementById(`trash-content-${maSp}`);

                        if (hiddenBT.length === 0) {
                            container.innerHTML = '<div class="small text-muted italic p-2"><i class="ti ti-info-circle me-1"></i>Sản phẩm này không có biến thể nào bị ẩn.</div>';
                        } else {
                            let html = `
                                <div class="table-responsive">
                                <table class="table table-sm table-vcenter mb-0 border rounded bg-white">
                                    <thead class="table-light">
                                        <tr>
                                            <th>SKU</th>
                                            <th>Màu sắc</th>
                                            <th class="text-end">Thao tác con</th>
                                        </tr>
                                    </thead>
                                    <tbody>`;

                            hiddenBT.forEach(bt => {
                                html += `
                                    <tr>
                                        <td class="font-monospace text-danger small">${bt.maSku ?? 'N/A'}</td>
                                        <td><span class="badge bg-red-lt">${bt.mauSac ?? 'N/A'}</span></td>
                                        <td class="text-end">
                                            <div class="d-flex justify-content-end gap-1">
                                                <a href="/Admin/BienTheSanPhams/Details/${bt.maBienThe}"
                                                   class="btn btn-icon btn-sm btn-outline-info" title="Xem chi tiết biến thể">
                                                    <i class="ti ti-eye"></i>
                                                </a>

                                                <form action="/Admin/SanPhams/Restore" method="post" style="display:inline;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="${bt.maBienThe}" />
                                                    <input type="hidden" name="type" value="BienThe" />
                                                    <button type="submit" class="btn btn-sm btn-success">Khôi phục</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>`;
                            });
                            html += '</tbody></table></div>';
                            container.innerHTML = html;
                        }
                        loadedTrash[maSp] = true;
                    })
                    .catch(() => {
                        document.getElementById(`trash-content-${maSp}`).innerHTML = '<span class="text-danger small">Lỗi tải dữ liệu.</span>';
                    });
            }
        }
    </script>
}