@model IEnumerable<WebDongHoLG.Data.SanPham>
@{
    ViewData["Title"] = "Thùng rác sản phẩm";
}

<div class="page-header d-print-none mb-3">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title text-danger">
                <i class="ti ti-trash-x me-2"></i>Thùng rác hệ thống
            </h2>
        </div>
        <div class="col-auto ms-auto">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="ti ti-arrow-left me-2"></i> Quay lại danh sách
            </a>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-vcenter table-hover card-table">
            <thead class="table-light">
                <tr>
                    <th class="text-secondary">Tên sản phẩm (Cha)</th>
                    <th class="text-secondary">Danh mục</th>
                    <th class="text-end text-secondary">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr style="cursor:pointer;" onclick="toggleTrashRow(@item.MaSp, this)">
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <i class="ti ti-chevron-right text-muted toggle-icon" style="transition:0.2s;"></i>

                                <span class="fw-bold @(item.IsActive == false ? "text-danger" : "text-body")">
                                    @item.TenSanPham
                                    @if (item.IsActive == true)
                                    {
                                        <span class="text-warning small">(Có biến thể bị ẩn)</span>
                                    }
                                </span>
                            </div>
                        </td>

                        <td>
                            <span class="text-muted small">
                                @(item.IdDanhMucNavigation?.TenDanhMuc ?? "N/A")
                            </span>
                        </td>

                        <td class="text-end" onclick="event.stopPropagation()">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Details" asp-route-id="@item.MaSp"
                                   class="btn btn-icon btn-outline-info" title="Xem chi tiết">
                                    <i class="ti ti-eye"></i>
                                </a>

                                @if (item.IsActive == false)
                                {
                                    <form asp-action="Restore" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.MaSp" />
                                        <input type="hidden" name="type" value="SanPham" />
                                        <button type="submit" class="btn btn-success btn-sm">
                                            <i class="ti ti-refresh"></i> Khôi phục
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="badge bg-blue-lt">Đang hoạt động</span>
                                }
                            </div>
                        </td>
                    </tr>

                    <!-- ROW CON -->
                    <tr id="trash-row-@item.MaSp" class="d-none">
                        <td colspan="3" class="p-0 border-top-0">
                            <div id="trash-content-@item.MaSp"
                                 class="px-4 py-3 border-start border-danger border-3 ms-3 my-2">

                                <div class="text-center text-muted small py-2">
                                    Đang tải biến thể ẩn...
                                </div>

                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        const loadedTrash = {};

        function toggleTrashRow(maSp, row) {
            const contentRow = document.getElementById(`trash-row-${maSp}`);
            const icon = row.querySelector('.toggle-icon');
            const isHidden = contentRow.classList.contains('d-none');

            contentRow.classList.toggle('d-none', !isHidden);
            icon.style.transform = isHidden ? 'rotate(90deg)' : 'rotate(0deg)';

            if (isHidden && !loadedTrash[maSp]) {
                const container = document.getElementById(`trash-content-${maSp}`);

                fetch(`/Admin/BienTheSanPhams/GetBienTheBySpId?maSp=${maSp}&active=false`)
                    .then(res => res.json())
                    .then(data => {
                        if (!data || data.length === 0) {
                            container.innerHTML = `
                                <div class="small text-muted p-2">
                                    <i class="ti ti-info-circle me-1"></i>
                                    Không có biến thể bị ẩn.
                                </div>`;
                        } else {
                            let html = `
                            <div class="table-responsive">
                            <table class="table table-sm table-vcenter mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>SKU</th>
                                        <th>Màu sắc</th>
                                        <th class="text-end">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>`;

                            data.forEach(bt => {
                                html += `
                                    <tr>
                                        <td class="font-monospace text-danger small">${bt.maSku ?? 'N/A'}</td>
                                        <td><span class="badge bg-red-lt">${bt.mauSac ?? 'N/A'}</span></td>
                                        <td class="text-end">
                                            <div class="d-flex justify-content-end gap-1">
                                                <a href="/Admin/BienTheSanPhams/Details/${bt.maBienThe}"
                                                   class="btn btn-icon btn-sm btn-outline-info">
                                                    <i class="ti ti-eye"></i>
                                                </a>
                                                <form action="/Admin/SanPhams/Restore" method="post">
                                                    <input type="hidden" name="id" value="${bt.maBienThe}" />
                                                    <input type="hidden" name="type" value="BienThe" />
                                                    <button type="submit" class="btn btn-sm btn-success">
                                                        Khôi phục
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>`;
                            });

                            html += '</tbody></table></div>';
                            container.innerHTML = html;
                        }

                        loadedTrash[maSp] = true;
                    })
                    .catch(() => {
                        container.innerHTML = '<span class="text-danger small">Lỗi tải dữ liệu.</span>';
                    });
            }
        }
    </script>
}