@model WebDongHoLG.Models.DanhMucSanPham

@{
    ViewData["Title"] = "Xóa danh mục";
}

<div class="page-header d-print-none mb-3">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title text-danger">
                <i class="ti ti-alert-triangle me-2"></i>Xác nhận xóa danh mục sản phẩm
            </h2>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-danger shadow-sm">
            <div class="card-status-top bg-danger"></div>
            <div class="card-body text-center py-4">
                <div class="mb-3 text-danger">
                    <i class="ti ti-trash-x" style="font-size: 4rem;"></i>
                </div>

                <h3 class="h2 text-dark">Bạn có chắc chắn muốn xóa?</h3>
                <p class="text-secondary px-md-5">
                    Hành động này sẽ xóa vĩnh viễn danh mục:
                    <strong class="text-danger bg-danger-lt px-2 py-1 rounded">@Model.TenDanhMuc</strong>
                    khỏi hệ thống. Tất cả các liên kết dữ liệu liên quan có thể bị ảnh hưởng.
                </p>

                <div class="hr-text text-danger fw-bold">Thông tin chi tiết danh mục</div>

                <div class="datagrid text-start my-4 p-4 rounded-3 border bg-red-lt shadow-none">
                    <div class="datagrid-item">
                        <div class="datagrid-title fw-bold text-secondary text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Mã Danh Mục</div>
                        <div class="datagrid-content text-danger fw-bold" style="font-size: 1rem;">#@Model.IdDanhMuc</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title fw-bold text-secondary text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Tên Danh Mục</div>
                        <div class="datagrid-content text-danger fw-bold">@Model.TenDanhMuc</div>
                    </div>
                    <div class="datagrid-item" style="grid-column: span 2;">
                        <div class="datagrid-title fw-bold text-secondary text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Mô tả</div>
                        <div class="datagrid-content text-dark">
                            @(string.IsNullOrEmpty(Model.MoTa) ? "Không có mô tả." : Model.MoTa)
                        </div>
                    </div>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="IdDanhMuc" />
                    <div class="d-flex justify-content-center gap-3 mt-2">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            <i class="ti ti-arrow-left me-1"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-danger px-4 shadow-sm">
                            <i class="ti ti-trash me-1"></i> Xác nhận xóa ngay
                        </button>
                    </div>
                </form>
            </div>
        </div>

        @* Thông báo lưu ý về tính toàn vẹn dữ liệu *@
        <div class="alert alert-important alert-warning shadow-sm mt-3 border-0">
            <div class="d-flex">
                <div><i class="ti ti-alert-circle icon alert-icon"></i></div>
                <div>
                    <strong>Lưu ý quan trọng:</strong> Giang hãy kiểm tra xem danh mục này còn chứa sản phẩm nào không. Nếu còn sản phẩm, hệ thống có thể từ chối xóa để tránh lỗi dữ liệu "mồ côi".
                </div>
            </div>
        </div>
    </div>
</div>