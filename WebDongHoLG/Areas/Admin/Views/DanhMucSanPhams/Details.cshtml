@model WebDongHoLG.Models.DanhMucSanPham

@{
    ViewData["Title"] = "Chi tiết danh mục";
}

<div class="page-header d-print-none mb-3">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title text-primary">
                <i class="ti ti-info-square-rounded me-2"></i>Chi tiết danh mục: @Model.TenDanhMuc
            </h2>
            <div class="text-secondary mt-1 small">Mã định danh: <span class="badge bg-azure-lt">#@Model.IdDanhMuc</span></div>
        </div>
        <div class="col-auto ms-auto">
            <div class="btn-list">
                <a asp-action="Edit" asp-route-id="@Model?.IdDanhMuc" class="btn btn-primary d-none d-sm-inline-block">
                    <i class="ti ti-edit me-1"></i> Chỉnh sửa
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="ti ti-arrow-left me-1"></i> Quay lại danh sách
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row row-cards">
    @* --- Cột bên trái: Thông tin chính --- *@
    <div class="col-md-9">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light">
                <h3 class="card-title text-dark fw-bold">
                    <i class="ti ti-database-search me-2 text-azure"></i>Dữ liệu danh mục
                </h3>
            </div>
            <div class="card-body">
                <div class="datagrid">
                    <div class="datagrid-item">
                        <div class="datagrid-title">Tên hiển thị</div>
                        <div class="datagrid-content fw-bold text-azure">@Model.TenDanhMuc</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Loại dữ liệu</div>
                        <div class="datagrid-content">Danh mục sản phẩm gốc</div>
                    </div>
                </div>

                <div class="mt-4">
                    <div class="datagrid-title mb-2">Mô tả chi tiết</div>
                    <div class="datagrid-content">
                        <div class="p-3 bg-light rounded border text-dark" style="white-space: pre-line; min-height: 120px;">
                            @(!string.IsNullOrEmpty(Model.MoTa) ? Model.MoTa : "Danh mục này hiện chưa có nội dung mô tả chi tiết.")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* --- Cột bên phải: Thao tác nhanh --- *@
    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-header">
                <h3 class="card-title">Hành động</h3>
            </div>
            <div class="card-body py-4 text-center">
                <div class="row g-2">
                    <div class="col-12">
                        <a asp-action="Edit" asp-route-id="@Model.IdDanhMuc" class="btn btn-warning w-100">
                            <i class="ti ti-edit me-1"></i> Sửa thông tin
                        </a>
                    </div>
                    <div class="col-12 mt-2">
                        <button type="button" class="btn btn-outline-danger w-100" data-bs-toggle="modal" data-bs-target="#modal-delete">
                            <i class="ti ti-trash me-1"></i> Xóa danh mục
                            </a>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-azure-lt small text-muted text-center">
                <i class="ti ti-info-circle me-1"></i> Cập nhật dữ liệu thời gian thực
            </div>
        </div>
    </div>
</div>

@* --- Modal xác nhận xóa (Giống trang sản phẩm của Giang) --- *@
<div class="modal modal-blur fade" id="modal-delete" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
        <div class="modal-content shadow-lg">
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            <div class="modal-status bg-danger"></div>
            <div class="modal-body text-center py-4">
                <i class="ti ti-alert-triangle text-danger mb-2" style="font-size: 3rem;"></i>
                <h3 class="fw-bold">Bạn có chắc chắn?</h3>
                <div class="text-muted small">
                    Dữ liệu danh mục <strong>@Model.TenDanhMuc</strong> sẽ bị xóa vĩnh viễn khỏi hệ thống.
                </div>
            </div>
            <div class="modal-footer">
                <div class="w-100">
                    <div class="row">
                        <div class="col">
                            <button type="button" class="btn btn-white w-100" data-bs-dismiss="modal">Hủy</button>
                        </div>
                        <div class="col">
                            <form asp-action="Delete" asp-route-id="@Model.IdDanhMuc" method="post">
                                <button type="submit" class="btn btn-danger w-100">Xóa ngay</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>