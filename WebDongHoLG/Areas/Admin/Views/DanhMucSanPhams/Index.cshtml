@model IEnumerable<WebDongHoLG.Models.DanhMucSanPham>

@{
    ViewData["Title"] = "Quản lý danh mục";
}

<div class="page-header d-print-none mb-3">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title text-primary">
                <i class="ti ti-category me-2"></i>Quản lý danh mục sản phẩm
            </h2>
        </div>
        <div class="col-auto ms-auto">
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="ti ti-plus me-2"></i> Thêm danh mục mới
            </a>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-vcenter table-hover card-table">

            <!-- FIX: bg-light -> bg-body -->
            <thead class="bg-body">
                <tr>
                    <th style="width: 250px;">Tên danh mục</th>
                    <th>Mô tả chi tiết</th>
                    <th class="text-end" style="width: 150px;">Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar avatar-xs bg-azure-lt text-azure">
                                    <i class="ti ti-tag"></i>
                                </div>

                                <!-- FIX: text-dark -> text-body -->
                                <div class="fw-bold text-body">
                                    @item.TenDanhMuc
                                </div>
                            </div>
                        </td>

                        <td>
                            <div class="text-muted small text-truncate"
                                 style="max-width: 500px;"
                                 title="@item.MoTa">
                                @(string.IsNullOrEmpty(item.MoTa)
                                                            ? "Chưa có mô tả cho danh mục này."
                                                            : item.MoTa)
                        </div>
                    </td>

                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Edit" asp-route-id="@item.IdDanhMuc"
                                   class="btn btn-icon btn-outline-warning" title="Chỉnh sửa">
                                    <i class="ti ti-edit"></i>
                                </a>

                                <a asp-action="Details" asp-route-id="@item.IdDanhMuc"
                                   class="btn btn-icon btn-outline-info" title="Xem chi tiết">
                                    <i class="ti ti-eye"></i>
                                </a>

                                <a asp-action="Delete" asp-route-id="@item.IdDanhMuc"
                                   class="btn btn-icon btn-outline-danger" title="Xóa danh mục">
                                    <i class="ti ti-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                                }
            </tbody>
        </table>
    </div>

    <!-- FIX: bg-white -> bg-body -->
    <div class="card-footer d-flex align-items-center bg-body border-top-0">
        <p class="m-0 text-muted">
            Hiển thị <span>@Model.Count()</span> danh mục
        </p>
    </div>
</div>