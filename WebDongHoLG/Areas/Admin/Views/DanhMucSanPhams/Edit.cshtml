@model WebDongHoLG.Models.DanhMucSanPham

@{
    ViewData["Title"] = "Chỉnh sửa danh mục";
}

<div class="page-header d-print-none mb-3">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title text-primary">
                <i class="ti ti-edit me-2"></i>Chỉnh sửa danh mục
            </h2>
            <div class="text-muted mt-1 small">ID Danh mục: <span class="badge bg-azure-lt">#@Model.IdDanhMuc</span></div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card shadow-sm border-0">
            <form asp-action="Edit" method="post">
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3 small"></div>
                    <input type="hidden" asp-for="IdDanhMuc" />

                    <div class="mb-3">
                        <label asp-for="TenDanhMuc" class="form-label fw-bold">Tên danh mục</label>
                        <div class="input-icon">
                            <span class="input-icon-addon"><i class="ti ti-tag"></i></span>
                            <input asp-for="TenDanhMuc" class="form-control border-primary-subtle" placeholder="Ví dụ: Luxury Watch, Sport Watch..." />
                        </div>
                        <span asp-validation-for="TenDanhMuc" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MoTa" class="form-label fw-bold">Mô tả chi tiết</label>
                        <textarea asp-for="MoTa" class="form-control border-primary-subtle" rows="5" placeholder="Mô tả đặc điểm của nhóm đồng hồ này..."></textarea>
                        <span asp-validation-for="MoTa" class="text-danger small"></span>
                        <div class="form-hint small">Mô tả này sẽ giúp khách hàng hiểu rõ hơn về loại sản phẩm trong danh mục.</div>
                    </div>
                </div>

                <div class="card-footer bg-light-subtle">
                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-ghost-secondary">
                            <i class="ti ti-arrow-left me-1"></i> Quay lại danh sách
                        </a>
                        <button type="submit" class="btn btn-primary shadow-sm">
                            <i class="ti ti-device-floppy me-1"></i> Lưu thay đổi
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}