@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Xác nhận gửi yêu cầu";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/user-home.css" asp-append-version="true" />
    <style>
        /* ĐẢO NGƯỢC BỐ CỤC: Form trái, Ảnh phải */
        .auth-container {
            display: flex;
            flex-direction: row-reverse; /* Đảo ngược thứ tự hiển thị của các phần tử con */
        }

        /* Tùy chỉnh icon và nút bấm màu Gold */
        .confirm-icon {
            color: var(--luxury-gold);
            font-size: 4rem;
            margin-bottom: 25px;
        }

        .btn-confirm {
            background-color: var(--luxury-dark) !important;
            color: var(--luxury-gold) !important;
            border: 1px solid var(--luxury-gold) !important;
            font-weight: bold;
            padding: 12px 30px;
            transition: 0.3s;
            text-decoration: none;
            display: inline-block;
            border-radius: 8px;
            text-transform: uppercase;
        }

            .btn-confirm:hover {
                background-color: var(--luxury-gold) !important;
                color: white !important;
                transform: translateY(-2px);
            }

        .auth-card h3 {
            color: var(--luxury-dark);
            font-weight: 800;
        }
    </style>
}

<div class="auth-container">
    <div class="auth-image"></div>

    <div class="auth-form">
        <div class="auth-card text-center">
            <div class="confirm-icon">
                <i class="fas fa-envelope-open-text"></i>
            </div>

            <h3 class="mb-3 text-uppercase">KIỂM TRA EMAIL</h3>

            <p class="text-muted mb-4">
                Chúng tôi đã gửi một liên kết thay đổi mật khẩu đến Email của bạn. <br />
                Vui lòng kiểm tra (cả hòm thư rác) và làm theo hướng dẫn.
            </p>

            <div class="mt-4">
                <a href="/" class="btn-confirm shadow-sm">
                    <i class="fas fa-home me-2"></i>QUAY VỀ TRANG CHỦ
                </a>
            </div>

            <div class="mt-5 pt-3">
                <a asp-page="./Login" class="small text-gold fw-bold text-decoration-none" style="color: var(--luxury-gold)">
                    Quay lại Đăng nhập
                </a>
            </div>
        </div>
    </div>
</div>