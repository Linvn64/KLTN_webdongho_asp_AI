@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Xác nhận đổi mật khẩu";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/user-home.css" asp-append-version="true" />
    <style>
        .success-icon {
            color: var(--luxury-gold);
            font-size: 4rem;
            margin-bottom: 20px;
        }

        .btn-back-login {
            background-color: var(--luxury-dark) !important;
            color: var(--luxury-gold) !important;
            border: 1px solid var(--luxury-gold) !important;
            font-weight: bold;
            padding: 12px 30px;
            transition: 0.3s;
            text-decoration: none;
            display: inline-block;
            border-radius: 8px;
        }

            .btn-back-login:hover {
                background-color: var(--luxury-gold) !important;
                color: white !important;
            }
    </style>
}

<div class="auth-container">
    <div class="auth-image"></div>

    <div class="auth-form">
        <div class="auth-card text-center">
            <div class="success-icon">
                <i class="fas fa-check-circle"></i>
            </div>

            <h3 class="mb-3 text-uppercase" style="color: var(--luxury-dark); font-weight: 800;">THÀNH CÔNG!</h3>

            <p class="text-muted mb-4">
                Mật khẩu của bạn đã được thiết lập lại thành công. <br />
                Giờ đây bạn có thể sử dụng mật khẩu mới để đăng nhập vào hệ thống LG WATCH.
            </p>

            <div class="mt-4">
                <a asp-page="./Login" class="btn-back-login shadow-sm">
                    ĐĂNG NHẬP NGAY
                </a>
            </div>

            <div class="mt-5">
                <a asp-area="Default" asp-controller="Home" asp-action="Index" class="small text-muted text-decoration-none">
                    <i class="fas fa-home me-1"></i> Quay về trang chủ
                </a>
            </div>
        </div>
    </div>
</div>