@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Thiết lập lại mật khẩu";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/user-home.css" asp-append-version="true" />
    <style>
        .toggle-password {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            z-index: 10;
            color: var(--luxury-gold);
        }

        .btn-reset {
            background-color: var(--luxury-gold) !important;
            border-color: var(--luxury-gold) !important;
            color: white !important;
            font-weight: bold;
            padding: 12px;
            transition: 0.3s;
        }

            .btn-reset:hover {
                filter: brightness(0.9);
            }

        .auth-card h3 {
            color: var(--luxury-dark);
            font-weight: 800;
        }

        .form-floating {
            position: relative;
        }
    </style>
}

<div class="auth-container">
    <div class="auth-image"></div>

    <div class="auth-form">
        <div class="auth-card">
            <h3 class="mb-3 text-center text-uppercase">LGWATCH</h3>
            <p class="text-center text-muted small mb-4">Cập nhật mật khẩu mới cho tài khoản</p>

            <form method="post">
                <div asp-validation-summary="All" class="alert alert-danger small"></div>

                <input asp-for="Input.Code" type="hidden" />

                @* DÒNG QUAN TRỌNG NHẤT ĐÂY GIANG ƠI *@
                <input asp-for="Input.Email" type="hidden" />

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" readonly tabindex="-1" placeholder="Email" />
                    <label asp-for="Input.Email">Email tài khoản</label>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" id="passwordInput" class="form-control" type="password" placeholder="Mật khẩu mới" />
                    <label asp-for="Input.Password">Mật khẩu mới</label>
                    <span class="toggle-password" onclick="togglePassword('passwordInput')">👁</span>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-4">
                    <input asp-for="Input.ConfirmPassword" id="confirmPasswordInput" class="form-control" type="password" placeholder="Xác nhận mật khẩu" />
                    <label asp-for="Input.ConfirmPassword">Xác nhận mật khẩu mới</label>
                    <span class="toggle-password" onclick="togglePassword('confirmPasswordInput')">👁</span>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="w-100 btn btn-reset shadow-sm">
                    XÁC NHẬN THAY ĐỔI
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePassword(inputId) {
            const input = document.getElementById(inputId);
            input.type = (input.type === "password") ? "text" : "password";
        }

        $(document).ready(function () {
            // Ép focus vào ô mật khẩu mới sau 100ms
            setTimeout(function() {
                $('#passwordInput').focus();
            }, 100);
        });
    </script>
}