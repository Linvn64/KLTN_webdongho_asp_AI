@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    var user = await UserManager.GetUserAsync(User);
    var logins = user != null ? await UserManager.GetLoginsAsync(user) : new List<UserLoginInfo>();

    var isGoogleLogin = logins.Any(x => x.LoginProvider == "Google");

    var hasPassword = user != null && await UserManager.HasPasswordAsync(user);
}

<ul class="nav nav-pills flex-column">

    <li class="nav-item">
        <a class="nav-link @ManageNavPages.IndexNavClass(ViewContext)" asp-page="./Index">
            Hồ sơ cá nhân
        </a>
    </li>

    @if (!isGoogleLogin)
    {
        <li class="nav-item">
            <a class="nav-link @ManageNavPages.EmailNavClass(ViewContext)" asp-page="./Email">
                Email
            </a>
        </li>
    }

    @if (!isGoogleLogin || hasPassword)
    {
        <li class="nav-item">
            <a class="nav-link @ManageNavPages.ChangePasswordNavClass(ViewContext)" asp-page="./ChangePassword">
                Đổi mật khẩu
            </a>
        </li>
    }

    <li class="nav-item">
        <a class="nav-link @ManageNavPages.ExternalLoginsNavClass(ViewContext)" asp-page="./ExternalLogins">
            Liên kết tài khoản Google
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link @ManageNavPages.PersonalDataNavClass(ViewContext)" asp-page="./PersonalData">
            Dữ liệu cá nhân
        </a>
    </li>

</ul>