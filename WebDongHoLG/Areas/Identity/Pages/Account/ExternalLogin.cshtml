@page
@using WebDongHoLG.Areas.Identity.Pages.Account
@model ExternalLoginModel
@{
    ViewData["Title"] = "Xác nhận tài khoản";
}

<div class="auth-container register-layout">
    <div class="auth-image">
        <div class="overlay">
            <div>
                <h2>Chào mừng bạn!</h2>
                <p>Chỉ một bước nữa để hoàn tất đăng ký với @Model.ProviderDisplayName</p>
            </div>
        </div>
    </div>

    <div class="auth-form">
        <div class="auth-card">
            <h3 class="mb-3">Bước cuối cùng</h3>
            <p class="text-muted small">
                Bạn đã xác thực thành công với <strong>@Model.ProviderDisplayName</strong>.
                Vui lòng xác nhận email để bắt đầu mua sắm.
            </p>

            <form asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="Email" />
                    <label asp-for="Input.Email">Địa chỉ Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-login w-100 mb-3">Hoàn tất đăng ký</button>

                <div class="text-center">
                    <a href="javascript:history.back()" style="color: #8b5cf6; text-decoration: none; font-weight: 500;">
                        <i class="fas fa-arrow-left"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}