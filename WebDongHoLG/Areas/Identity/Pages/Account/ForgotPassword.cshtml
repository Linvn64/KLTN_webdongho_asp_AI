@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/user-home.css" asp-append-version="true" />
    <style>
        .btn-forgot {
            background-color: var(--luxury-gold) !important;
            border-color: var(--luxury-gold) !important;
            color: white !important;
            font-weight: bold;
            padding: 12px;
            transition: 0.3s;
            border-radius: 10px;
        }

            .btn-forgot:hover {
                filter: brightness(0.9);
                transform: translateY(-2px);
            }

        .auth-card h3 {
            color: var(--luxury-dark);
            font-weight: 800;
        }
    </style>
}

<div class="auth-container">
    <div class="auth-image"></div>

    <div class="auth-form">
        <div class="auth-card">
            <h3 class="mb-3 text-center text-uppercase">LGWATCH</h3>
            <p class="text-center text-muted small mb-4">Nhập Email của bạn để nhận liên kết khôi phục mật khẩu</p>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>

                <div class="form-floating mb-4">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email">Địa chỉ Email của bạn</label>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-forgot w-100 shadow-sm">
                    <i class="fas fa-paper-plane me-2"></i>GỬI YÊU CẦU
                </button>

                <div class="auth-links text-center mt-4">
                    <a asp-page="./Login" class="small text-muted text-decoration-none">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại Đăng nhập
                    </a>
                </div>
            </form>

            <hr class="mt-4" />
            <div class="text-center mt-3">
                <a asp-area="Default" asp-controller="Home" asp-action="Index" class="small text-gold fw-bold text-decoration-none" style="color: var(--luxury-gold)">
                    Trở về trang chủ
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}